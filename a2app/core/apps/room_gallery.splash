                    d_icon := Label{
                        text: "📄" padding: 0 margin: 0
                        draw_text +: { color: #x1C274C text_style: theme.font_regular{font_size: 46} }
                    }
                    d_icon_label := Label{
                        text: "" padding: 0 margin: 0
                        draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 9.5} }
                    }
                }
                d_img_wrap := View{
                    width: Fill height: Fit align: Align{x: 0.5} visible: false
                    d_img := Image{
                        width: Fill height: Fit{max: FitBound.Rel{base: Base.Full, factor: 0.5}} fit: ImageFit.Smallest
                        draw_bg +: {
                            pixel: fn(){
                                let color = mix(self.get_color(), #xE3E9F5, self.async_load)
                                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                                sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, 6.0)
                                sdf.fill(vec4(color.xyz, color.w * self.opacity))
                                return sdf.result
                            }
                        }
                    }
                }
            }
            View{
                width: Fill height: Fit flow: Down spacing: 4
                d_name := Label{
                    text: "" width: Fill padding: 0 margin: 0
                    draw_text +: { color: #x1C274C text_style: theme.font_bold{font_size: 13} }
                }
                d_kind := Caption{ text: "" }
                d_info_wrap := Slot{
                    d_info := Body{ text: "" }
                }
                // The date moves to its own line when it doesn't fit, rather than breaking inside a time.
                View{
                    width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 4
                    d_who := Body{ text: "" width: Fit{max: FitBound.Rel{base: Base.Full, factor: 1.0}} max_lines: 6 }
                    d_when := Body{ text: "" width: Fit{max: FitBound.Rel{base: Base.Full, factor: 1.0}} max_lines: 2 }
                }
            }
            d_caption_wrap := Card{
                padding: 12 visible: false
                d_caption := Body{ text: "" }
            }
            ButtonRow{
                PrimaryButton{ text: "Show in chat" on_click: || show_in_chat() }
                NeutralButton{ text: "Share again" on_click: || share_again() }
                d_preview_wrap := Fits{
                    visible: false
                    NeutralButton{ text: "Show preview" on_click: || show_detail_preview() }
                }
            }
            d_note_wrap := View{
                width: Fill height: Fit flow: Down visible: false
                d_note_n := Slot{
                    d_note := Meta{ text: "" }
                }
                d_note_ok_wrap := Slot{
                    visible: false
                    d_note_ok := OkText{ text: "" }
                }
                d_note_err_wrap := Slot{
                    visible: false
                    d_note_err := ErrText{ text: "" }
                }
            }
            Meta{ text: "Share again puts the file in the message box. Nothing is sent until you press Send." }
        }
    }
}
