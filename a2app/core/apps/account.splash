// name: Account
// icon: 🪪
// tint: #386FA4
// description: You, this device, your homeserver, and a user lookup.
// permissions: matrix-profile, matrix-account-read, matrix-users, open-url, robrix-navigation, matrix.profile.read, matrix.account.device.read, matrix.account.info.read, matrix.account.ignored.read, matrix.user.profile.read, matrix.user.dm.find, device.url.open, host.nav.room
// why-matrix-profile: Shows your display name and user id.
// why-matrix-account-read: Shows this device, your homeserver, and who you ignore.
// why-matrix-users: Looks up the profile and DM of a user id you enter.
// why-open-url: Opens your homeserver's account management page.
// why-robrix-navigation: Opens the DM you already have with a user you look up.

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}
let Field = TextInput{
    width: Fill height: Fit padding: 10
    draw_bg +: {
        border_radius: 4.0 border_size: 1.0
        color: theme.palette.surface color_hover: theme.palette.surface color_focus: theme.palette.surface color_down: theme.palette.surface color_empty: theme.palette.surface
        border_color: theme.palette.border border_color_hover: theme.palette.accent border_color_focus: theme.palette.focus border_color_down: theme.palette.focus border_color_empty: theme.palette.border
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.body color_hover: theme.palette.body color_focus: theme.palette.body color_down: theme.palette.body color_empty: theme.palette.placeholder color_empty_hover: theme.palette.placeholder_hover color_empty_focus: theme.palette.placeholder_hover text_style: theme.font_regular{font_size: 11} }
}

let profile_loading = false
let profile_loaded = false
let device_loading = false
let device_loaded = false
let account_loading = false
let account_loaded = false
let ignored_loading = false
let ignored_loaded = false

let lookup_request = 0
let setup_pending = false
let has_me = false
// Set when the current lookup found no such user, so its DM line stays hidden.
let lookup_missing = false
// What the pane shows, which survives the re-run a theme switch does. Each account-read item
// is "loading", "ok", "denied" or "error"; a device row names its value's palette color.
mod.state = {
    ignored: [] ignored_rows: [] device_rows: [{k: "Name" v: "Loading…" tone: "muted"}]
    manage_url: nil dm_room: nil is_narrow: false is_looking_up: false
    device_state: "loading" server_state: "loading" ignored_state: "loading"
}

let upper_map = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M"
    n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}

// "room not joined" -> "Room not joined."
fn sentence(text){
    let t = "" + text
    let chars = t.split("")
    if chars.len() < 3 { return t }
    let first = chars[1]
    let up = upper_map[first]
    if up == nil { up = first }
    let out = up + t.strip_prefix(first)
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

fn or_blank(name, fallback){
    if name == nil || name == "" { return fallback }
    return name
}

fn initial(name){
    let parts = ("" + name).split("")
    let i = 1
    while i < parts.len() - 1 {
        let c = parts[i]
        if c != "#" && c != "@" && c != "!" && c != " " {
            let up = upper_map[c]
            if up.is_nil() { return c }
            return up
        }
        i += 1
    }
    return "?"
}

fn show_account(){
    let device_state = mod.state.device_state
    let server_state = mod.state.server_state
    let ignored_state = mod.state.ignored_state
    let is_all_denied = device_state == "denied" && server_state == "denied" && ignored_state == "denied"
    // One spinner until the first account read answers, instead of a "Loading…" per card.
    let is_booting = device_state == "loading" && server_state == "loading" && ignored_state == "loading"
    ui.loading_wrap.set_visible(is_booting)
    ui.acct_denied_wrap.set_visible(is_all_denied)
    ui.details_wrap.set_visible(!is_all_denied && !is_booting)
    ui.ignored_section.set_visible(!is_all_denied && !is_booting)
    ui.manage_wrap.set_visible(server_state == "ok" && mod.state.manage_url != nil)
    let has_rows = ignored_state == "ok" && mod.state.ignored.len() > 0
    ui.ignored_list_wrap.set_visible(has_rows)
    if has_rows { show_ignored_note("", "") }
    ui.ignored_head.set_text(if has_rows {"IGNORED USERS · " + mod.state.ignored.len()} else {"IGNORED USERS"})
}

fn show_device(rows){
    mod.state.device_rows = rows
    ui.device_kv.render()
}

fn show_me(name, id, note){
    ui.me_name.set_text(name)
    ui.me_id.set_text(id)
    ui.me_note.set_text(note)
    ui.me_id_wrap.set_visible(id != "")
    ui.me_note_wrap.set_visible(note != "")
    ui.me_avatar_wrap.set_visible(has_me && !mod.state.is_narrow)
}

// The homeserver card shows the address, a gray note, or a red error.
fn show_server(kind, text){
    ui.server_line.set_text(if kind == "ok" {text} else {""})
    ui.server_note.set_text(if kind == "note" {text} else {""})
    ui.server_err.set_text(if kind == "err" {text} else {""})
    ui.server_line_wrap.set_visible(kind == "ok")
    ui.server_note_wrap.set_visible(kind == "note")
    ui.server_err_wrap.set_visible(kind == "err")
}

fn show_ignored_note(kind, text){
    ui.ignored_note.set_text(if kind == "note" {text} else {""})
    ui.ignored_err.set_text(if kind == "err" {text} else {""})
    ui.ignored_note_wrap.set_visible(kind == "note")
    ui.ignored_err_wrap.set_visible(kind == "err")
}

fn load_profile(){
    if profile_loading { return nil }
    profile_loading = true
    host.request("matrix.profile", nil, fn(r){
        profile_loading = false
        profile_loaded = r.is_ok
        if !r.is_ok {
            has_me = false
            show_me("Signed in", "", sentence(r.error))
            return nil
        }
        let name = or_blank(r.data.display_name, r.data.user_id)
        has_me = true
        ui.me_initial.set_text(initial(name))
        show_me(name, r.data.user_id, "")
        return nil
    })
}

fn load_device(){
    if device_loading { return nil }
    device_loading = true
    host.request("matrix.device", nil, fn(r){
        device_loading = false
        device_loaded = r.is_ok
        if !r.is_ok {
            mod.state.device_state = if host.has("matrix.account.device.read") {"error"} else {"denied"}
            show_device([{k: "Device" v: sentence(r.error) tone: "danger"}])
            show_account()
            return nil
        }
        mod.state.device_state = "ok"
        let status = {k: "Status" v: "Not verified" tone: "danger"}
        if r.data.verified { status = {k: "Status" v: "Verified" tone: "success"} }
        show_device([{k: "Name" v: or_blank(r.data["name"], "Unnamed device") tone: "body"},
            {k: "Device ID" v: r.data.device_id tone: "body"}, status])
        show_account()
        return nil
    })
}

fn load_account(){
    if account_loading { return nil }
    account_loading = true
    host.request("matrix.account_info", nil, fn(r){
        account_loading = false
        account_loaded = r.is_ok
        if !r.is_ok {
            mod.state.server_state = if host.has("matrix.account.info.read") {"error"} else {"denied"}
            show_server(if mod.state.server_state == "error" {"err"} else {"note"}, sentence(r.error))
            mod.state.manage_url = nil
            show_account()
            return nil
        }
        mod.state.server_state = "ok"
        show_server("ok", r.data.homeserver)
        mod.state.manage_url = r.data.account_management_url
        show_account()
        return nil
    })
}

fn build_ignored_rows(){
    mod.state.ignored_rows = []
    for id in mod.state.ignored {
        mod.state.ignored_rows.push({id: id initial: initial(id)})
    }
}

fn load_ignored(){
    if ignored_loading { return nil }
    ignored_loading = true
    host.request("matrix.ignored_users", nil, fn(r){
        ignored_loading = false
        ignored_loaded = r.is_ok
        if r.is_ok {
            mod.state.ignored = r.data.users
            mod.state.ignored_state = "ok"
            show_ignored_note("note", "You haven't ignored anyone.")
        } else {
            mod.state.ignored = []
            mod.state.ignored_state = if host.has("matrix.account.ignored.read") {"error"} else {"denied"}
            show_ignored_note(if mod.state.ignored_state == "error" {"err"} else {"note"}, sentence(r.error))
        }
        build_ignored_rows()
        ui.ignored_list.render()
        show_account()
        return nil
    })
}

fn load(){
    load_profile()
    load_device()
    load_account()
    load_ignored()
}

fn open_manage(){
    if mod.state.manage_url == nil { return nil }
    ui.manage_note_wrap.set_visible(false)
    host.request("url.open", {url: mod.state.manage_url}, fn(r){
        if !r.is_ok {
            ui.manage_note.set_text("Couldn't open the page: " + sentence(r.error))
            ui.manage_note_wrap.set_visible(true)
        }
        return nil
    })
}

fn lookup_say(kind, text){
    ui.lookup_wait.set_text(if kind == "wait" {text} else {""})
    ui.lookup_err.set_text(if kind == "err" {text} else {""})
    ui.lookup_wait_wrap.set_visible(kind == "wait")
    ui.lookup_err_wrap.set_visible(kind == "err")
}

fn is_not_found(error){ return error.search("M_NOT_FOUND") >= 0 || error.search("404") >= 0 }

fn friendly(error){
    if is_not_found(error) { return "No one with that user id was found." }
    return sentence(error)
}

fn lookup(t){
    let id = ("" + t).trim()
    ui.lookup_hint_wrap.set_visible(false)
    if id == "" || id.strip_prefix("@") == id || id.search(":") < 0 {
        lookup_say("err", "Enter a full user id, like @alice:example.org")
        return nil
    }
    lookup_say("wait", "Looking up " + id + "…")
    mod.state.is_looking_up = true
    ui.result_wrap.set_visible(false)
    ui.profile_wrap.set_visible(false)
    ui.dm_row.set_visible(false)
    ui.dm_wrap.set_visible(false)
    mod.state.dm_room = nil
    lookup_missing = false
    lookup_request += 1
    let request_id = lookup_request
    host.request("matrix.user_profile", {user_id: id}, fn(r){
        if request_id != lookup_request { return nil }
        mod.state.is_looking_up = false
        if !r.is_ok {
            lookup_say("err", friendly(r.error))
            // No such user: a "no DM yet" line would only add noise.
            if is_not_found(r.error) {
                lookup_missing = true
                ui.result_wrap.set_visible(false)
            }
            return nil
        }
        lookup_say("", "")
        let name = or_blank(r.data.display_name, r.data.user_id)
        ui.result_initial.set_text(initial(name))
        ui.result_name.set_text(name)
        ui.result_id.set_text(if name == r.data.user_id {"No display name"} else {r.data.user_id})
        let tags = if r.data.has_avatar {"Profile photo set"} else {"No profile photo"}
        ui.result_tags.set_text(tags)
        ui.result_ignored_wrap.set_visible(r.data.ignored)
        ui.profile_wrap.set_visible(true)
        ui.result_wrap.set_visible(true)
        return nil
    })
    host.request("matrix.dm_find", {user_id: id}, fn(r){
        if request_id != lookup_request || lookup_missing { return nil }
        ui.result_wrap.set_visible(true)
        ui.dm_row.set_visible(true)
        if !r.is_ok {
            ui.dm_line.set_text("")
            ui.dm_err.set_text("Couldn't check for a DM: " + sentence(r.error))
            ui.dm_err_wrap.set_visible(true)
            return nil
        }
        ui.dm_err_wrap.set_visible(false)
        if r.data.room_id == nil {
            ui.dm_line.set_text("No direct message with them yet.")
            return nil
        }
        ui.dm_line.set_text("Direct message: " + or_blank(r.data.name, id))
        mod.state.dm_room = r.data.room_id
        ui.dm_wrap.set_visible(true)
        return nil
    })
}

fn open_dm(){
    if mod.state.dm_room == nil { return nil }
    ui.dm_err_wrap.set_visible(false)
    host.request("nav.room", {room_id: mod.state.dm_room}, fn(r){
        if !r.is_ok {
            ui.dm_err.set_text("Couldn't open the DM: " + sentence(r.error))
            ui.dm_err_wrap.set_visible(true)
        }
        return nil
    })
}

// Filling the field from its own on_return fails, so only a tapped row fills it.
fn lookup_ignored(i){
    if i >= mod.state.ignored.len() { return nil }
    ui.user_input.set_text(mod.state.ignored[i])
    lookup(mod.state.ignored[i])
}

fn on_app_resize(w, h){
    let narrow = w < 300
    if narrow == mod.state.is_narrow { return nil }
    mod.state.is_narrow = narrow
    ui.refresh_btn.set_text(if narrow {"↻"} else {"Refresh"})
    // Narrow panes give the field the whole row and put Look up below it.
    ui.lookup_btn_wrap.set_visible(!narrow)
    ui.tiny_lookup.set_visible(narrow)
    ui.me_avatar_wrap.set_visible(has_me && !narrow)
    ui.ignored_list.render()
    ui.device_kv.render()
    return nil
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.profile.read") { profile_loaded = false }
    elif !profile_loaded { load_profile() }
    if !host.has("matrix.account.device.read") { device_loaded = false }
    elif !device_loaded { load_device() }
    if !host.has("matrix.account.info.read") { account_loaded = false }
    elif !account_loaded { load_account() }
    if !host.has("matrix.account.ignored.read") { ignored_loaded = false }
    elif !ignored_loaded { load_ignored() }
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-profile", "matrix-account-read"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok {
            ui.setup_err.set_text(sentence(r.error))
            ui.setup_err_wrap.set_visible(true)
            ui.loading_wrap.set_visible(false)
            return nil
        }
        ui.setup_err_wrap.set_visible(false)
        let is_account = r.data.permissions["matrix-account-read"] == true
        if r.data.permissions["matrix-profile"] == true && host.has("matrix.profile.read") { load_profile() }
        else { has_me = false show_me("Signed in", "", "Your name isn't shared with this app.") }
        if is_account && host.has("matrix.account.device.read") { load_device() }
        else { mod.state.device_state = "denied" show_device([{k: "Device" v: "Not shared" tone: "muted"}]) }
        if is_account && host.has("matrix.account.info.read") { load_account() }
        else { mod.state.server_state = "denied" mod.state.manage_url = nil show_server("note", "Not shared") }
        if is_account && host.has("matrix.account.ignored.read") { load_ignored() }
        else { mod.state.ignored_state = "denied" mod.state.ignored = [] show_ignored_note("note", "Not shared") build_ignored_rows() ui.ignored_list.render() }
        show_account()
        return nil
    })
}

let _boot = start_timeout(0.05, || {
    // A theme switch drops the reply a lookup was waiting for, so let it be retried.
    if mod.state.is_looking_up {
        mod.state.is_looking_up = false
        lookup_say("", "")
        ui.lookup_hint_wrap.set_visible(true)
    }
    ui.device_kv.render()
    setup(false)
})

View{
    width: Fill height: Fill flow: Down
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 14
        View{
            width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
            me_avatar_wrap := View{
                width: Fit height: Fit visible: false
                RoundedView{
                    width: 40 height: 40 align: Align{x: 0.5 y: 0.5}
                    show_bg: true draw_bg +: { color: theme.palette.avatar border_radius: 20.0 }
                    me_initial := Label{ text: "" padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 15} } }
                }
            }
            View{
                width: Fill height: Fit flow: Down spacing: 3
                me_name := Label{ text: "Your account" width: Fill max_lines: 2 text_overflow: Ellipsis padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 13} } }
                me_id_wrap := View{
                    width: Fill height: Fit visible: false
                    me_id := Label{ text: "" width: Fill max_lines: 1 text_overflow: Ellipsis padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                }
                me_note_wrap := View{
                    width: Fill height: Fit visible: false
                    me_note := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                }
            }
            refresh_btn := NeutralButton{ text: "Refresh" on_click: || setup(true) }
        }
        setup_err_wrap := View{
            width: Fill height: Fit visible: false
            setup_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
        }
        loading_wrap := View{
            width: Fill height: Fit flow: Right spacing: 10 align: Align{x: 0.5 y: 0.5} padding: Inset{top: 24 bottom: 24}
            LoadingSpinner{ width: 18 height: 18 draw_bg +: { color: theme.palette.accent_text } }
            Label{ text: "Loading your account…" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
        }
        acct_denied_wrap := View{
            width: Fill height: Fit visible: false
            RoundedView{
                width: Fill height: Fit flow: Down spacing: 6 align: Align{x: 0.5}
                padding: Inset{top: 20 bottom: 20 left: 16 right: 16}
                show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
                Label{ text: "🔒" padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 28} } }
                Label{ text: "Can't see your account" width: Fill align: Align{x: 0.5} padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 12.5} } }
                Label{ text: "Allow Account to see this device, your homeserver and who you ignore." width: Fill align: Align{x: 0.5} padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
                View{
                    width: Fit height: Fit margin: Inset{top: 6}
                    PrimaryButton{ text: "Ask again" on_click: || setup(true) }
                }
            }
        }
        details_wrap := View{
            width: Fill height: Fit flow: Down spacing: 12 visible: false
            View{
                width: Fill height: Fit flow: Down spacing: 8
                Label{ text: "THIS DEVICE" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_bold{font_size: 9.5} } }
                RoundedView{
                    width: Fill height: Fit flow: Down spacing: 8 padding: 12
                    show_bg: true draw_bg +: { color: theme.palette.card border_radius: 8.0 }
                    device_kv := View{
                        width: Fill height: Fit flow: Down spacing: 8
                        on_render: || {
                            for kv in mod.state.device_rows {
                                if mod.state.is_narrow {
                                    View{
                                        width: Fill height: Fit flow: Down spacing: 2
                                        Label{ text: kv.k padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                                        Label{ text: kv.v width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette[kv.tone] text_style: theme.font_regular{font_size: 11} } }
                                    }
                                }
                                if !mod.state.is_narrow {
                                    View{
                                        width: Fill height: Fit flow: Right spacing: 8
                                        Label{ text: kv.k width: 84 padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
                                        Label{ text: kv.v width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette[kv.tone] text_style: theme.font_regular{font_size: 11} } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            View{
                width: Fill height: Fit flow: Down spacing: 8
                Label{ text: "HOMESERVER" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_bold{font_size: 9.5} } }
                RoundedView{
                    width: Fill height: Fit flow: Down spacing: 10 padding: 12
                    show_bg: true draw_bg +: { color: theme.palette.card border_radius: 8.0 }
                    server_line_wrap := View{
                        width: Fill height: Fit visible: false
                        server_line := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.body text_style: theme.font_regular{font_size: 11} } }
                    }
                    server_note_wrap := View{
                        width: Fill height: Fit
                        server_note := Label{ text: "Loading…" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
                    }
                    server_err_wrap := View{
                        width: Fill height: Fit visible: false
                        server_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10.5} } }
                    }
                    manage_wrap := View{
                        width: Fit height: Fit visible: false
                        NeutralButton{ text: "Manage account" on_click: || open_manage() }
                    }
                    manage_note_wrap := View{
                        width: Fill height: Fit visible: false
                        manage_note := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
                    }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Down spacing: 8
            Label{ text: "LOOK UP SOMEONE" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_bold{font_size: 9.5} } }
            View{
                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                user_input := Field{ empty_text: "@user:server" on_return: |t| lookup(t) }
                lookup_btn_wrap := View{
                    width: Fit height: Fit
                    // Matches the field's height.
                    lookup_btn := PrimaryButton{ text: "Look up" height: 36 on_click: || lookup(ui.user_input.text()) }
                }
            }
            tiny_lookup := View{
                width: Fill height: Fit visible: false
                PrimaryButton{ text: "Look up" on_click: || lookup(ui.user_input.text()) }
            }
            lookup_hint_wrap := View{
                width: Fill height: Fit
                Label{ text: "See their profile and whether you already have a DM with them." width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
            lookup_wait_wrap := View{
                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} visible: false
                LoadingSpinner{ width: 16 height: 16 draw_bg +: { color: theme.palette.accent_text } }
                lookup_wait := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
            lookup_err_wrap := View{
                width: Fill height: Fit visible: false
                lookup_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
            }
            result_wrap := View{
                width: Fill height: Fit visible: false
                RoundedView{
                    width: Fill height: Fit flow: Down spacing: 10 padding: 12
                    show_bg: true draw_bg +: { color: theme.palette.card border_radius: 8.0 }
                    profile_wrap := View{
                        width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5} visible: false
                        RoundedView{
                            width: 36 height: 36 align: Align{x: 0.5 y: 0.5}
                            show_bg: true draw_bg +: { color: theme.palette.avatar border_radius: 18.0 }
                            result_initial := Label{ text: "" padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 14} } }
                        }
                        View{
                            width: Fill height: Fit flow: Down spacing: 2
                            result_name := Label{ text: "" width: Fill max_lines: 1 text_overflow: Ellipsis padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 13} } }
                            result_id := Label{ text: "" width: Fill max_lines: 1 text_overflow: Ellipsis padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                            View{
                                width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6 align: Align{y: 0.5}
                                result_tags := Label{ text: "" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                                result_ignored_wrap := View{
                                    width: Fit height: Fit visible: false
                                    RoundedView{
                                        width: Fit height: Fit padding: Inset{top: 2 bottom: 2 left: 7 right: 7}
                                        show_bg: true draw_bg +: { color: theme.palette.danger_bg border_size: 1.0 border_color: theme.palette.danger border_radius: 9.0 }
                                        Label{ text: "Ignored by you" padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 9.5} } }
                                    }
                                }
                            }
                        }
                    }
                    dm_row := View{
                        width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} visible: false
                        dm_line := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.body text_style: theme.font_regular{font_size: 11} } }
                        dm_wrap := View{
                            width: Fit height: Fit visible: false
                            NeutralButton{ text: "Open DM" on_click: || open_dm() }
                        }
                    }
                    dm_err_wrap := View{
                        width: Fill height: Fit visible: false
                        dm_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
                    }
                }
            }
        }
        ignored_section := View{
            width: Fill height: Fill{min: 80} flow: Down spacing: 8 visible: false
            ignored_head := Label{ text: "IGNORED USERS" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_bold{font_size: 9.5} } }
            ignored_note_wrap := View{
                width: Fill height: Fit
                ignored_note := Label{ text: "Loading…" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
            ignored_err_wrap := View{
                width: Fill height: Fit visible: false
                ignored_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
            }
            ignored_list_wrap := View{
                width: Fill height: Fill visible: false
                ignored_list := ScrollYView{
                    width: Fill height: Fill flow: Down spacing: 8
                    on_item_tap: |i| lookup_ignored(i)
                    on_render: || {
                        if mod.state.ignored_rows.len() == 0 { ignored_spacer := View{ width: Fill height: 1 } }
                        for r in mod.state.ignored_rows {
                            RoundedView{
                                width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                                padding: Inset{top: 8 bottom: 8 left: 10 right: 12}
                                show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
                                // Gray, not teal: these are people you've muted.
                                if !mod.state.is_narrow {
                                    RoundedView{
                                        width: 32 height: 32 align: Align{x: 0.5 y: 0.5}
                                        show_bg: true draw_bg +: { color: if theme.palette.is_dark {#x6E6E6E} else {#xAAAAAA} border_radius: 16.0 }
                                        Label{ text: r.initial padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 12} } }
                                    }
                                }
                                Label{ text: r.id width: Fill max_lines: 1 text_overflow: Ellipsis padding: 0 margin: 0 draw_text +: { color: theme.palette.body text_style: theme.font_regular{font_size: 11} } }
                            }
                        }
                    }
                }
            }
        }
    }
}
