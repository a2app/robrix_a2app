                    }
                    stop_wrap := View{
                        width: Fit height: Fit visible: false
                        NeutralButton{ text: "Stop" on_click: || stop_scan() }
                    }
                }
                scan_note_wrap := Slot{
                    visible: false
                    scan_note_label := Meta{ text: "" }
                }
                scan_err_wrap := Slot{
                    visible: false
                    scan_err := ErrText{ text: "" }
                }
            }
        }
    }
}
