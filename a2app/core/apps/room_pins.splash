// name: Pinned Events
// icon: 📌
// tint: #C0533E
// description: The messages pinned in this room.
// permissions: matrix-room-read, robrix-navigation, matrix-room-info
// why-matrix-room-read: Shows this room's pinned messages.
// why-robrix-navigation: Jumps to a pinned message you tap.
// why-matrix-room-info: Refreshes when the pins change.

let items = []
let status = "Loading…"
let live_note = ""

fn show_header(){ ui.header.set_text(status + live_note) }

fn load(){
    host.request("matrix.pinned_events", nil, fn(r){
        if r.is_ok {
            items = r.data.pinned
            status = "" + items.len() + " pinned · tap one to jump to it"
        } else {
            items = []
            status = r.error
        }
        show_header()
        ui.item_list.render()
    })
}

fn on_room_pins_changed(json){
    load()
}

fn watch(){
    host.request("events.subscribe", {event: "on_room_pins_changed"}, fn(r){
        if r.is_ok { live_note = "" } else { live_note = " · live updates off: " + r.error }
        show_header()
    })
}

fn on_permissions_changed(caps){
    load()
    watch()
}

fn jump_to_pin(i){
    if i >= items.len() { return nil }
    host.request("nav.event", {event_id: items[i].event_id}, fn(r){
        if !r.is_ok { ui.header.set_text(r.error) }
    })
}

let _boot = start_timeout(0.05, || {
    load()
    watch()
})

View{
    width: Fill height: Fit flow: Down align: Align{x: 0.5}
    col := View{
        width: Fill{max: 460.0} height: Fit flow: Down spacing: 10 padding: 14
        Label{
            text: "Pinned Events" padding: 0 margin: 0
            draw_text +: { color: #x1C274C text_style: theme.font_bold{font_size: 20} }
        }
        header := Label{
            text: "Loading…" padding: 0 margin: 0
            width: Fill
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 13} }
        }
        item_list := ScrollYView{
            width: Fill height: 330 flow: Down spacing: 5
            on_item_tap: |i| jump_to_pin(i)
            on_render: || {
                if items.len() == 0 {
                    Label{
                        text: "Nothing to show. This app needs to be opened from a room, and needs your permission to read it."
                        width: Fill padding: 0 margin: 0
                        draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                    }
                } else {
                    for it in items {
                        RoundedView{
                            width: Fill height: Fit flow: Down spacing: 2 padding: 10
                            show_bg: true
                            draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                            Label{
                                text: it.sender padding: 0 margin: 0
                                width: Fill
                                draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                            }
                            Label{
                                text: it.body width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                            }
                        }
                    }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Right align: Align{x: 0.5}
            Button{
                text: "Refresh" on_click: || { status = "Loading…" show_header() load() }
                draw_text +: { color: #x1C274C }
            }
        }
    }
}
