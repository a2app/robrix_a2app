// name: Pinned Messages
// icon: 📌
// tint: #C0533E
// description: The messages pinned in this room.
// permissions: matrix-room-read, robrix-navigation, matrix-room-info, matrix.room.pins.read, host.nav.event, on_room_pins_changed
// why-matrix-room-read: Shows this room's pinned messages.
// why-robrix-navigation: Jumps to a pinned message you tap.
// why-matrix-room-info: Refreshes when the pins change.

let watch_pending = false
let watch_ready = false

let pins_loading = false
let pins_loaded = false
let live_refresh_pending = false
let setup_pending = false

let nav_error = ""
// What the pane shows survives the re-run a theme switch does, which no resize follows.
// `screen` is loading | list | empty | denied | error | no_room.
mod.state = {items: [] screen: "loading" error_text: "" live_note: "" is_narrow: false is_tiny: false}

let upper = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M" n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}
let error_prefix = regex("^[Cc]ouldn't [^:]*: ")

// The avatar letter: the name's first character, skipping a leading "@".
fn initial(name){
    let chars = name.split("")
    if chars.len() < 3 { return "?" }
    let c = chars[1]
    if c == "@" && chars.len() > 3 { c = chars[2] }
    let up = upper[c]
    if up != nil { c = up }
    return c
}

// "room not found" -> "Room not found."
fn sentence(text){
    let t = text.replace(error_prefix, "")
    let chars = t.split("")
    if chars.len() < 3 { return t }
    let first = chars[1]
    let up = upper[first]
    if up == nil { up = first }
    let out = up + t.strip_prefix(first)
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

// Newer hosts send sender_name and ts; older ones only the short sender.
fn who(m){
    let name = m["sender_name"]
    if name == nil || name == "" { name = m["sender"] }
    if name == nil { name = "Someone" }
    return name
}

fn ago(ts){
    if ts == nil { return "" }
    let s = time_now() - ts / 1000.0
    if s < 60.0 { return "Just now" }
    if s < 3600.0 { return "" + floor(s / 60.0) + "m ago" }
    if s < 86400.0 { return "" + floor(s / 3600.0) + "h ago" }
    if s < 172800.0 { return "Yesterday" }
    if s < 604800.0 { return "" + floor(s / 86400.0) + "d ago" }
    if s < 2592000.0 { return "" + floor(s / 604800.0) + "w ago" }
    if s < 31536000.0 { return "" + floor(s / 2592000.0) + "mo ago" }
    return "" + floor(s / 31536000.0) + "y ago"
}

fn show(){
    let screen = mod.state.screen
    let items = mod.state.items
    let is_narrow = mod.state.is_narrow
    ui.loading_wrap.set_visible(screen == "loading")
    ui.header_row.set_visible(screen == "list")
    ui.refresh_wide.set_visible(!is_narrow)
    ui.refresh_narrow.set_visible(is_narrow && screen == "list")
    ui.empty_card.set_visible(screen != "loading" && screen != "list")
    ui.ask_wrap.set_visible(screen == "denied")
    ui.retry_wrap.set_visible(screen == "error" || screen == "empty")
    let summary = "" + items.len() + " pinned messages"
    if items.len() == 1 { summary = "1 pinned message" }
    ui.summary.set_text(summary)
    let hint = "Tap a message to jump to it"
    if is_narrow { hint = "Tap one to jump to it" }
    ui.meta.set_text(hint)
    ui.live_wrap.set_visible(mod.state.live_note != "")
    ui.live.set_text(mod.state.live_note)
    ui.nav_wrap.set_visible(nav_error != "")
    ui.nav_err.set_text(nav_error)
    if screen == "empty" {
        ui.empty_icon.set_text("📌")
        ui.empty_title.set_text("No pinned messages")
        ui.empty_body.set_text("Pin a message in Robrix and it shows up here.")
        ui.retry.set_text("Refresh")
    }
    if screen == "denied" {
        ui.empty_icon.set_text("🔒")
        ui.empty_title.set_text("Can't see pins")
        ui.empty_body.set_text("Allow Pinned Messages to read this room's pins.")
    }
    if screen == "error" {
        ui.empty_icon.set_text("😕")
        ui.empty_title.set_text("Couldn't load pinned messages")
        ui.empty_body.set_text(sentence(mod.state.error_text))
        ui.retry.set_text("Try again")
    }
    if screen == "no_room" {
        ui.empty_icon.set_text("🧭")
        ui.empty_title.set_text("No room attached")
        ui.empty_body.set_text("Open Pinned Messages from a room to see its pins.")
    }
    ui.item_list.render()
}

fn fail(error){
    mod.state.items = []
    mod.state.error_text = error
    mod.state.screen = "error"
    if error.search("not attached to a room") >= 0 { mod.state.screen = "no_room" }
    if error.search("ermission") >= 0 || error.search("not approved") >= 0 { mod.state.screen = "denied" }
    show()
}

fn load(){
    if pins_loading { return nil }
    pins_loading = true
    host.request("matrix.pinned_events", nil, fn(r){
        pins_loading = false
        pins_loaded = r.is_ok
        if !r.is_ok { fail(r.error) return nil }
        mod.state.items = r.data.pinned
        nav_error = ""
        mod.state.screen = "list"
        if mod.state.items.len() == 0 { mod.state.screen = "empty" }
        show()
        return nil
    })
}

fn on_room_pins_changed(json){
    schedule_live_refresh()
}

fn schedule_live_refresh(){
    if live_refresh_pending || !host.has("matrix.room.pins.read") { return nil }
    live_refresh_pending = start_timeout(1.0, || {
        live_refresh_pending = false
        if !host.has("matrix.room.pins.read") { return nil }
        if pins_loading { schedule_live_refresh() } else { load() }
    }) != nil
}

fn watch(){
    if watch_pending || watch_ready { return nil }
    watch_pending = true
    host.request("events.subscribe", {event: "on_room_pins_changed"}, fn(r){
        watch_pending = false
        watch_ready = r.is_ok
        if r.is_ok { mod.state.live_note = "" } else { mod.state.live_note = "Live updates are off. Tap Refresh to update." }
        show()
        return nil
    })
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.pins.read") { pins_loaded = false }
    elif !pins_loaded { load() }
    if host.has("on_room_pins_changed") { watch() } else { watch_ready = false }
}

fn jump_to_pin(i){
    if i >= mod.state.items.len() { return nil }
    host.request("nav.event", {event_id: mod.state.items[i].event_id}, fn(r){
        if r.is_ok { nav_error = "" } else { nav_error = "Couldn't jump to that message. " + sentence(r.error) }
        show()
        return nil
    })
}

fn on_app_resize(w, h){
    let narrow = w < 300
    let tiny = w < 260
    if narrow == mod.state.is_narrow && tiny == mod.state.is_tiny { return nil }
    mod.state.is_narrow = narrow
    mod.state.is_tiny = tiny
    show()
    return nil
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-read", "matrix-room-info"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { fail(r.error) return nil }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.pins.read") { load() }
        else {
            mod.state.items = []
            mod.state.screen = "denied"
            show()
        }
        if r.data.permissions["matrix-room-info"] == true && host.has("on_room_pins_changed") { watch() }
        return nil
    })
}

let _boot = start_timeout(0.05, || setup(false))

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}

View{
    width: Fill height: Fill flow: Down
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 14
        header_row := View{
            width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} visible: false
            View{
                width: Fill height: Fit flow: Down spacing: 3
                summary := Label{
                    text: "" width: Fill padding: 0 margin: 0
                    draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 13} }
                }
                meta := Label{
                    text: "" width: Fill padding: 0 margin: 0
                    draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                }
                live_wrap := View{
                    width: Fill height: Fit visible: false
                    live := Label{
                        text: "" width: Fill padding: 0 margin: 0
                        draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                    }
                }
                nav_wrap := View{
                    width: Fill height: Fit visible: false
                    nav_err := Label{
                        text: "" width: Fill padding: 0 margin: 0
                        draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} }
                    }
                }
            }
            refresh_wide := View{
                width: Fit height: Fit
                NeutralButton{ text: "Refresh" on_click: || setup(true) }
            }
        }
        refresh_narrow := View{
            width: Fill height: Fit visible: false
            NeutralButton{ text: "Refresh" on_click: || setup(true) }
        }
        loading_wrap := View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 10 wrap_spacing: 8 align: Align{x: 0.5 y: 0.5} padding: Inset{top: 24 bottom: 24}
            LoadingSpinner{ width: 18 height: 18 draw_bg +: { color: theme.palette.accent_text } }
            Label{
                text: "Loading pins…" padding: 0 margin: 0
                draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} }
            }
        }
        empty_card := RoundedView{
            width: Fill height: Fit flow: Down spacing: 6 align: Align{x: 0.5} padding: Inset{top: 20 bottom: 20 left: 16 right: 16} visible: false
            show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
            empty_icon := Label{ text: "📌" padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 28} } }
            empty_title := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 12.5} }
            }
            empty_body := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} }
            }
            ask_wrap := View{
                width: Fit height: Fit margin: Inset{top: 6} visible: false
                PrimaryButton{ text: "Ask again" on_click: || setup(true) }
            }
            retry_wrap := View{
                width: Fit height: Fit margin: Inset{top: 6} visible: false
                retry := NeutralButton{ text: "Try again" on_click: || setup(true) }
            }
        }
        item_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down
            on_item_tap: |i| jump_to_pin(i)
            on_render: || {
                // A render with no children keeps the old ones, so an empty list draws a spacer.
                if mod.state.items.len() == 0 { pins_spacer := View{ width: Fill height: 1 } }
                for it in mod.state.items {
                    let name = who(it)
                    View{
                        width: Fill height: Fit flow: Right spacing: 10 padding: Inset{top: 10 bottom: 10}
                        RoundedView{
                            visible: !mod.state.is_tiny width: 32 height: 32 align: Align{x: 0.5 y: 0.5}
                            show_bg: true draw_bg +: { color: theme.palette.avatar border_radius: 16.0 }
                            Label{ text: initial(name) padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 12} } }
                        }
                        View{
                            width: Fill height: Fit flow: Down spacing: 3
                            View{
                                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                Label{
                                    text: name width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis padding: 0 margin: 0
                                    draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 11} }
                                }
                                Label{
                                    text: ago(it["ts"]) padding: 0 margin: 0
                                    draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                                }
                            }
                            Label{
                                text: it.body width: Fill max_lines: 3 text_overflow: TextOverflow.Ellipsis padding: 0 margin: 0
                                draw_text +: { color: theme.palette.body text_style: theme.font_regular{font_size: 11} }
                            }
                        }
                    }
                }
            }
        }
    }
}
