// name: Pinned Messages
// icon: 📌
// tint: #C0533E
// description: The messages pinned in this room.
// permissions: matrix-room-read, robrix-navigation, matrix-room-info, matrix.room.pins.read, host.nav.event, on_room_pins_changed
// why-matrix-room-read: Shows this room's pinned messages.
// why-robrix-navigation: Jumps to a pinned message you tap.
// why-matrix-room-info: Refreshes when the pins change.

let watch_pending = false
let watch_ready = false

let pins_loading = false
let pins_loaded = false
let live_refresh_pending = false
let setup_pending = false

let items = []
let status = "Loading…"
let live_note = ""
let empty_msg = "Loading pinned messages…"

fn show_header(){ ui.header.set_text(status + live_note) }

fn load(){
    if pins_loading { return nil }
    pins_loading = true
    host.request("matrix.pinned_events", nil, fn(r){
        pins_loading = false
        pins_loaded = r.is_ok
        if r.is_ok {
            items = r.data.pinned
            empty_msg = "No pinned messages in this room yet."
            status = "" + items.len() + " pinned · tap one to jump to it"
            if items.len() == 0 { status = "No pinned messages" }
        } else {
            items = []
            empty_msg = r.error
            status = r.error
        }
        show_header()
        ui.item_list.render()
    })
}

fn on_room_pins_changed(json){
    schedule_live_refresh()
}

fn schedule_live_refresh(){
    if live_refresh_pending || !host.has("matrix.room.pins.read") { return nil }
    live_refresh_pending = start_timeout(1.0, || {
        live_refresh_pending = false
        if !host.has("matrix.room.pins.read") { return nil }
        if pins_loading { schedule_live_refresh() } else { load() }
    }) != nil
}

fn watch(){
    if watch_pending || watch_ready { return nil }
    watch_pending = true
    host.request("events.subscribe", {event: "on_room_pins_changed"}, fn(r){
        watch_pending = false
        watch_ready = r.is_ok
        if r.is_ok { live_note = "" } else { live_note = " · live updates off: " + r.error }
        show_header()
    })
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.pins.read") { pins_loaded = false }
    elif !pins_loaded { load() }
    if host.has("on_room_pins_changed") { watch() } else { watch_ready = false }
}

fn jump_to_pin(i){
    if i >= items.len() { return nil }
    host.request("nav.event", {event_id: items[i].event_id}, fn(r){
        if !r.is_ok { ui.header.set_text(r.error) }
    })
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-read", "matrix-room-info"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { status = r.error empty_msg = r.error show_header() ui.item_list.render() return nil }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.pins.read") { load() }
        else {
            items = []
            status = "Permission denied. Click Refresh to ask again."
            empty_msg = status
            show_header()
            ui.item_list.render()
        }
        if r.data.permissions["matrix-room-info"] == true && host.has("on_room_pins_changed") { watch() }
    })
}

let _boot = start_timeout(0.05, || setup(false))

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        header := Label{
            text: "Loading…" padding: 0 margin: 0
            width: Fill
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
        item_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down spacing: 5
            on_item_tap: |i| jump_to_pin(i)
            on_render: || {
                if items.len() == 0 {
                    Label{
                        text: empty_msg
                        width: Fill padding: 0 margin: 0
                        draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                    }
                } else {
                    for it in items {
                        RoundedView{
                            width: Fill height: Fit flow: Down spacing: 2 padding: 10
                            show_bg: true
                            draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                            Label{
                                text: it.sender padding: 0 margin: 0
                                width: Fill
                                draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                            }
                            Label{
                                text: it.body width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                            }
                        }
                    }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Right align: Align{x: 0.5}
            Button{
                text: "Refresh" on_click: || setup(true)
                draw_text +: { color: #x1C274C }
            }
        }
    }
}
