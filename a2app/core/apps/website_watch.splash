// name: Website Watch
// icon: 🌐
// tint: #2A7F92
// description: Check a website for a keyword on a saved schedule, then notify you or post to this room.
// background: true
// permissions: network, notifications, matrix-room-send, robrix-composer, network.http, notifications.post, matrix.room.message.send, host.composer.insert
// why-network: Fetches the URL you save when your background task runs.
// why-notifications: Shows a popup when the keyword first appears.
// why-matrix-room-send: Posts test reports and scheduled matches when you choose room messages.
// why-robrix-composer: Prepares a test report in the message box for you to review and send.

let config = {url: "https://example.com/", keyword: "Example Domain", post: false}
let matched = false
let draft_post = false
let busy = false
let initialized = false
let status = "Ready. Configure and run this app from Background tasks."

fn show_status(text){
    status = text
    if initialized { ui.status.set_text(text) }
}

fn load(){
    if fs.exists("/website_watch.json") {
        let saved = fs.read("/website_watch.json").parse_json()
        if saved.is_object() {
            if saved.url.is_string() && saved.keyword.is_string() && (saved.post == true || saved.post == false)
                && saved.url.trim() != "" && saved.keyword.trim() != ""
                && saved.url.len() <= 2048 && saved.keyword.len() <= 200
            {
                config = saved
            }
        }
    }
    if fs.exists("/website_match.json") {
        matched = (fs.read("/website_match.json") == "true")
    }
}

fn toggle_post(){
    if busy { return nil }
    draft_post = !draft_post
    ui.post_button.set_text(if draft_post { "Report: room message" } else { "Report: Robrix popup" })
}

fn save(){
    if busy { show_status("Wait for the current check to finish before changing it.") return nil }
    let url = ui.url_input.text().trim()
    let keyword = ui.keyword_input.text().trim()
    if url == "" || keyword == "" || url.len() > 2048 || keyword.len() > 200 {
        show_status("Enter an HTTP(S) URL up to 2048 characters and a keyword up to 200 characters.")
        return nil
    }
    config = {url: url, keyword: keyword, post: draft_post}
    fs.write("/website_watch.json", config.to_json())
    matched = false
    fs.write("/website_match.json", "false")
    show_status("Saved. In Mini Apps > Background tasks, add this app in this same room and choose every 12 hours.")
}

fn finish(run, success, text){
    busy = false
    show_status(text)
    if run > 0 { host.request("background.complete", {run_id: run, success: success}) }
}

fn check_website(run){
    if busy {
        show_status("A website check is already running.")
        if run > 0 { host.request("background.complete", {run_id: run, success: false}) }
        return nil
    }
    busy = true
    show_status("Checking the saved website…")
    host.request("network.http", {url: config.url, method: "GET"}, fn(r){
        if !r.is_ok { finish(run, false, r.error) return nil }
        if r.data.status < 200 || r.data.status >= 300 {
            finish(run, false, "The website returned HTTP " + r.data.status)
            return nil
        }
        if r.data.body.len() > 65536 {
            finish(run, false, "The response exceeds this example's 64 KiB text limit. Use a smaller page or feed.")
            return nil
        }
        let found = r.data.body.split(config.keyword).len() > 1
        if !found && run > 0 {
            matched = false
            fs.write("/website_match.json", "false")
            finish(run, true, "Keyword is absent. The next new match will be reported.")
            return nil
        }
        if matched && run > 0 { finish(run, true, "Keyword is still present; already reported.") return nil }
        let message = "Website Watch found '" + config.keyword + "' at " + config.url
        if run == 0 { message = "Website Watch test for '" + config.keyword + "' at " + config.url }
        if config.post {
            host.request("matrix.send_message", {body: message}, fn(out){
                if !out.is_ok { finish(run, false, out.error) return nil }
                if run > 0 {
                    matched = true
                    fs.write("/website_match.json", "true")
                }
                let text = "Match posted to this room."
                if run == 0 { text = "Test report posted to this room." }
                finish(run, true, text)
            })
        } else {
            host.request("notify.post", {body: message}, fn(out){
                if !out.is_ok { finish(run, false, out.error) return nil }
                if run > 0 {
                    matched = true
                    fs.write("/website_match.json", "true")
                }
                let text = "Match reported in a Robrix popup."
                if run == 0 { text = "Test report shown in a Robrix popup." }
                finish(run, true, text)
            })
        }
    })
}

fn test_website(){ check_website(0) }

fn draft_report(){
    if busy { return nil }
    busy = true
    show_status("Preparing a draft…")
    let text = "Website Watch test for '" + config.keyword + "' at " + config.url
    host.request("composer.insert", {text: text}, fn(r){
        busy = false
        if r.is_ok { show_status("Test report drafted. Review and send it in Robrix. The website was not checked.") }
        else { show_status(r.error) }
    })
}

fn on_background(json){ check_website(json.parse_json().run_id) }

fn on_app_resize(width, height){
    if initialized { return nil }
    initialized = true
    ui.status.set_text(status)
    ui.url_input.set_text(config.url)
    ui.keyword_input.set_text(config.keyword)
    draft_post = config.post
    ui.post_button.set_text(if draft_post { "Report: room message" } else { "Report: Robrix popup" })
}

let _load = load()

View{
    width: Fill height: Fill flow: Down
    ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 16
        Label{text: "Website Watch" width: Fill draw_text +: {color: #x1C274C text_style: theme.font_bold{font_size: 20}}}
        Label{text: "Configure this room's watcher here, then enable it in Mini Apps > Background tasks. Try an interval of 12 hours. Matching is literal and case-sensitive; it reports only when a keyword changes from absent to present." width: Fill draw_text +: {color: #x445566 text_style: theme.font_regular{font_size: 12}}}
        url_input := TextInput{width: Fill empty_text: "https://example.com/"}
        keyword_input := TextInput{width: Fill empty_text: "Keyword or phrase"}
        post_button := Button{text: "Report: Robrix popup" on_click: || toggle_post()}
        Button{text: "Save configuration" on_click: || save()}
        Button{text: "Test saved website and report" on_click: || test_website()}
        Button{text: "Draft test report" on_click: || draft_report()}
        status := Label{text: "Default: example.com, keyword Example Domain, popup. Save settings, then test the saved website and report before scheduling checks." width: Fill draw_text +: {color: #x2A7F92 text_style: theme.font_regular{font_size: 12}}}
        Label{text: "Draft test report prepares local text for your review and needs no sending permission. Test saved website and report checks the website and sends one report even if the keyword is absent or already reported. Room-message reports need separate sending permission. Until this room closes expires when the open room closes; use Until you quit Robrix or Forever for scheduled checks after closing. Automated runs cannot renew permissions or open dialogs. Robrix must be running." width: Fill draw_text +: {color: #x445566 text_style: theme.font_regular{font_size: 11}}}
    }
}
