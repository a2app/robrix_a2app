// name: Website Watch
// icon: 🌐
// tint: #2A7F92
// description: Check a website for a keyword on a saved schedule, then notify you or post to this room.
// background: true
// permissions: network, notifications, matrix-room-send, robrix-composer, network.http, notifications.post, matrix.room.message.send, host.composer.insert
// why-network: Fetches the URL you save when your background task runs.
// why-notifications: Shows a popup when the keyword first appears.
// why-matrix-room-send: Posts test reports and scheduled matches when you choose room messages.
// why-robrix-composer: Prepares a test report in the message box for you to review and send.

let config = {url: "https://example.com/", keyword: "Example Domain", post: false}
let matched = false
let draft_post = false
let busy = false
// The background run the check in progress belongs to, or 0.
let active_run = 0
let test_edited = false
let initialized = false
let how_open = false
// The status line's text and tone (0 neutral, 1 success, 2 error); drawn once the pane exists.
let status = ""
let tone = 0
let upper = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M" n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}

fn paint_status(){
    ui.status.set_text(status)
    ui.status_ok.set_text(status)
    ui.status_err.set_text(status)
    ui.status_wrap.set_visible(status != "" && tone == 0)
    ui.busy_wrap.set_visible(busy)
    ui.status_ok_wrap.set_visible(status != "" && tone == 1)
    ui.status_err_wrap.set_visible(status != "" && tone == 2)
}

// Host errors read as sentences: a capital first letter and a final period.
fn sentence(text){
    let chars = text.split("")
    if chars.len() < 3 { return text }
    let up = upper[chars[1]]
    if up == nil { up = chars[1] }
    let out = up + text.strip_prefix(chars[1])
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

// A refused or missing grant gets `denied_text`, which says how to allow it.
fn error_text(error, denied_text){
    if error.search("denied") >= 0 || error.search("not approved") >= 0 || error.search("needs approval") >= 0 { return denied_text }
    return sentence(error)
}

fn show_status(text, next_tone){
    status = text
    tone = next_tone
    if initialized { paint_status() }
}

fn load(){
    if fs.exists("/website_watch.json") {
        let saved = fs.read("/website_watch.json").parse_json()
        if saved.is_object() {
            if saved.url.is_string() && saved.keyword.is_string() && (saved.post == true || saved.post == false)
                && saved.url.trim() != "" && saved.keyword.trim() != ""
                && saved.url.len() <= 2048 && saved.keyword.len() <= 200
            {
                config = saved
            }
        }
    }
    if fs.exists("/website_match.json") {
        matched = (fs.read("/website_match.json") == "true")
    }
}

// Shows the selected report chip; each chip has a selected and an unselected variant.
fn show_post(){
    ui.popup_on.set_visible(!draft_post)
    ui.popup_off.set_visible(draft_post)
    ui.room_on.set_visible(draft_post)
    ui.room_off.set_visible(!draft_post)
}

fn toggle_post(){
    if busy { show_status("Wait for the current check to finish.", 0) return nil }
    draft_post = !draft_post
    if initialized { show_post() }
}

fn set_post(on){
    if on != draft_post { toggle_post() }
}

fn save(){
    if busy { show_status("Wait for the current check to finish before changing it.", 0) return nil }
    let url = ui.url_input.text().trim()
    let keyword = ui.keyword_input.text().trim()
    if url == "" || keyword == "" {
        show_status("Enter both a page address and a keyword.", 2)
        return nil
    }
    if url.len() > 2048 || keyword.len() > 200 {
        show_status("Use an address up to 2048 characters and a keyword up to 200.", 2)
        return nil
    }
    config = {url: url, keyword: keyword, post: draft_post}
    fs.write("/website_watch.json", config.to_json())
    matched = false
    fs.write("/website_match.json", "false")
    show_status("Saved. Turn it on in Mini Apps > Background tasks.", 1)
}

fn finish(run, success, text, next_tone){
    busy = false
    active_run = 0
    show_status(text, next_tone)
    if run > 0 { host.request("background.complete", {run_id: run, success: success}) }
}

fn check_website(run){
    if busy {
        show_status("A check is already running.", 0)
        if run > 0 { host.request("background.complete", {run_id: run, success: false}) }
        return nil
    }
    busy = true
    active_run = run
    let tested_saved = run == 0 && test_edited
    show_status("Checking the page…", 0)
    host.request("network.http", {url: config.url, method: "GET"}, fn(r){
        if !r.is_ok { finish(run, false, error_text(r.error, "Internet access isn't allowed yet. Tap Test report to allow it."), 2) return nil }
        if r.data.status < 200 || r.data.status >= 300 {
            finish(run, false, "The page returned HTTP " + r.data.status + ". Try again later.", 2)
            return nil
        }
        if r.data.body.len() > 65536 {
            finish(run, false, "That page is over 64 KB. Watch a smaller page or feed.", 2)
            return nil
        }
        let found = r.data.body.split(config.keyword).len() > 1
        if !found && run > 0 {
            matched = false
            fs.write("/website_match.json", "false")
            finish(run, true, "Keyword is absent. The next new match will be reported.", 0)
            return nil
        }
        if matched && run > 0 { finish(run, true, "Keyword is still present; already reported.", 0) return nil }
        let message = "Website Watch found '" + config.keyword + "' at " + config.url
        if run == 0 { message = "Website Watch test for '" + config.keyword + "' at " + config.url }
        // A test always reports; its status also says whether the keyword is on the page now.
        let lead = ""
        let done_tone = 1
        if run == 0 && found { lead = "Keyword found. " }
        if run == 0 && !found { lead = "Keyword not on the page now. " done_tone = 0 }
        if config.post {
            host.request("matrix.send_message", {body: message}, fn(out){
                if !out.is_ok { finish(run, false, error_text(out.error, "Room messages aren't allowed yet. Tap Test report to allow them."), 2) return nil }
                if run > 0 {
                    matched = true
                    fs.write("/website_match.json", "true")
                }
                let text = "Match posted to this room."
                let text_tone = done_tone
                if run == 0 { text = lead + "Test report posted to this room." }
                if tested_saved { text = "Tested your saved settings. Tap Save to use your edits." text_tone = 0 }
                finish(run, true, text, text_tone)
            })
        } else {
            host.request("notify.post", {body: message}, fn(out){
                if !out.is_ok { finish(run, false, error_text(out.error, "Popups aren't allowed yet. Tap Test report to allow them."), 2) return nil }
                if run > 0 {
                    matched = true
                    fs.write("/website_match.json", "true")
                }
                let text = "Match reported in a Robrix popup."
                let text_tone = done_tone
                if run == 0 { text = lead + "Test report shown in a Robrix popup." }
                if tested_saved { text = "Tested your saved settings. Tap Save to use your edits." text_tone = 0 }
                finish(run, true, text, text_tone)
            })
        }
    })
}

// Tests always use the saved settings; the status says so when the form differs.
fn test_website(){
    test_edited = false
    if initialized {
        let url_edited = ui.url_input.text().trim() != config.url
        let keyword_edited = ui.keyword_input.text().trim() != config.keyword
        test_edited = url_edited || keyword_edited || draft_post != config.post
    }
    check_website(0)
}

fn draft_report(){
    if busy { return nil }
    busy = true
    show_status("Preparing a draft…", 0)
    let text = "Website Watch test for '" + config.keyword + "' at " + config.url
    host.request("composer.insert", {text: text}, fn(r){
        busy = false
        if !r.is_ok { show_status(error_text(r.error, "Drafts aren't allowed yet. Tap Draft report to allow them."), 2) return nil }
        show_status("Test report drafted. Review and send it in Robrix. The website was not checked.", 1)
        return nil
    })
}

fn on_background(json){ check_website(json.parse_json().run_id) }

fn toggle_how(){
    how_open = !how_open
    ui.how_body.set_visible(how_open)
    ui.how_button.set_text(if how_open { "How it works ▲" } else { "How it works ▼" })
}

fn on_app_resize(width, height){
    if !initialized {
        initialized = true
        ui.url_input.set_text(config.url)
        ui.keyword_input.set_text(config.keyword)
        draft_post = config.post
        show_post()
        paint_status()
    }
    return nil
}

let _load = load()

// A theme switch runs this script again from the top, and no resize follows;
// `resume` picks up the last run's state and ends a check the switch cut off.
fn saved_state(){
    return {initialized: initialized how_open: how_open draft_post: draft_post status: status tone: tone busy: busy active_run: active_run}
}
fn resume(){
    let last_run = ok{mod.state.saved()}
    if last_run == nil {
        mod.state = {saved: saved_state}
        return nil
    }
    mod.state.saved = saved_state
    initialized = last_run.initialized
    how_open = last_run.how_open
    draft_post = last_run.draft_post
    status = last_run.status
    tone = last_run.tone
    // The cut-off check stays busy until it's reported, even across another switch.
    if last_run.busy {
        busy = true
        active_run = last_run.active_run
        let _interrupted = start_timeout(0.05, || finish(active_run, false, "Interrupted by the theme change. Try again.", 0))
    }
    return nil
}
let _resume = resume()

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}
let GhostButton = PrimaryButton{
    padding: Inset{left: 6 right: 6 top: 4 bottom: 4}
    margin: Inset{left: -6}
    draw_bg +: { border_size: 0.0 color: theme.palette.transparent color_hover: theme.palette.card color_down: theme.palette.pressed color_focus: theme.palette.transparent }
    draw_text +: { color: theme.palette.muted color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.muted }
}
let Field = TextInput{
    width: Fill height: Fit padding: 10
    draw_bg +: {
        border_radius: 4.0 border_size: 1.0
        color: theme.palette.surface color_hover: theme.palette.surface color_focus: theme.palette.surface color_down: theme.palette.surface color_empty: theme.palette.surface
        border_color: theme.palette.border border_color_hover: theme.palette.accent border_color_focus: theme.palette.focus border_color_down: theme.palette.focus border_color_empty: theme.palette.border
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.body color_hover: theme.palette.body color_focus: theme.palette.body color_down: theme.palette.body color_empty: theme.palette.placeholder color_empty_hover: theme.palette.placeholder_hover color_empty_focus: theme.palette.placeholder_hover text_style: theme.font_regular{font_size: 11} }
}
// Chips: selected is accent-filled, unselected is white with a gray border.
let ChipOn = PrimaryButton{padding: Inset{left: 10 right: 10 top: 5 bottom: 5} draw_bg +: {border_radius: 12.0}}
let ChipOff = NeutralButton{
    padding: Inset{left: 10 right: 10 top: 5 bottom: 5}
    draw_bg +: { border_radius: 12.0 border_color: theme.palette.border border_color_hover: theme.palette.border border_color_down: theme.palette.border border_color_focus: theme.palette.border
        color: theme.palette.surface color_hover: theme.palette.card color_down: theme.palette.pressed color_focus: theme.palette.surface }
}
let Caption = Label{padding: 0 margin: 0 draw_text +: {color: theme.palette.muted text_style: theme.font_bold{font_size: 9.5}}}
let Hint = Label{width: Fill padding: 0 margin: 0 draw_text +: {color: theme.palette.muted text_style: theme.font_regular{font_size: 10}}}
let Dot = Label{text: "•" padding: 0 margin: 0 draw_text +: {color: theme.palette.muted text_style: theme.font_regular{font_size: 10}}}
let Divider = SolidView{width: Fill{max: 480} height: 1 draw_bg +: {color: theme.palette.divider}}

View{
    width: Fill height: Fill flow: Down
    ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 14
        Hint{text: "Checks a web page for your keyword and tells you when it appears."}
        View{
            width: Fill{max: 480} height: Fit flow: Down spacing: 6
            Caption{text: "PAGE ADDRESS"}
            url_input := Field{empty_text: "https://example.com/"}
        }
        View{
            width: Fill{max: 480} height: Fit flow: Down spacing: 6
            Caption{text: "KEYWORD"}
            keyword_input := Field{empty_text: "A word or phrase on the page"}
            Hint{text: "Case-sensitive."}
        }
        View{
            width: Fill height: Fit flow: Down spacing: 6
            Caption{text: "REPORT AS"}
            View{
                width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                popup_on := View{width: Fit height: Fit ChipOn{text: "Popup" on_click: || set_post(false)}}
                popup_off := View{visible: false width: Fit height: Fit ChipOff{text: "Popup" on_click: || set_post(false)}}
                room_on := View{visible: false width: Fit height: Fit ChipOn{text: "Room message" on_click: || set_post(true)}}
                room_off := View{width: Fit height: Fit ChipOff{text: "Room message" on_click: || set_post(true)}}
            }
        }
        View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
            PrimaryButton{text: "Save" on_click: || save()}
            NeutralButton{text: "Test report" on_click: || test_website()}
            NeutralButton{text: "Draft report" on_click: || draft_report()}
        }
        status_wrap := View{
            visible: false width: Fill{max: 480} height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            busy_wrap := View{
                visible: false width: Fit height: Fit
                LoadingSpinner{width: 18 height: 18 draw_bg +: {color: theme.palette.accent_text}}
            }
            status := Hint{text: ""}
        }
        status_ok_wrap := View{
            visible: false width: Fill{max: 480} height: Fit
            status_ok := Hint{text: "" draw_text +: {color: theme.palette.success}}
        }
        status_err_wrap := View{
            visible: false width: Fill{max: 480} height: Fit
            status_err := Hint{text: "" draw_text +: {color: theme.palette.danger}}
        }
        Divider{}
        how_button := GhostButton{text: "How it works ▼" on_click: || toggle_how()}
        how_body := View{
            visible: false width: Fill{max: 480} height: Fit flow: Down spacing: 6
            View{width: Fill height: Fit spacing: 6 Dot{} Hint{text: "Tap Test report and allow access “Until you quit Robrix” or “Forever”."}}
            View{width: Fill height: Fit spacing: 6 Dot{} Hint{text: "Then turn it on in Mini Apps > Background tasks. Every 12 hours works well."}}
            View{width: Fill height: Fit spacing: 6 Dot{} Hint{text: "You hear once when the keyword appears, then again only if it leaves and returns."}}
            View{width: Fill height: Fit spacing: 6 Dot{} Hint{text: "Test report always reports, match or not. Draft report only drafts one, without checking."}}
        }
    }
}
