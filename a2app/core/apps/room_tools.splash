// name: Room Tools
// icon: 🧰
// tint: #8D6E63
// description: Favorite, low priority, unread, pins and links for this room.
// permissions: matrix-room-read, matrix-room-info, matrix-room-manage, clipboard-write, robrix-navigation, matrix.room.pins.read, matrix.room.messages.read, matrix.room.unread.read, matrix.room.link.create, matrix.room.successor.read, matrix.room.favorite.set, matrix.room.low_priority.set, matrix.room.unread.set, matrix.room.pin.set, device.clipboard.write, host.nav.room
// why-matrix-room-read: Lists recent messages and which of them are pinned.
// why-matrix-room-info: Reads the unread flag, room links and where an upgraded room went.
// why-matrix-room-manage: Changes favorite, low priority, unread and pins when you tap.
// why-clipboard-write: Copies a room or message link when you tap.
// why-robrix-navigation: Opens the upgraded room when you tap.

// Flags stay unknown until matrix.unread answers or a change succeeds.
let unread_loading = false
let unread_loaded = false
let pins_loading = false
let pins_loaded = false
let messages_loading = false
let messages_loaded = false
let successor_loading = false
let successor_loaded = false

let flags = [
    {service: "matrix.favorite", on: nil, pending: false, revision: 0, on_text: "Unfavorite", off_text: "Favorite", done_on: "Added to favorites.", done_off: "Removed from favorites."},
    {service: "matrix.low_priority", on: nil, pending: false, revision: 0, on_text: "Normal priority", off_text: "Low priority", done_on: "Marked low priority.", done_off: "Back to normal priority."},
    {service: "matrix.mark_unread", on: nil, pending: false, revision: 0, on_text: "Clear unread", off_text: "Mark unread", done_on: "Marked unread.", done_off: "Unread flag cleared."}
]
let messages = []
let pins = []
let pending_pins = []
let pins_revision = 0
let successor = ""
let empty_note = "Loading…"
let setup_pending = false

fn flag_text(f){
    if f.on.is_nil() { return f.off_text + "…" }
    if f.on { return f.on_text }
    return f.off_text
}

fn show_flags(){
    ui.fav_btn.set_text(flag_text(flags[0]))
    ui.low_btn.set_text(flag_text(flags[1]))
    ui.unread_btn.set_text(flag_text(flags[2]))
}

fn toggle(i){
    if flags[i].pending { return nil }
    if i < 2 && (flags[0].pending || flags[1].pending) { return nil }
    let want = true
    if !flags[i].on.is_nil() { want = !flags[i].on }
    flags[i].pending = true
    host.request(flags[i].service, {on: want}, fn(r){
        flags[i].pending = false
        if !r.is_ok {
            ui.status.set_text(r.error)
            return nil
        }
        flags[i].on = want
        flags[i].revision = flags[i].revision + 1
        if want && i == 0 {
            flags[1].on = false
            flags[1].revision = flags[1].revision + 1
        }
        if want && i == 1 {
            flags[0].on = false
            flags[0].revision = flags[0].revision + 1
        }
        let note = flags[i].done_off
        if want { note = flags[i].done_on }
        ui.status.set_text(note)
        show_flags()
    })
}

fn load_unread(){
    if unread_loading { return nil }
    unread_loading = true
    let favorite_revision = flags[0].revision
    let priority_revision = flags[1].revision
    let unread_revision = flags[2].revision
    host.request("matrix.unread", nil, fn(r){
        unread_loading = false
        unread_loaded = r.is_ok
        if r.is_ok {
            if !flags[0].pending && flags[0].revision == favorite_revision { flags[0].on = r.data.favorite }
            if !flags[1].pending && flags[1].revision == priority_revision { flags[1].on = r.data.low_priority }
            if !flags[2].pending && flags[2].revision == unread_revision { flags[2].on = r.data.marked_unread }
        } else {
            ui.status.set_text(r.error)
        }
        show_flags()
    })
}

fn is_pinned(event_id){
    for p in pins {
        if p == event_id { return true }
    }
    return false
}

fn pin_line(m){
    if is_pinned(m.event_id) { return "📌 pinned  ·  " + m.sender }
    return "○ " + m.sender
}

fn load_pins(){
    if pins_loading { return nil }
    pins_loading = true
    let revision = pins_revision
    host.request("matrix.pinned_events", nil, fn(r){
        pins_loading = false
        if revision != pins_revision { return nil }
        pins_loaded = r.is_ok
        pins = []
        if r.is_ok {
            for p in r.data.pinned { pins.push(p.event_id) }
            // A branch ending in a loop needs an explicit result.
            nil
        } else {
            ui.status.set_text(r.error)
        }
        ui.msg_list.render()
    })
}

fn load_messages(){
    if messages_loading { return nil }
    messages_loading = true
    host.request("matrix.read_messages", {limit: 15}, fn(r){
        messages_loading = false
        messages_loaded = r.is_ok
        if r.is_ok {
            messages = r.data.messages
            empty_note = "No messages in this room yet."
        } else {
            messages = []
            empty_note = r.error
            ui.status.set_text(r.error)
        }
        ui.msg_list.render()
    })
}

fn toggle_pin(i){
    if i >= messages.len() { return nil }
    let id = messages[i].event_id
    for pending in pending_pins { if pending == id { return nil } }
    let want = !is_pinned(id)
    pending_pins.push(id)
    host.request("matrix.pin", {event_id: id, pinned: want}, fn(r){
        pending_pins.retain(|pending| pending != id)
        if !r.is_ok {
            ui.status.set_text(r.error)
            return nil
        }
        pins_revision += 1
        if want {
            if !is_pinned(id) { pins.push(id) }
            ui.status.set_text("Pinned.")
        } else {
            pins.retain(|p| p != id)
            ui.status.set_text("Unpinned.")
        }
        ui.msg_list.render()
    })
}

fn copy_link(event_id){
    let args = nil
    if event_id != "" { args = {event_id: event_id} }
    host.request("matrix.permalink", args, fn(r){
        if !r.is_ok {
            ui.status.set_text(r.error)
            return nil
        }
        let url = r.data.url
        host.request("clipboard.write", {text: url}, fn(c){
            let note = "Copied " + url
            if !c.is_ok { note = c.error }
            ui.status.set_text(note)
        })
    })
}

fn copy_latest(){
    if messages.len() == 0 {
        ui.status.set_text("No messages to link to yet.")
        return nil
    }
    copy_link(messages[messages.len() - 1].event_id)
}

fn load_successor(){
    if successor_loading { return nil }
    successor_loading = true
    host.request("matrix.successor", nil, fn(r){
        successor_loading = false
        successor_loaded = r.is_ok
        successor = ""
        if r.is_ok && r.data.upgraded { successor = r.data.room_id }
        if !r.is_ok { ui.status.set_text(r.error) }
        if successor.is_nil() { successor = "" }
        ui.upgraded_wrap.set_visible(successor != "")
    })
}

fn open_successor(){
    host.request("nav.room", {room_id: successor}, fn(r){
        if !r.is_ok { ui.status.set_text(r.error) }
    })
}

fn load_all(){
    load_unread()
    load_pins()
    load_messages()
    load_successor()
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.unread.read") { unread_loaded = false }
    elif !unread_loaded { load_unread() }
    if !host.has("matrix.room.pins.read") { pins_loaded = false }
    elif !pins_loaded { load_pins() }
    if !host.has("matrix.room.messages.read") { messages_loaded = false }
    elif !messages_loaded { load_messages() }
    if !host.has("matrix.room.successor.read") { successor_loaded = false }
    elif !successor_loaded { load_successor() }
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-read", "matrix-room-info"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { ui.status.set_text(r.error) return nil }
        let denied = false
        if r.data.permissions["matrix-room-info"] == true && host.has("matrix.room.unread.read") { load_unread() } else { denied = true }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.pins.read") { load_pins() } else { denied = true }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.messages.read") { load_messages() }
        else { denied = true messages = [] empty_note = "Permission denied. Click Refresh to ask again." ui.msg_list.render() }
        if r.data.permissions["matrix-room-info"] == true && host.has("matrix.room.successor.read") { load_successor() } else { denied = true }
        if denied { ui.status.set_text("Some room details were not allowed. Click Refresh to ask again.") }
    })
}

let _boot = start_timeout(0.05, || setup(false))

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        status := Label{
            text: "Each button changes this room only when you tap it." width: Fill padding: 0 margin: 0
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
        Button{ text: "Refresh" on_click: || setup(true) draw_text +: { color: #x1C274C } }
        upgraded_wrap := View{
            width: Fill height: Fit flow: Down spacing: 4 visible: false
            Label{
                text: "This room was upgraded." width: Fill padding: 0 margin: 0
                draw_text +: { color: #xB91C1C text_style: theme.font_bold{font_size: 10} }
            }
            Button{
                text: "Open the upgraded room" width: Fill
                on_click: || open_successor()
                draw_text +: { color: #xB91C1C }
            }
        }
        View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
            fav_btn := Button{ text: "Favorite…" on_click: || toggle(0) draw_text +: { color: #x1C274C } }
            low_btn := Button{ text: "Low priority…" on_click: || toggle(1) draw_text +: { color: #x1C274C } }
            unread_btn := Button{ text: "Mark unread…" on_click: || toggle(2) draw_text +: { color: #x1C274C } }
            Button{ text: "Copy room link" on_click: || copy_link("") draw_text +: { color: #x1C274C } }
            Button{ text: "Copy link to latest message" on_click: || copy_latest() draw_text +: { color: #x1C274C } }
        }
        Label{
            text: "RECENT MESSAGES · tap one to pin or unpin it" width: Fill padding: 0 margin: 0
            draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
        }
        msg_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down spacing: 5
            on_item_tap: |i| toggle_pin(i)
            on_render: || {
                if messages.len() == 0 {
                    Label{
                        text: empty_note width: Fill padding: 0 margin: 0
                        draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                    }
                } else {
                    for m in messages {
                        RoundedView{
                            width: Fill height: Fit flow: Down spacing: 2 padding: 10
                            show_bg: true
                            draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                            Label{
                                text: pin_line(m) width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                            }
                            Label{
                                text: m.body width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                            }
                        }
                    }
                }
            }
        }
    }
}
