        }
        // render() reapplies its view's declaration, so visibility lives on this wrapper.
        list_wrap := View{
            width: Fill height: Fill{min: 80} visible: false
            msg_list := ScrollYView{
                width: Fill height: Fill flow: Down spacing: 8
                on_item_tap: |i| jump_to_message(i)
                on_render: || {
                    for row in mod.state.rows {
                        RoundedView{
                            width: Fill height: Fit flow: Right spacing: 10 padding: 10
                            show_bg: true
                            draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
                            View{
                                width: 32 height: 32 visible: mod.state.show_avatars
                                RoundedView{
                                    width: 32 height: 32 align: Align{x: 0.5 y: 0.5}
                                    show_bg: true
                                    draw_bg +: { color: theme.palette.avatar border_radius: 16.0 }
                                    Label{ text: row.initial padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 12} } }
                                }
                            }
                            View{
                                width: Fill height: Fit flow: Down spacing: 3
                                View{
