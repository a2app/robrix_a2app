// name: Room Peek
// icon: 👀
// tint: #4A90D9
// description: Room details and separate actions to draft text/media or send text/files now.
// permissions: matrix-room-info, matrix-room-read, matrix-room-send, robrix-composer, files, matrix-media, robrix-navigation, matrix-room-watch, matrix.room.info.read, matrix.room.messages.read, matrix.room.event.read, matrix.room.message.send, host.composer.insert, host.composer.attach, device.files.pick, matrix.media.upload, matrix.media.send, host.nav.event, on_room_message, on_room_members_changed, on_room_typing, on_room_reaction, on_room_message_changed
// why-matrix-room-info: Shows this room's name and member count.
// why-matrix-room-read: Lists the latest messages in this room and their reactions.
// why-matrix-room-send: Sends your typed message only when you press Send now.
// why-robrix-composer: Prepares draft text or a picked attachment for you to review and send in Robrix.
// why-files: Opens the picker only for Attach file or Send file now; selected files are limited to 1 MiB.
// why-matrix-media: Uploads and posts the file only when you press Send file now. Local attachment drafts need no media-send grant.
// why-robrix-navigation: Jumps to a message you tap.
// why-matrix-room-watch: Shows new messages, typing, edits and reactions as they arrive.

let subscribed_events = []
let pending_events = []

let room_loading = false
let room_loaded = false
let room_refresh_pending = false
let messages_loading = false
let messages_loaded = false
let messages_reload_pending = false
let sending = false
let drafting = false
let attaching = false
let setup_pending = false

let room_name = ""
let room_line = "Loading…"
let live_note = ""
let empty_line = "Loading…"
let messages = []
let messages_during_read = []
let rx_queue = []
let rx_busy = false

fn show_room(){
    ui.room_title.set_text(room_name)
    let line = room_line
    if live_note != "" { line = line + " · " + live_note }
    ui.room_line.set_text(line)
}

fn load_room(){
    if room_loading { return nil }
    room_loading = true
    host.request("matrix.room_info", nil, fn(r){
        room_loading = false
        room_loaded = r.is_ok
        if r.is_ok {
            room_name = r.data.room_name
            room_line = "" + r.data.member_count + " members"
        } else {
            room_line = r.error
        }
        show_room()
    })
}

fn index_of(list, id){
    let i = 0
    while i < list.len() {
        if list[i].event_id == id { return i }
        i += 1
    }
    return -1
}

// One matrix.event a second: each costs 5 of a 30 token budget refilling 6 a second.
fn fetch_reactions(){
    if rx_queue.len() == 0 {
        rx_busy = false
        return nil
    }
    let id = rx_queue[0]
    rx_queue.remove(0)
    host.request("matrix.event", {event_id: id}, fn(r){
        if !r.is_ok { rx_queue.clear() }
        let i = index_of(messages, id)
        if r.is_ok && i >= 0 {
            messages[i].reactions = r.data.reactions
            ui.msg_list.render()
        }
        rx_busy = rx_queue.len() > 0 && start_timeout(1.0, || fetch_reactions()) != nil
    })
}

fn load_messages(){
    if messages_loading { return nil }
    messages_loading = true
    messages_during_read = []
    host.request("matrix.read_messages", {limit: 15}, fn(r){
        messages_loading = false
        messages_loaded = r.is_ok
        let live = messages_during_read
        messages_during_read = []
        let old = messages
        let pending = rx_queue
        messages = []
        rx_queue = []
        if r.is_ok {
            empty_line = "No messages yet."
            for m in r.data.messages {
                let live_index = index_of(live, m.event_id)
                if live_index >= 0 {
                    messages.push(live[live_index])
                    continue
                }
                let i = index_of(old, m.event_id)
                if i >= 0 {
                    m.reactions = old[i].reactions
                } else {
                    m.reactions = []
                    pending.push(m.event_id)
                }
                messages.push(m)
            }
            // A branch ending in a loop needs an explicit result.
            nil
        } else {
            empty_line = r.error
        }
        for m in live {
            if index_of(messages, m.event_id) < 0 { messages.push(m) }
        }
        // Merge only events delivered during this read, ordered oldest first.
        let i = 1
        while i < messages.len() {
            let j = i
            while j > 0 && messages[j].ts < messages[j - 1].ts {
                let previous = messages[j - 1]
                messages[j - 1] = messages[j]
                messages[j] = previous
                j -= 1
            }
            i += 1
        }
        while messages.len() > 15 { messages.remove(0) }
        for id in pending {
            if index_of(messages, id) >= 0 { rx_queue.push(id) }
        }
        ui.msg_list.render()
        if messages_reload_pending {
            messages_reload_pending = false
            let _reload = start_timeout(1.0, || load_messages())
        }
        if rx_busy || rx_queue.len() == 0 { return nil }
        rx_busy = true
        fetch_reactions()
    })
}

fn reactions_line(m){
    let line = ""
    for r in m.reactions {
        if line != "" { line = line + " · " }
        line = line + r.key + " " + r.count
        if r.mine { line = line + " (you)" }
    }
    return line
}

fn jump_to_message(i){
    if i >= messages.len() { return nil }
    host.request("nav.event", {event_id: messages[i].event_id}, fn(r){
        if !r.is_ok { ui.send_note.set_text(r.error) }
    })
}

fn draft_msg(){
    if sending || drafting || attaching { return nil }
    let text = ui.msg_input.text()
    if text.trim() == "" {
        ui.send_note.set_text("Type a message first.")
        return nil
    }
    drafting = true
    ui.send_note.set_text("Preparing a draft…")
    host.request("composer.insert", {text: text}, fn(r){
        drafting = false
        if r.is_ok {
            ui.send_note.set_text("Draft ready. Review and send it in Robrix.")
            if ui.msg_input.text() == text { ui.msg_input.set_text("") }
        } else { ui.send_note.set_text(r.error) }
    })
}

fn optional_field(obj, key){
    if !obj.is_object() { return nil }
    for field value in obj {
        if field.to_string() == key { return value }
    }
    return nil
}

fn attach_file(){
    if sending || drafting || attaching { return nil }
    attaching = true
    let caption = ui.msg_input.text()
    ui.send_note.set_text("Choose an image or file to draft…")
    host.request("files.pick", nil, fn(r){
        if !r.is_ok { attaching = false ui.send_note.set_text(r.error) return nil }
        if optional_field(r.data, "cancelled") == true {
            attaching = false
            ui.send_note.set_text("No attachment selected.")
            return nil
        }
        host.request("composer.attach", {data_base64: r.data.data_base64, filename: r.data.name, mime_type: r.data.mime_type, caption: caption}, fn(out){
            attaching = false
            if out.is_ok {
                ui.send_note.set_text("Attachment ready. Review and send it in Robrix.")
                if ui.msg_input.text() == caption { ui.msg_input.set_text("") }
            } else { ui.send_note.set_text(out.error) }
        })
    })
}

fn send_msg(){
    if sending || drafting || attaching { return nil }
    let draft = ui.msg_input.text()
    let body = draft.trim()
    if body == "" {
        ui.send_note.set_text("Type a message first.")
        return nil
    }
    sending = true
    ui.send_note.set_text("Sending…")
    host.request("matrix.send_message", {body: body}, fn(r){
        sending = false
        if r.is_ok {
            ui.send_note.set_text("Sent!")
            if ui.msg_input.text() == draft { ui.msg_input.set_text("") }
            if messages_loading { messages_reload_pending = true } else { load_messages() }
            return nil
        }
        ui.send_note.set_text(r.error)
    })
}

fn send_file_now(){
    if sending || drafting || attaching { return nil }
    sending = true
    let caption = ui.msg_input.text()
    ui.send_note.set_text("Choose an image or file to send now…")
    host.request("files.pick", nil, fn(r){
        if !r.is_ok { sending = false ui.send_note.set_text(r.error) return nil }
        if optional_field(r.data, "cancelled") == true {
            sending = false
            ui.send_note.set_text("No file sent.")
            return nil
        }
        ui.send_note.set_text("Sending selected file…")
        host.request("matrix.send_media", {data_base64: r.data.data_base64, filename: r.data.name, mime_type: r.data.mime_type, caption: caption}, fn(out){
            sending = false
            if out.is_ok {
                ui.send_note.set_text("File sent!")
                if ui.msg_input.text() == caption { ui.msg_input.set_text("") }
                if messages_loading { messages_reload_pending = true } else { load_messages() }
                return nil
            }
            ui.send_note.set_text(out.error)
        })
    })
}

fn on_room_message(json){
    let batch = json.parse_json()
    for m in batch {
        if index_of(messages, m.event_id) >= 0 { continue }
        m.reactions = []
        messages.push(m)
        if messages_loading {
            messages_during_read.push(m)
            while messages_during_read.len() > 15 { messages_during_read.remove(0) }
        }
    }
    while messages.len() > 15 { messages.remove(0) }
    ui.msg_list.render()
}

fn on_room_typing(json){
    let who = json.parse_json().typing
    let line = ""
    if who.len() == 1 { line = who[0].name + " is typing…" }
    elif who.len() == 2 { line = who[0].name + " and " + who[1].name + " are typing…" }
    elif who.len() > 2 { line = who[0].name + ", " + who[1].name + " and " + (who.len() - 2) + " more are typing…" }
    ui.typing.set_text(line)
    ui.typing_wrap.set_visible(line != "")
}

fn on_room_reaction(json){
    let p = json.parse_json()
    let i = index_of(messages, p.event_id)
    if i < 0 { return nil }
    let rx = messages[i].reactions
    let found = false
    let j = 0
    while j < rx.len() {
        if rx[j].key == p.key {
            let delta = -1
            if p.added { delta = 1 }
            rx[j].count += delta
            if p.is_own { rx[j].mine = p.added }
            found = true
        }
        j += 1
    }
    if !found && p.added { rx.push({key: p.key count: 1 mine: p.is_own}) }
    rx.retain(|x| x.count > 0)
    ui.msg_list.render()
}

fn on_room_message_changed(json){
    let p = json.parse_json()
    let i = index_of(messages, p.event_id)
    if i < 0 { return nil }
    let body = p.body
    if p.redacted { body = "(deleted)" }
    messages[i].body = body
    ui.msg_list.render()
}

fn on_room_members_changed(json){
    schedule_room_refresh()
}

fn schedule_room_refresh(){
    if room_refresh_pending || !host.has("matrix.room.info.read") { return nil }
    room_refresh_pending = start_timeout(1.0, || {
        room_refresh_pending = false
        if !host.has("matrix.room.info.read") { return nil }
        if room_loading { schedule_room_refresh() } else { load_room() }
    }) != nil
}

fn subscribe(name){
    for event in subscribed_events { if event == name { return nil } }
    for event in pending_events { if event == name { return nil } }
    pending_events.push(name)
    host.request("events.subscribe", {event: name}, fn(r){
        pending_events.retain(|event| event != name)
        if r.is_ok {
            subscribed_events.push(name)
            if subscribed_events.len() == 5 {
                live_note = ""
                show_room()
            }
        }
        if r.is_ok || live_note != "" { return nil }
        live_note = "live updates off: " + r.error
        show_room()
    })
}

fn watch_granted(){
    subscribed_events.retain(|event| host.has(event))
    if host.has("on_room_message") { subscribe("on_room_message") }
    if host.has("on_room_members_changed") { subscribe("on_room_members_changed") }
    if host.has("on_room_typing") { subscribe("on_room_typing") }
    if host.has("on_room_reaction") { subscribe("on_room_reaction") }
    if host.has("on_room_message_changed") { subscribe("on_room_message_changed") }
}

fn watch(){
    live_note = ""
    show_room()
    subscribe("on_room_message")
    subscribe("on_room_members_changed")
    subscribe("on_room_typing")
    subscribe("on_room_reaction")
    subscribe("on_room_message_changed")
}

fn on_app_resize(w, h){
    ui.title_wrap.set_visible(h >= 520)
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.info.read") { room_loaded = false }
    elif !room_loaded { load_room() }
    if !host.has("matrix.room.messages.read") { messages_loaded = false }
    elif !messages_loaded { load_messages() }
    watch_granted()
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-info", "matrix-room-read", "matrix-room-watch"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { room_line = r.error show_room() return nil }
        if r.data.permissions["matrix-room-info"] == true && host.has("matrix.room.info.read") { load_room() }
        else { room_line = "Permission denied. Click Refresh to ask again." show_room() }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.messages.read") { load_messages() }
        else {
            messages = []
            empty_line = "Permission denied. Click Refresh to ask again."
            ui.msg_list.render()
        }
        if r.data.permissions["matrix-room-watch"] == true { watch_granted() }
    })
}

let _boot = start_timeout(0.05, || setup(false))

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        title_wrap := View{
            width: Fill height: Fit
            room_title := Label{
                text: "" width: Fill padding: 0 margin: 0
                draw_text +: { color: #x1C274C text_style: theme.font_bold{font_size: 20} }
            }
        }
        room_line := Label{
            text: "Loading…" width: Fill padding: 0 margin: 0
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
        Button{ text: "Refresh" on_click: || setup(true) draw_text +: { color: #x1C274C } }
        msg_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down spacing: 6
            on_item_tap: |i| jump_to_message(i)
            on_render: || {
                if messages.len() == 0 {
                    Label{
                        text: empty_line
                        width: Fill padding: 0 margin: 0
                        draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                    }
                } else {
                    for m in messages {
                        RoundedView{
                            width: Fill height: Fit flow: Down spacing: 2 padding: 10
                            show_bg: true
                            draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                            Label{
                                text: m.sender width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                            }
                            Label{
                                text: m.body width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                            }
                            View{
                                width: Fill height: Fit visible: m.reactions.len() > 0
                                Label{ text: reactions_line(m) width: Fill padding: 0 margin: 0 draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 11} } }
                            }
                        }
                    }
                }
            }
        }
        typing_wrap := View{
            width: Fill height: Fit visible: false
            typing := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: #x66708F text_style: theme.font_regular{font_size: 11} } }
        }
        View{
            width: Fill height: Fit flow: Down spacing: 8
            msg_input := TextInput{
                width: Fill empty_text: "Message or attachment caption…"
                on_return: |t| draft_msg()
            }
            View{
                width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                Button{ text: "Draft message" on_click: || draft_msg() draw_text +: { color: #x1C274C } }
                Button{ text: "Attach file" on_click: || attach_file() draw_text +: { color: #x1C274C } }
                Button{ text: "Send now" on_click: || send_msg() draw_text +: { color: #x1C274C } }
                Button{ text: "Send file now" on_click: || send_file_now() draw_text +: { color: #x1C274C } }
            }
        }
        Label{
            text: "Draft message and Attach file prepare local content for review without sending permission. Send now posts text; Send file now uploads and posts the selected file. Both need separate sending permission. Picked files are limited to 1 MiB."
            width: Fill padding: 0 margin: 0
            draw_text +: { color: #x66708F text_style: theme.font_regular{font_size: 11} }
        }
        send_note := Label{
            text: "" padding: 0 margin: 0
            width: Fill
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
    }
}
