                                    Label{ text: row.when padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                                }
                                Label{ text: row.body width: Fill padding: 0 margin: 0 draw_text +: { color: if row.is_deleted {theme.palette.muted} else {theme.palette.body} text_style: theme.font_regular{font_size: 11} } }
                                if row.pills.len() > 0 {
                                    View{
                                        width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 4 margin: Inset{top: 3}
                                        for p in row.pills {
