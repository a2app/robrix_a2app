// name: Room Peek
// icon: 👀
// tint: #4A90D9
// description: Room details and separate actions to draft text/media or send text/files now.
// permissions: matrix-room-info, matrix-room-read, matrix-room-send, robrix-composer, files, matrix-media, robrix-navigation, matrix-room-watch, matrix.room.info.read, matrix.room.messages.read, matrix.room.event.read, matrix.room.message.send, host.composer.insert, host.composer.attach, device.files.pick, matrix.media.upload, matrix.media.send, host.nav.event, on_room_message, on_room_members_changed, on_room_typing, on_room_reaction, on_room_message_changed
// why-matrix-room-info: Shows this room's name and member count.
// why-matrix-room-read: Lists the latest messages in this room and their reactions.
// why-matrix-room-send: Sends your typed message only when you press Send now.
// why-robrix-composer: Prepares draft text or a picked attachment for you to review and send in Robrix.
// why-files: Opens the picker only for Attach file or Send file now; selected files are limited to 1 MiB.
// why-matrix-media: Uploads and posts the file only when you press Send file now. Local attachment drafts need no media-send grant.
// why-robrix-navigation: Jumps to a message you tap.
// why-matrix-room-watch: Shows new messages, typing, edits and reactions as they arrive.

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}
let GhostButton = PrimaryButton{
    padding: Inset{left: 6 right: 6 top: 4 bottom: 4}
    margin: Inset{left: -6}
    draw_bg +: { border_size: 0.0 color: theme.palette.transparent color_hover: theme.palette.card color_down: theme.palette.pressed color_focus: theme.palette.transparent }
    draw_text +: { color: theme.palette.muted color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.muted }
}
let Field = TextInput{
    width: Fill height: Fit padding: 10
    draw_bg +: {
        border_radius: 4.0 border_size: 1.0
        color: theme.palette.surface color_hover: theme.palette.surface color_focus: theme.palette.surface color_down: theme.palette.surface color_empty: theme.palette.surface
        border_color: theme.palette.border border_color_hover: theme.palette.accent border_color_focus: theme.palette.focus border_color_down: theme.palette.focus border_color_empty: theme.palette.border
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.body color_hover: theme.palette.body color_focus: theme.palette.body color_down: theme.palette.body color_empty: theme.palette.placeholder color_empty_hover: theme.palette.placeholder_hover color_empty_focus: theme.palette.placeholder_hover text_style: theme.font_regular{font_size: 11} }
}

let subscribed_events = []
let pending_events = []

let room_loading = false
let room_loaded = false
let room_refresh_pending = false
let messages_loading = false
let messages_loaded = false
let messages_reload_pending = false
let setup_pending = false
let messages_during_read = []
let rx_busy = false

// What the pane shows, kept through the re-run a theme switch does. Without rows the list area
// shows loading, ready (nothing yet), denied or error; rows are newest first.
mod.state = {
    room_name: "" room_line: "Loading…" room_line_is_error: false live_note: "" list_state: "loading" list_error: ""
    messages: [] rx_queue: [] rows: [] show_avatars: true is_compact: false is_tiny: false is_no_room: false
    how_open: false is_foreground: true
    // The compose request awaiting its reply: "pick", "draft", "attach", "send", "file" or "".
    in_flight: ""
}

let lower_az = "abcdefghijklmnopqrstuvwxyz"
let upper_az = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

let error_prefix = regex("^[Cc]ouldn't [^:]*: ")

// "couldn't read messages: the server timed out" -> "The server timed out."
fn sentence(text){
    let t = text.replace(error_prefix, "")
    let chars = t.split("")
    if chars.len() < 3 { return t }
    let i = lower_az.search(chars[1])
    if chars[1].len() == 1 && i >= 0 { t = upper_az.split("")[i + 1] + t.strip_prefix(chars[1]) }
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { t = t + "." }
    return t
}

fn note_no_room(error){
    if error.search("not attached") >= 0 { mod.state.is_no_room = true }
}

// 1284 -> "1,284"
fn count_text(n){
    if n < 1000 { return "" + n }
    let rest = n % 1000
    let pad = "" + rest
    if rest < 10 { pad = "00" + pad } elif rest < 100 { pad = "0" + pad }
    return count_text(floor(n / 1000)) + "," + pad
}

fn member_text(n){
    if !n.is_number() { return "" }
    if n == 1 { return "1 member" }
    return count_text(n) + " members"
}

fn set_note(kind, text){
    ui.send_note.set_text(text)
    ui.send_ok.set_text(text)
    ui.send_err.set_text(text)
    ui.send_note_wrap.set_visible(kind == "info" && text != "")
    ui.send_ok_wrap.set_visible(kind == "ok")
    ui.send_err_wrap.set_visible(kind == "err")
}

fn show_room(){
    ui.room_title.set_text(mod.state.room_name)
    ui.title_wrap.set_visible(mod.state.room_name != "")
    let line = mod.state.room_line
    if mod.state.live_note != "" {
        if line != "" { line = line + " · " }
        line = line + mod.state.live_note
    }
    ui.room_line.set_text(line)
    ui.room_err.set_text(line)
    ui.room_line_wrap.set_visible(!mod.state.room_line_is_error && line != "")
    ui.room_err_wrap.set_visible(mod.state.room_line_is_error)
    show_frame()
}

// Without a room only the explanation shows; narrow panes put Refresh under the title.
fn show_frame(){
    ui.head_row.set_visible(!mod.state.is_no_room)
    ui.compose_wrap.set_visible(!mod.state.is_no_room)
    ui.no_room_wrap.set_visible(mod.state.is_no_room)
    if mod.state.is_no_room {
        ui.list_wrap.set_visible(false)
        ui.list_loading.set_visible(false)
        ui.list_empty.set_visible(false)
    }
    ui.refresh_wide.set_visible(!mod.state.is_tiny)
    ui.refresh_narrow.set_visible(mod.state.is_tiny && !mod.state.is_no_room)
}

fn load_room(){
    if room_loading { return nil }
    room_loading = true
    host.request("matrix.room_info", nil, fn(r){
        room_loading = false
        room_loaded = r.is_ok
        if r.is_ok {
            mod.state.room_name = r.data.room_name
            mod.state.room_line = member_text(r.data.member_count)
            mod.state.room_line_is_error = false
        } else {
            note_no_room(r.error)
            mod.state.room_line = "Couldn't load room details. " + sentence(r.error)
            mod.state.room_line_is_error = true
        }
        show_room()
    })
}

fn index_of(list, id){
    let i = 0
    while i < list.len() {
        if list[i].event_id == id { return i }
        i += 1
    }
    return -1
}

// "Just now", "5m ago", "3h ago", "Yesterday", "2d ago", "3w ago", ...
fn ago(ts){
    if !ts.is_number() || ts <= 0 { return "" }
    let s = time_now() - ts / 1000.0
    if s < 60.0 { return "Just now" }
    if s < 3600.0 { return "" + floor(s / 60.0) + "m ago" }
    if s < 86400.0 { return "" + floor(s / 3600.0) + "h ago" }
    if s < 172800.0 { return "Yesterday" }
    if s < 604800.0 { return "" + floor(s / 86400.0) + "d ago" }
    if s < 2592000.0 { return "" + floor(s / 604800.0) + "w ago" }
    if s < 31536000.0 { return "" + floor(s / 2592000.0) + "mo ago" }
    return "" + floor(s / 31536000.0) + "y ago"
}

// The room display name the host sends; older hosts send only the localpart.
fn display_name(m){
    let name = m["sender_name"]
    if name.is_string() && name != "" { return name }
    name = m["sender"]
    if name.is_string() && name != "" { return name }
    return "Someone"
}

fn initial_of(name){
    let chars = name.split("")
    if chars.len() < 3 { return "?" }
    let c = chars[1]
    if c == "@" && chars.len() > 3 { c = chars[2] }
    if c.len() != 1 { return c }
    let i = lower_az.search(c)
    if i < 0 { return c }
    return upper_az.split("")[i + 1]
}

fn body_text(m){
    let kind = m["msgtype"]
    if kind == "m.image" { return "🖼 " + m.body }
    if kind == "m.video" { return "🎬 " + m.body }
    if kind == "m.audio" { return "🎵 " + m.body }
    if kind == "m.file" { return "📎 " + m.body }
    if kind == "m.emote" { return "* " + m.body }
    return m.body
}

fn build_rows(){
    let out = []
    let i = mod.state.messages.len() - 1
    while i >= 0 {
        let m = mod.state.messages[i]
        let name = display_name(m)
        let deleted = m["redacted"] == true
        let body = body_text(m)
        if deleted { body = "Message deleted" }
        let pills = []
        for r in m.reactions {
            pills.push({text: r.key + " " + r.count mine: r.mine == true})
        }
        out.push({name: name initial: initial_of(name) when: ago(m["ts"]) body: body is_deleted: deleted pills: pills})
        i -= 1
    }
    mod.state.rows = out;
}

// Rows render only when there are some: an emptied list can't clear its old children.
fn render_list(){
    build_rows()
    let has_rows = mod.state.rows.len() > 0 && !mod.state.is_no_room
    if has_rows { ui.msg_list.render() }
    ui.list_wrap.set_visible(has_rows)
    ui.list_loading.set_visible(!has_rows && mod.state.list_state == "loading" && !mod.state.is_no_room)
    ui.list_empty.set_visible(!has_rows && mod.state.list_state != "loading" && !mod.state.is_no_room)
    ui.no_room_wrap.set_visible(mod.state.is_no_room)
    if has_rows || mod.state.list_state == "loading" { return nil }
    let icon = "📭"
    let title = "No messages yet"
    let detail = "New messages show up here."
    let action = ""
    if mod.state.list_state == "denied" {
        icon = "🔒"
        title = "Can't read this room"
        detail = "Allow Room Peek to read this room's latest messages."
        action = "Ask again"
    }
    if mod.state.list_state == "error" {
        icon = "😕"
        title = "Couldn't load messages"
        detail = mod.state.list_error
        action = "Try again"
    }
    ui.empty_icon.set_text(icon)
    ui.empty_title.set_text(title)
    ui.empty_detail.set_text(detail)
    ui.empty_btn_wrap.set_visible(action == "Try again")
    ui.ask_btn_wrap.set_visible(action == "Ask again")
    return nil
}

// One matrix.event a second: each costs 5 of a 30 token budget refilling 6 a second.
fn fetch_reactions(){
    if mod.state.rx_queue.len() == 0 {
        rx_busy = false
        return nil
    }
    let id = mod.state.rx_queue[0]
    mod.state.rx_queue.remove(0)
    host.request("matrix.event", {event_id: id}, fn(r){
        if !r.is_ok { mod.state.rx_queue.clear() }
        let i = index_of(mod.state.messages, id)
        if r.is_ok && i >= 0 {
            mod.state.messages[i].reactions = r.data.reactions
            render_list()
        }
        rx_busy = mod.state.rx_queue.len() > 0 && start_timeout(1.0, || fetch_reactions()) != nil
    })
}

fn load_messages(){
    if messages_loading { return nil }
    messages_loading = true
    messages_during_read = []
    host.request("matrix.read_messages", {limit: 15}, fn(r){
        messages_loading = false
        messages_loaded = r.is_ok
        let live = messages_during_read
        messages_during_read = []
        let old = mod.state.messages
        let pending = mod.state.rx_queue
        mod.state.messages = []
        mod.state.rx_queue = []
        if r.is_ok {
            mod.state.list_state = "ready"
            for m in r.data.messages {
                let live_index = index_of(live, m.event_id)
                if live_index >= 0 {
                    mod.state.messages.push(live[live_index])
                    continue
                }
                let i = index_of(old, m.event_id)
                if i >= 0 {
                    m.reactions = old[i].reactions
                } else {
                    m.reactions = []
                    pending.push(m.event_id)
                }
                mod.state.messages.push(m)
            }
            // A branch ending in a loop needs an explicit result.
            nil
        } else {
            note_no_room(r.error)
            mod.state.list_state = "error"
            mod.state.list_error = sentence(r.error)
        }
        for m in live {
            if index_of(mod.state.messages, m.event_id) < 0 { mod.state.messages.push(m) }
        }
        // Merge only events delivered during this read, ordered oldest first.
        let i = 1
        while i < mod.state.messages.len() {
            let j = i
            while j > 0 && mod.state.messages[j].ts < mod.state.messages[j - 1].ts {
                let previous = mod.state.messages[j - 1]
                mod.state.messages[j - 1] = mod.state.messages[j]
                mod.state.messages[j] = previous
                j -= 1
            }
            i += 1
        }
        while mod.state.messages.len() > 15 { mod.state.messages.remove(0) }
        for id in pending {
            if index_of(mod.state.messages, id) >= 0 { mod.state.rx_queue.push(id) }
        }
        render_list()
        show_frame()
        if messages_reload_pending {
            messages_reload_pending = false
            let _reload = start_timeout(1.0, || load_messages())
        }
        if rx_busy || mod.state.rx_queue.len() == 0 { return nil }
        rx_busy = true
        fetch_reactions()
    })
}

// Rows show newest first, so tap i is the i-th newest message.
fn jump_to_message(i){
    if i >= mod.state.messages.len() { return nil }
    let m = mod.state.messages[mod.state.messages.len() - 1 - i]
    host.request("nav.event", {event_id: m.event_id}, fn(r){
        if !r.is_ok { set_note("err", "Couldn't jump to that message. " + sentence(r.error)) }
        return nil
    })
}

fn draft_msg(){
    if mod.state.in_flight != "" { return nil }
    let text = ui.msg_input.text()
    if text.trim() == "" {
        set_note("info", "Type a message first.")
        return nil
    }
    mod.state.in_flight = "draft"
    set_note("info", "Preparing a draft…")
    host.request("composer.insert", {text: text}, fn(r){
        mod.state.in_flight = ""
        if r.is_ok {
            set_note("ok", "Draft ready. Review and send it in Robrix.")
            if ui.msg_input.text() == text { ui.msg_input.set_text("") }
        } else { set_note("err", sentence(r.error)) }
    })
}

fn optional_field(obj, key){
    if !obj.is_object() { return nil }
    for field value in obj {
        if field.to_string() == key { return value }
    }
    return nil
}

fn attach_file(){
    if mod.state.in_flight != "" { return nil }
    mod.state.in_flight = "pick"
    let caption = ui.msg_input.text()
    set_note("info", "Choose an image or file to draft…")
    host.request("files.pick", nil, fn(r){
        if !r.is_ok { mod.state.in_flight = "" set_note("err", sentence(r.error)) return nil }
        if optional_field(r.data, "cancelled") == true {
            mod.state.in_flight = ""
            set_note("info", "No attachment selected.")
            return nil
        }
        mod.state.in_flight = "attach"
        host.request("composer.attach", {data_base64: r.data.data_base64, filename: r.data.name, mime_type: r.data.mime_type, caption: caption}, fn(out){
            mod.state.in_flight = ""
            if out.is_ok {
                set_note("ok", "Attachment ready. Review and send it in Robrix.")
                if ui.msg_input.text() == caption { ui.msg_input.set_text("") }
            } else { set_note("err", sentence(out.error)) }
        })
    })
}

fn send_msg(){
    if mod.state.in_flight != "" { return nil }
    let draft = ui.msg_input.text()
    let body = draft.trim()
    if body == "" {
        set_note("info", "Type a message first.")
        return nil
    }
    mod.state.in_flight = "send"
    set_note("info", "Sending…")
    host.request("matrix.send_message", {body: body}, fn(r){
        mod.state.in_flight = ""
        if r.is_ok {
            set_note("ok", "Sent!")
            if ui.msg_input.text() == draft { ui.msg_input.set_text("") }
            if messages_loading { messages_reload_pending = true } else { load_messages() }
            return nil
        }
        set_note("err", sentence(r.error))
    })
}

fn send_file_now(){
    if mod.state.in_flight != "" { return nil }
    mod.state.in_flight = "pick"
    let caption = ui.msg_input.text()
    set_note("info", "Choose an image or file to send now…")
    host.request("files.pick", nil, fn(r){
        if !r.is_ok { mod.state.in_flight = "" set_note("err", sentence(r.error)) return nil }
        if optional_field(r.data, "cancelled") == true {
            mod.state.in_flight = ""
            set_note("info", "No file sent.")
            return nil
        }
        mod.state.in_flight = "file"
        set_note("info", "Sending selected file…")
        host.request("matrix.send_media", {data_base64: r.data.data_base64, filename: r.data.name, mime_type: r.data.mime_type, caption: caption}, fn(out){
            mod.state.in_flight = ""
            if out.is_ok {
                set_note("ok", "File sent!")
                if ui.msg_input.text() == caption { ui.msg_input.set_text("") }
                if messages_loading { messages_reload_pending = true } else { load_messages() }
                return nil
            }
            set_note("err", sentence(out.error))
        })
    })
}

fn on_room_message(json){
    let batch = json.parse_json()
    for m in batch {
        if index_of(mod.state.messages, m.event_id) >= 0 { continue }
        m.reactions = []
        mod.state.messages.push(m)
        if messages_loading {
            messages_during_read.push(m)
            while messages_during_read.len() > 15 { messages_during_read.remove(0) }
        }
    }
    while mod.state.messages.len() > 15 { mod.state.messages.remove(0) }
    render_list()
}

fn on_room_typing(json){
    let who = json.parse_json().typing
    let line = ""
    if who.len() == 1 { line = who[0].name + " is typing…" }
    elif who.len() == 2 { line = who[0].name + " and " + who[1].name + " are typing…" }
    elif who.len() > 2 { line = who[0].name + ", " + who[1].name + " and " + (who.len() - 2) + " more are typing…" }
    ui.typing.set_text(line)
    ui.typing_wrap.set_visible(line != "")
}

fn on_room_reaction(json){
    let p = json.parse_json()
    let i = index_of(mod.state.messages, p.event_id)
    if i < 0 { return nil }
    let rx = mod.state.messages[i].reactions
    let found = false
    let j = 0
    while j < rx.len() {
        if rx[j].key == p.key {
            let delta = -1
            if p.added { delta = 1 }
            rx[j].count += delta
            if p.is_own { rx[j].mine = p.added }
            found = true
        }
        j += 1
    }
    if !found && p.added { rx.push({key: p.key count: 1 mine: p.is_own}) }
    rx.retain(|x| x.count > 0)
    render_list()
}

fn on_room_message_changed(json){
    let p = json.parse_json()
    let i = index_of(mod.state.messages, p.event_id)
    if i < 0 { return nil }
    let body = p.body
    if p.redacted {
        body = "(deleted)"
        mod.state.messages[i].redacted = true
    }
    mod.state.messages[i].body = body
    render_list()
}

fn on_room_members_changed(json){
    schedule_room_refresh()
}

fn schedule_room_refresh(){
    if room_refresh_pending || !host.has("matrix.room.info.read") { return nil }
    room_refresh_pending = start_timeout(1.0, || {
        room_refresh_pending = false
        if !host.has("matrix.room.info.read") { return nil }
        if room_loading { schedule_room_refresh() } else { load_room() }
    }) != nil
}

fn subscribe(name){
    for event in subscribed_events { if event == name { return nil } }
    for event in pending_events { if event == name { return nil } }
    pending_events.push(name)
    host.request("events.subscribe", {event: name}, fn(r){
        pending_events.retain(|event| event != name)
        if r.is_ok {
            subscribed_events.push(name)
            if subscribed_events.len() == 5 {
                mod.state.live_note = ""
                show_room()
            }
        }
        if r.is_ok || mod.state.live_note != "" { return nil }
        mod.state.live_note = "Live updates off"
        show_room()
    })
}

fn watch_granted(){
    subscribed_events.retain(|event| host.has(event))
    if host.has("on_room_message") { subscribe("on_room_message") }
    if host.has("on_room_members_changed") { subscribe("on_room_members_changed") }
    if host.has("on_room_typing") { subscribe("on_room_typing") }
    if host.has("on_room_reaction") { subscribe("on_room_reaction") }
    if host.has("on_room_message_changed") { subscribe("on_room_message_changed") }
}

fn watch(){
    mod.state.live_note = ""
    show_room()
    subscribe("on_room_message")
    subscribe("on_room_members_changed")
    subscribe("on_room_typing")
    subscribe("on_room_reaction")
    subscribe("on_room_message_changed")
}

fn toggle_how(){
    mod.state.how_open = !mod.state.how_open
    ui.how_wrap.set_visible(mod.state.how_open)
    ui.how_btn.set_text(if mod.state.how_open {"How it works ▲"} else {"How it works ▼"})
}

// Narrow panes move Refresh under the title; very narrow ones shorten labels and drop avatars.
fn on_app_resize(w, h){
    let tiny = w < 300
    if tiny != mod.state.is_tiny {
        mod.state.is_tiny = tiny
        show_frame()
    }
    let compact = w < 280
    if compact != mod.state.is_compact {
        mod.state.is_compact = compact
        ui.draft_btn.set_text(if compact {"Draft"} else {"Draft message"})
        ui.attach_btn.set_text(if compact {"Attach"} else {"Attach file"})
        ui.send_btn.set_text(if compact {"Send"} else {"Send now"})
        ui.send_file_btn.set_text(if compact {"Send file"} else {"Send file now"})
    }
    let avatars = w >= 280
    if avatars == mod.state.show_avatars { return nil }
    mod.state.show_avatars = avatars
    if mod.state.rows.len() > 0 { render_list() }
    return nil
}

// Relative times ("5m ago") are refreshed once a minute while the pane is visible.
fn on_focus_changed(json){
    mod.state.is_foreground = json.parse_json()["foreground"] != false
    return nil
}
fn refresh_times(){
    if !mod.state.is_foreground || mod.state.rows.len() == 0 { return nil }
    render_list()
    return nil
}
let _clock = start_interval(60.0, || refresh_times())

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.info.read") { room_loaded = false }
    elif !room_loaded { load_room() }
    if !host.has("matrix.room.messages.read") { messages_loaded = false }
    elif !messages_loaded { load_messages() }
    watch_granted()
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-info", "matrix-room-read", "matrix-room-watch"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok {
            note_no_room(r.error)
            mod.state.room_line = sentence(r.error)
            mod.state.room_line_is_error = true
            show_room()
            mod.state.list_state = "error"
            mod.state.list_error = sentence(r.error)
            render_list()
            return nil
        }
        if r.data.permissions["matrix-room-info"] == true && host.has("matrix.room.info.read") { load_room() }
        else {
            mod.state.room_line = "Room details are off."
            mod.state.room_line_is_error = false
            show_room()
        }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.messages.read") { load_messages() }
        else {
            mod.state.messages = []
            mod.state.list_state = "denied"
            render_list()
        }
        if r.data.permissions["matrix-room-watch"] == true { watch_granted() }
    })
}

// A theme switch's re-run drops the reply a compose request awaited; say what became of it.
fn resume_compose(){
    let cut = mod.state.in_flight
    mod.state.in_flight = ""
    if cut == "pick" { set_note("info", "Interrupted by the theme change. Try again.") }
    elif cut == "draft" { set_note("info", "Handed your draft to Robrix. Check the message box before drafting again.") }
    elif cut == "attach" { set_note("info", "Handed your file to Robrix. Check the message box before attaching again.") }
    elif cut == "send" { set_note("info", "Handed your message to Robrix to send. Check the room before sending again.") }
    elif cut == "file" { set_note("info", "Handed your file to Robrix to send. Check the room before sending again.") }
    return nil
}

let _boot = start_timeout(0.05, || {
    resume_compose()
    setup(false)
})

