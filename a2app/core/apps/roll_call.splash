// name: Roll Call
// icon: 🎲
// tint: #7C6CF0
// description: Rolls dice, prepares a draft, or posts the result to the room.
// permissions: robrix-composer, matrix-room-send, host.composer.insert, matrix.room.message.send
// why-robrix-composer: Puts your roll in the message box for you to review and send.
// why-matrix-room-send: Posts your roll into this room only when you press Post to room.

let die_a = 1
let die_b = 1
let posting = false
let drafting = false

fn result_text(){ return "🎲 Rolled " + die_a + " + " + die_b + " = " + (die_a + die_b) }

fn roll(){
    let t = floor(time_now() * 997.0)
    die_a = t % 6 + 1
    let u = floor(time_now() * 7919.0)
    die_b = u % 6 + 1
    ui.dice.set_text("" + die_a + "  ●  " + die_b)
    let total = die_a + die_b
    ui.total.set_text("total " + total)
    ui.note.set_text("")
}

fn post(){
    if posting || drafting { return nil }
    let msg = result_text()
    posting = true
    ui.note.set_text("Posting…")
    host.request("matrix.send_message", {body: msg}, fn(r){
        posting = false
        if r.is_ok {
            ui.note.set_text("Posted to the room!")
            return nil
        }
        ui.note.set_text(r.error)
    })
}

fn draft_result(){
    if posting || drafting { return nil }
    drafting = true
    ui.note.set_text("Preparing a draft…")
    host.request("composer.insert", {text: result_text()}, fn(r){
        drafting = false
        if r.is_ok { ui.note.set_text("Draft ready. Review and send it in Robrix.") }
        else { ui.note.set_text(r.error) }
    })
}

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        RoundedView{
            width: Fill height: Fit align: Align{x: 0.5, y: 0.5} padding: 16 flow: Down spacing: 6
            show_bg: true
            draw_bg +: { color: #xF0F5FF border_radius: 12.0 }
            dice := Label{
                text: "1  ●  1" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: #x1C274C text_style: theme.font_bold{font_size: 44} }
            }
            total := Label{
                text: "total 2" padding: 0 margin: 0
                draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 14} }
            }
        }
        View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 10 align: Align{x: 0.5}
            Button{
                text: "Roll" on_click: || roll()
                draw_text +: { color: #x1C274C }
            }
            Button{
                text: "Draft result" on_click: || draft_result()
                draw_text +: { color: #x1C274C }
            }
            Button{
                text: "Post to room" on_click: || post()
                draw_text +: { color: #x1C274C }
            }
        }
        Label{
            text: "Draft result prepares text for review. Post to room sends it immediately and needs separate permission."
            width: Fill padding: 0 margin: 0
            draw_text +: { color: #x66708F text_style: theme.font_regular{font_size: 11} }
        }
        note := Label{
            text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
    }
}
