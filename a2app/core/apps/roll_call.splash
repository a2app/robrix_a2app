// name: Roll Call
// icon: 🎲
// tint: #7C6CF0
// description: Rolls dice, prepares a draft, or posts the result to the room.
// permissions: robrix-composer, matrix-room-send, host.composer.insert, matrix.room.message.send
// why-robrix-composer: Puts your roll in the message box for you to review and send.
// why-matrix-room-send: Posts your roll into this room only when you press Post to room.

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}

// The roll and the dice size survive the re-run a theme switch does, which no resize follows.
// So does `in_flight` ("post", "draft" or ""), the request whose reply that re-run drops.
mod.state = {die_a: 1 die_b: 1 faces: [] die_size: 80 side_pad: 28 in_flight: ""}

// Pip cells (0-8, row by row) for faces 1-6.
let pip_sets = [[4], [2, 6], [2, 4, 6], [0, 2, 6, 8], [0, 2, 4, 6, 8], [0, 2, 3, 5, 6, 8]]

fn result_text(){
    let a = mod.state.die_a
    let b = mod.state.die_b
    return "🎲 Rolled " + a + " + " + b + " = " + (a + b)
}

// A face as three rows of three cells, true where a pip sits.
fn face_rows(n){
    let on = pip_sets[n - 1]
    let rows = []
    for r in [0, 1, 2] {
        let row = []
        for c in [0, 1, 2] {
            let hit = false
            for p in on { if p == r * 3 + c { hit = true } }
            row.push(hit)
        }
        rows.push(row)
    }
    return rows
}

fn show_dice(){
    let a = mod.state.die_a
    let b = mod.state.die_b
    mod.state.faces = [face_rows(a), face_rows(b)]
    ui.faces.render()
    ui.total.set_text("" + (a + b))
    ui.dice.set_text("" + a + " + " + b)
}

let lower_az = "abcdefghijklmnopqrstuvwxyz"
let upper_az = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// Host errors can start in lowercase; show them as sentences, and say how to get a room.
fn failure_text(error){
    if error.search("not attached") >= 0 { return "Open Roll Call from a room to draft or post your roll." }
    let chars = error.split("")
    if chars.len() < 3 { return error }
    let out = error
    let i = lower_az.search(chars[1])
    if chars[1].len() == 1 && i >= 0 { out = upper_az.split("")[i + 1] + error.strip_prefix(chars[1]) }
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

fn note_kind(error){ return if error.search("not attached") >= 0 {"info"} else {"err"} }

fn set_note(kind, text){
    ui.note.set_text(text)
    ui.note_ok.set_text(text)
    ui.note_err.set_text(text)
    ui.note_wrap.set_visible(kind == "info" && text != "")
    ui.note_ok_wrap.set_visible(kind == "ok")
    ui.note_err_wrap.set_visible(kind == "err")
}

// random() is a 64-bit generator; time-based floor() math runs in 32-bit floats.
fn roll(){
    mod.state.die_a = min(floor(random() * 6) + 1, 6)
    mod.state.die_b = min(floor(random() * 6) + 1, 6)
    show_dice()
    set_note("info", "")
}

fn post(){
    if mod.state.in_flight != "" { return nil }
    let msg = result_text()
    mod.state.in_flight = "post"
    set_note("info", "Posting…")
    host.request("matrix.send_message", {body: msg}, fn(r){
        mod.state.in_flight = ""
        if r.is_ok {
            set_note("ok", "Posted to the room!")
            return nil
        }
        set_note(note_kind(r.error), failure_text(r.error))
    })
}

fn draft_result(){
    if mod.state.in_flight != "" { return nil }
    mod.state.in_flight = "draft"
    set_note("info", "Preparing a draft…")
    host.request("composer.insert", {text: result_text()}, fn(r){
        mod.state.in_flight = ""
        if r.is_ok {
            set_note("ok", "Draft ready. Review and send it in Robrix.")
            return nil
        }
        set_note(note_kind(r.error), failure_text(r.error))
    })
}

// Dice shrink to fit the pane (w includes the host's 8pt padding); wider panes pad the tray.
fn on_app_resize(w, h){
    let size = 80
    if w < 240 || h < 380 { size = 60 }
    elif w >= 560 && h >= 520 { size = 104 }
    size = max(min(size, floor((w - 92) / 2)), 36)
    let pad = 0
    if w >= 300 { pad = floor(size * 0.35) }
    if size == mod.state.die_size && pad == mod.state.side_pad { return nil }
    mod.state.die_size = size
    mod.state.side_pad = pad
    ui.faces.render()
    return nil
}

// A theme switch's re-run drops the reply an in-flight request awaited; Robrix still finishes it.
fn resume(){
    let cut = mod.state.in_flight
    mod.state.in_flight = ""
    if cut == "post" { set_note("info", "Handed your roll to Robrix to post. Check the room before posting again.") }
    elif cut == "draft" { set_note("info", "Handed your roll to Robrix. Check the message box before drafting again.") }
    return nil
}

let _boot = start_timeout(0.05, || {
    show_dice()
    resume()
})

View{
    width: Fill height: Fill flow: Down
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 14 padding: 14 align: Align{x: 0.5 y: 0.4}
        RoundedView{
            width: Fit height: Fit flow: Down spacing: 14 align: Align{x: 0.5}
            padding: Inset{top: 22 bottom: 18 left: 16 right: 16}
            show_bg: true
            draw_bg +: { color: theme.palette.card border_radius: 8.0 }
            faces := View{
                width: Fit height: Fit flow: Right
                on_render: || {
                    let die_size = mod.state.die_size
                    let side_pad = mod.state.side_pad
                    View{ width: side_pad height: 1 }
                    let k = 0
                    for f in mod.state.faces {
                        if k > 0 { View{ width: 16 height: 1 } }
                        k += 1
                        RoundedView{
                            width: die_size height: die_size flow: Down padding: floor(die_size * 0.13)
                            show_bg: true
                            draw_bg +: { color: theme.palette.surface border_radius: floor(die_size * 0.14) border_size: 1.0 border_color: theme.palette.border }
                            for row in f {
                                View{
                                    width: Fill height: Fill flow: Right
                                    for on in row {
                                        // Every cell keeps its pip: a re-render can't clear an emptied View.
                                        View{
                                            width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                                            RoundedView{
                                                width: floor(die_size * 0.15) height: floor(die_size * 0.15) visible: on show_bg: true
                                                draw_bg +: { color: theme.palette.title border_radius: floor(die_size * 0.075) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    View{ width: side_pad height: 1 }
                }
            }
            View{
                width: Fit height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                total := Label{
                    text: "2" padding: 0 margin: 0
                    draw_text +: { color: theme.palette.accent_text text_style: theme.font_bold{font_size: 26} }
                }
                dice := Label{
                    text: "1 + 1" padding: 0 margin: 0
                    draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8 align: Align{x: 0.5}
            PrimaryButton{ text: "Roll" on_click: || roll() }
            NeutralButton{ text: "Draft result" on_click: || draft_result() }
            NeutralButton{ text: "Post to room" on_click: || post() }
        }
        note_wrap := View{
            width: Fill height: Fit align: Align{x: 0.5} visible: false
            note := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
            }
        }
        note_ok_wrap := View{
            width: Fill height: Fit align: Align{x: 0.5} visible: false
            note_ok := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.success text_style: theme.font_regular{font_size: 10} }
            }
        }
        note_err_wrap := View{
            width: Fill height: Fit align: Align{x: 0.5} visible: false
            note_err := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} }
            }
        }
        Label{
            text: "Draft lets you review first. Post sends now." width: Fill align: Align{x: 0.5} padding: 0 margin: 0
            draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
        }
    }
}
