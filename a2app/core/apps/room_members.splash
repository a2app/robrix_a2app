// name: Room Members
// icon: 👥
// tint: #6C8E3A
// description: Who is in this room, with their power levels.
// permissions: matrix-room-read, robrix-navigation, matrix-room-watch
// why-matrix-room-read: Lists who is in this room.
// why-robrix-navigation: Opens the profile of a member you tap.
// why-matrix-room-watch: Refreshes the list as people join or leave.

let watch_pending = false
let watch_ready = false

let members_loading = false
let members_loaded = false
let live_refresh_pending = false

let items = []
let status = "Loading…"
let live_note = ""
let empty_msg = "Loading members…"

fn show_header(){ ui.header.set_text(status + live_note) }

fn load(){
    if members_loading { return nil }
    members_loading = true
    host.request("matrix.room_members", {limit: 60}, fn(r){
        members_loading = false
        members_loaded = r.is_ok
        if r.is_ok {
            items = r.data.members
            empty_msg = "No members to show."
            status = "" + r.data.count + " members · tap one for their profile"
            if r.data.count > items.len() {
                status = "Showing " + items.len() + " of " + r.data.count + " members · tap one for their profile"
            }
        } else {
            items = []
            status = r.error
            empty_msg = r.error
        }
        show_header()
        ui.item_list.render()
    })
}

fn on_room_members_changed(json){
    schedule_live_refresh()
}

fn schedule_live_refresh(){
    if live_refresh_pending { return nil }
    live_refresh_pending = start_timeout(1.0, || {
        live_refresh_pending = false
        if members_loading { schedule_live_refresh() } else { load() }
    }) != nil
}

fn watch(){
    if watch_pending || watch_ready { return nil }
    watch_pending = true
    host.request("events.subscribe", {event: "on_room_members_changed"}, fn(r){
        watch_pending = false
        watch_ready = r.is_ok
        if r.is_ok { live_note = "" } else { live_note = " · live updates off: " + r.error }
        show_header()
    })
}

fn on_permissions_changed(caps){
    if !members_loaded { load() }
    if host.has("on_room_members_changed") { watch() } else { watch_ready = false }
}

fn open_member(i){
    if i >= items.len() { return nil }
    host.request("nav.user", {user_id: items[i].user_id}, fn(r){
        if !r.is_ok { ui.header.set_text(r.error) }
    })
}

fn member_line(m){
    let line = m.name
    if m.power > 0 { line = m.name + "  ·  power " + m.power }
    return line
}

let _boot = start_timeout(0.05, || {
    load()
    watch()
})

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        header := Label{
            text: "Loading…" padding: 0 margin: 0
            width: Fill
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
        item_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down spacing: 5
            on_item_tap: |i| open_member(i)
            on_render: || {
                if items.len() == 0 {
                    Label{
                        text: empty_msg
                        width: Fill padding: 0 margin: 0
                        draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                    }
                } else {
                    for it in items {
                        RoundedView{
                            width: Fill height: Fit flow: Down spacing: 2 padding: 10
                            show_bg: true
                            draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                            Label{
                                text: it.user_id padding: 0 margin: 0
                                width: Fill
                                draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                            }
                            Label{
                                text: member_line(it) width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                            }
                        }
                    }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Right align: Align{x: 0.5}
            Button{
                text: "Refresh" on_click: || { status = "Loading…" show_header() load() }
                draw_text +: { color: #x1C274C }
            }
        }
    }
}
