                    sum_a := Label{ text: "" padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 13} } }
                    sum_b := Label{ text: "" padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 13} } }
                }
                note_wrap := View{
                    width: Fill height: Fit visible: false
