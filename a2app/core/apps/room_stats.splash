                    }
                    View{
                        width: Fill height: Fit flow: Right
                        Label{ text: "00:00" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 9} } }
                        Label{ text: "06:00" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 9} } }
                        Label{ text: "12:00" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 9} } }
                        Label{ text: "18:00" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 9} } }
                    }
