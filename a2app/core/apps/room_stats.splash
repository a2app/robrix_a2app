            }
            View{
                width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                d100_off := View{ width: Fit height: Fit ChipOff{ text: "100" on_click: || set_depth(100) } }
                d100_on := View{ width: Fit height: Fit visible: false ChipOn{ text: "100" on_click: || set_depth(100) } }
                d300_off := View{ width: Fit height: Fit visible: false ChipOff{ text: "300" on_click: || set_depth(300) } }
                d300_on := View{ width: Fit height: Fit ChipOn{ text: "300" on_click: || set_depth(300) } }
                d1000_off := View{ width: Fit height: Fit ChipOff{ text: "1,000" on_click: || set_depth(1000) } }
                d1000_on := View{ width: Fit height: Fit visible: false ChipOn{ text: "1,000" on_click: || set_depth(1000) } }
                // Very narrow panes move Refresh here, out of the summary's way.
                tiny_refresh := View{
                    width: Fit height: Fit visible: false
                    NeutralButton{ text: "Refresh" on_click: || setup(true) }
                }
            }
        }
        loading_wrap := View{
            width: Fill height: Fit flow: Right spacing: 10 align: Align{x: 0.5 y: 0.5} padding: Inset{top: 24 bottom: 24}
            LoadingSpinner{ width: 18 height: 18 draw_bg +: { color: theme.palette.accent_text } }
            loading_line := Label{ text: "Counting the last 300 messages…" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
        }
        empty_wrap := View{
            width: Fill height: Fit visible: false
            RoundedView{
                width: Fill height: Fit flow: Down spacing: 6 align: Align{x: 0.5}
                padding: Inset{left: 16 right: 16 top: 20 bottom: 20}
                show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
                empty_icon := Label{ text: "📭" padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 28} } }
                empty_title := Label{ text: "No messages yet" width: Fill align: Align{x: 0.5} padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 12.5} } }
                empty_body := Label{ text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
                empty_btn_wrap := View{
                    width: Fit height: Fit visible: false margin: Inset{top: 6}
