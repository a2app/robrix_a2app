// name: Room Stats
// icon: 📊
// tint: #2A9D8F
// description: Who posts here, when, and what you may do in this room.
// permissions: matrix-room-read, matrix-room-info, robrix-navigation, device-info, matrix.room.messages.read, matrix.room.messages.paginate, matrix.room.power_levels.read, host.nav.user, device.info.read
// why-matrix-room-read: Reads this room's messages to count who posts and when.
// why-matrix-room-info: Shows your power level and what it lets you do here.
// why-robrix-navigation: Opens the profile of a sender you tap.
// why-device-info: Counts busy hours and weekdays in your own time zone.

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}
// Chips: both variants are declared and the matching one is shown.
let ChipOff = Button{
    padding: Inset{left: 10 right: 10 top: 5 bottom: 5}
    draw_bg +: {
        border_size: 1.0 border_radius: 12.0
        color: theme.palette.surface color_hover: theme.palette.card color_down: theme.palette.pressed color_focus: theme.palette.surface
        border_color: theme.palette.border border_color_hover: theme.palette.accent border_color_down: theme.palette.accent border_color_focus: theme.palette.border
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title text_style: theme.font_regular{font_size: 10} }
}
let ChipOn = ChipOff{
    draw_bg +: {
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        border_color: theme.palette.accent border_color_hover: theme.palette.accent_hover border_color_down: theme.palette.accent_down border_color_focus: theme.palette.accent
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent }
}

// What survives the re-run a theme switch does: the chosen depth, the pane's size class
// and the counted messages, so a finished count (`is_counted`) is redrawn, not fetched again.
mod.state = {
    depth: 300 is_narrow: false is_tiny: false is_counted: false
    // Keep the newest batch apart so it supplies the first history-page anchor.
    latest: [] older: []
    // Minutes from UTC once device.info answers; until then hours count in UTC.
    utc_offset: nil
}
let loading = false
let power_loading = false
let power_loaded = false
let setup_pending = false
let load_error = ""
let is_denied = false
let is_no_room = false
let status_kind = ""
let senders = []
let top = []
let sender_rows = []
let hour_items = []
let day_items = []
let hour_sel = 0
let day_sel = 0
let first_ts = 0
let last_ts = 0
let timed_count = 0
let device_pending = false
let day_names = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
let day_full = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
let month_names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

let upper = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M" n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}

// "room not joined" -> "Room not joined."
fn sentence(text){
    let t = "" + text
    let chars = t.split("")
    if chars.len() < 3 { return t }
    let first = chars[1]
    let up = upper[first]
    if up == nil { up = first }
    let out = up + t.strip_prefix(first)
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

// The avatar letter: the name's first character, skipping a leading "@".
fn initial(name){
    let chars = ("" + name).split("")
    if chars.len() < 3 { return "?" }
    let c = chars[1]
    if c == "@" && chars.len() > 3 { c = chars[2] }
    let up = upper[c]
    if up != nil { c = up }
    return c
}

fn zeros(n){
    let out = []
    let i = 0
    while i < n {
        out.push(0)
        i += 1
    }
    return out
}

let hours = zeros(24)
let days = zeros(7)

fn total(){ return mod.state.latest.len() + mod.state.older.len() }

fn plural(n, word){
    if "" + n == "1" { return word }
    return word + "s"
}

// 1,000 rather than 1000, as the other apps write counts.
fn grouped(n){
    if n < 1000 { return "" + n }
    let k = floor(n / 1000)
    let r = n - k * 1000
    let pad = ""
    if r < 100 { pad = "0" }
    if r < 10 { pad = "00" }
    return grouped(k) + "," + pad + r
}

fn msgs(n){ return grouped(n) + " " + plural(n, "message") }

fn pad(n){
    if n < 10 { return "0" + n }
    return "" + n
}

// Exact integer math: floor() works in 32-bit floats and misplaces times near a boundary.
fn day_of(ts){ return (ts - ts % 86400000) / 86400000 }
fn hour_of(ts){ return (ts % 86400000 - ts % 3600000) / 3600000 }
fn local_ts(ts){
    if mod.state.utc_offset == nil { return ts }
    return ts + mod.state.utc_offset * 60000
}

// Civil UTC date from days since 1970 (Howard Hinnant's algorithm).
fn civil(ts){
    let z = day_of(ts) + 719468
    let era = floor(z / 146097)
    let doe = z - era * 146097
    let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)
    let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))
    let mp = floor((5 * doy + 2) / 153)
    let d = doy - floor((153 * mp + 2) / 5) + 1
    let m = mp + 3
    if mp >= 10 { m = mp - 9 }
    let y = yoe + era * 400
    if m <= 2 { y += 1 }
    return {y: y m: m d: d}
}

fn date_text(ts, this_year){
    let c = civil(ts)
    let text = month_names[c.m - 1] + " " + c.d
    if c.y != this_year { text = text + ", " + c.y }
    return text
}

fn range_text(){
    if timed_count == 0 { return "Message times unknown" }
    let this_year = civil(local_ts(time_now() * 1000)).y
    let a = date_text(local_ts(first_ts), this_year)
    let b = date_text(local_ts(last_ts), this_year)
    let text = a
    if a != b { text = a + " – " + b }
    if mod.state.utc_offset == nil { text = text + " · times in UTC" }
    if timed_count < total() { text = text + " · " + grouped(timed_count) + " of " + grouped(total()) + " dated" }
    return text
}

fn peak(arr){
    let best = 0
    let i = 1
    while i < arr.len() {
        if arr[i] > arr[best] { best = i }
        i += 1
    }
    return best
}

// Keeps senders ordered by count, busiest first.
fn bump(i){
    while i > 0 && senders[i].count > senders[i - 1].count {
        let tmp = senders[i - 1]
        senders[i - 1] = senders[i]
        senders[i] = tmp
        i -= 1
    }
}

// Robrix sends the room display name; older hosts and fixtures may not ([] reads it as nil).
fn has_name(m){
    let n = m["sender_name"]
    return n.is_string() && n != ""
}

fn count_sender(m){
    let i = 0
    while i < senders.len() {
        if senders[i].user_id == m.sender_id {
            senders[i].count += 1
            if !senders[i].named && has_name(m) {
                senders[i].name = m["sender_name"]
                senders[i].named = true
            }
            bump(i)
            return nil
        }
        i += 1
    }
    let name = "" + m.sender
    if has_name(m) { name = m["sender_name"] }
    senders.push({name: name, user_id: m.sender_id, count: 1, named: has_name(m)})
    bump(senders.len() - 1)
}

// One status line: note (gray) or err (red); "" hides it.
fn say(kind, text){
    status_kind = kind
    ui.status.set_text(text)
    ui.status_err.set_text(text)
    ui.note_wrap.set_visible(kind == "note")
    ui.err_wrap.set_visible(kind == "err")
    show_head()
    return nil
}

// The header waits for a summary or a status, so Refresh never sits alone.
fn show_head(){
    ui.head.set_visible(!is_no_room && (total() > 0 || status_kind != ""))
    return nil
}

fn build_senders(){
    sender_rows = []
    if top.len() == 0 { return nil }
    let most = top[0].count
    for s in top {
        let share = floor(100 * s.count / total())
        let pct = "" + share + "%"
        if share < 1 { pct = "<1%" }
        let stat = msgs(s.count) + " · " + pct
        if mod.state.is_narrow { stat = "" + s.count + " · " + pct }
        sender_rows.push({name: "" + s.name initial: initial(s.name) stat: stat on: s.count off: most - s.count})
    }
    return nil
}

fn build_bars(){
    hour_items = []
    let most = max(1, hours[peak(hours)])
    let i = 0
    while i < 24 {
        let px = 2
        let c = if theme.palette.is_dark {#x33373F} else {#xE3E8F0}
        if hours[i] > 0 {
            px = max(4, floor(44 * hours[i] / most))
            c = if theme.palette.is_dark {#x1D5590} else {#x9FCBFF}
        }
        if i == hour_sel && hours[i] > 0 { c = theme.palette.accent }
        hour_items.push({px: px c: c})
        i += 1
    }
    day_items = []
    let most_day = max(1, days[peak(days)])
    let j = 0
    while j < 7 {
        let px = 2
        let c = if theme.palette.is_dark {#x33373F} else {#xE3E8F0}
        if days[j] > 0 {
            px = max(4, floor(44 * days[j] / most_day))
            c = if theme.palette.is_dark {#x1D5590} else {#x9FCBFF}
        }
        if j == day_sel && days[j] > 0 { c = theme.palette.accent }
        day_items.push({name: day_names[j] px: px c: c})
        j += 1
    }
    return nil
}

fn show_callouts(){
    ui.hour_big.set_text(pad(hour_sel) + ":00")
    let hour_note = msgs(hours[hour_sel])
    if hour_sel == peak(hours) { hour_note = "busiest hour · " + hour_note }
    ui.hour_note.set_text(hour_note)
    ui.day_big.set_text(day_full[day_sel])
    let day_note = msgs(days[day_sel])
    if day_sel == peak(days) { day_note = "busiest day · " + day_note }
    ui.day_note.set_text(day_note)
    return nil
}

fn show_state(){
    let has_data = top.len() > 0
    let is_loading = loading && !has_data && !is_no_room
    show_head()
    ui.depth_row.set_visible(has_data && !is_no_room)
    ui.stats_wrap.set_visible(has_data && !is_no_room)
    ui.times_wrap.set_visible(timed_count > 0)
    ui.loading_wrap.set_visible(is_loading)
    ui.empty_wrap.set_visible((!has_data || is_no_room) && !is_loading)
    ui.power_wrap.set_visible(!is_no_room)
    // Tiny panes move Refresh below the summary; without data it stays up top.
    ui.head_refresh.set_visible(!mod.state.is_tiny || !has_data)
    ui.tiny_refresh.set_visible(mod.state.is_tiny && has_data)
    let icon = "📭"
    let title = "No messages yet"
    let body = "Once people post here, you'll see who posts and when."
    let action = "Refresh"
    if is_no_room {
        icon = "🧭"
        title = "No room attached"
        body = "Open Room Stats from a room to see its stats."
        action = ""
    } elif is_denied {
        icon = "🔒"
        title = "Can't read this room"
        body = "Allow Room Stats to count this room's messages."
        action = "Ask again"
    } elif load_error != "" {
        icon = "😕"
        title = "Couldn't load messages"
        body = sentence(load_error)
        action = "Try again"
    }
    ui.empty_icon.set_text(icon)
    ui.empty_title.set_text(title)
    ui.empty_body.set_text(body)
    ui.empty_btn.set_text(action)
    ui.empty_btn_wrap.set_visible(action == "Try again" || action == "Refresh")
    ui.ask_btn_wrap.set_visible(action == "Ask again")
    return nil
}

fn show(){
    let n = total()
    ui.sum_a.set_text(msgs(n) + " · ")
    ui.sum_b.set_text("" + senders.len() + " " + plural(senders.len(), "sender"))
    ui.summary_wrap.set_visible(n > 0)
    if n > 0 && load_error != "" {
        say("err", "Stopped early: " + sentence(load_error))
    } elif n > 0 {
        say("note", range_text())
    } else {
        say("", "")
    }
    ui.hour_caption.set_text(if mod.state.utc_offset == nil { "BY HOUR · UTC" } else { "BY HOUR" })
    hour_sel = peak(hours)
    day_sel = peak(days)
    build_senders()
    build_bars()
    show_callouts()
    show_state()
    ui.sender_list.render()
    ui.hour_bars.render()
    ui.day_bars.render()
    return nil
}

fn count_message(m){
    count_sender(m)
    // [] reads a missing ts as nil instead of failing.
    let ts = m["ts"]
    if !ts.is_number() || ts <= 0 { return nil }
    timed_count += 1
    let lt = local_ts(ts)
    hours[hour_of(lt)] += 1
    days[(day_of(lt) + 4) % 7] += 1
    if first_ts == 0 || ts < first_ts { first_ts = ts }
    if ts > last_ts { last_ts = ts }
}

fn compute(){
    senders = []
    hours = zeros(24)
    days = zeros(7)
    first_ts = 0
    last_ts = 0
    timed_count = 0
    for m in mod.state.latest { count_message(m) }
    for m in mod.state.older { count_message(m) }
    let n = min(8, senders.len())
    top = []
    let i = 0
    while i < n {
        top.push(senders[i])
        i += 1
    }
    show()
}

fn finish(){
    loading = false
    mod.state.is_counted = load_error == ""
    compute()
}

fn loaded_text(){
    if total() == 0 { return "Counting the last " + grouped(mod.state.depth) + " messages…" }
    return "Counted " + grouped(total()) + " of " + grouped(mod.state.depth) + "…"
}

fn progress(){
    if top.len() > 0 { say("note", "Counting… " + grouped(total()) + " of " + grouped(mod.state.depth)) }
    ui.loading_line.set_text(loaded_text())
    return nil
}

fn page(){
    if total() >= mod.state.depth {
        finish()
        return nil
    }
    progress()
    let before = nil
    if mod.state.latest.len() > 0 { before = mod.state.latest[0].event_id }
    if mod.state.older.len() > 0 { before = mod.state.older[0].event_id }
    host.request("matrix.older_messages", {before: before, limit: min(50, mod.state.depth - total())}, fn(r){
        if !r.is_ok {
            load_error = r.error
            if ("" + r.error).search("not attached to a room") >= 0 { is_no_room = true }
            finish()
            return nil
        }
        let got = r.data.messages
        let merged = []
        for m in got { merged.push(m) }
        for m in mod.state.older { merged.push(m) }
        mod.state.older = merged
        if r.data.has_more && got.len() > 0 {
            // Each page costs 5 tokens; allow the 6-per-second budget to refill.
            if start_timeout(1.0, || page()).is_nil() {
                load_error = "Couldn't continue loading. Tap Refresh to try again."
                finish()
            }
            return nil
        }
        finish()
    })
}

fn load(){
    if loading {
        say("note", "Still counting, hang on…")
        return nil
    }
    loading = true
    load_error = ""
    is_denied = false
    mod.state.is_counted = false
    mod.state.latest = []
    mod.state.older = []
    if top.len() > 0 { say("note", "Counting…") }
    ui.loading_line.set_text(loaded_text())
    show_state()
    host.request("matrix.read_messages", {limit: 30}, fn(r){
        if r.is_ok {
            mod.state.latest = r.data.messages
            page()
            return nil
        }
        load_error = r.error
        if ("" + r.error).search("not attached to a room") >= 0 { is_no_room = true }
        finish()
    })
}

fn join_words(list, last_word){
    let text = ""
    let i = 0
    while i < list.len() {
        if i > 0 && i == list.len() - 1 { text = text + " " + last_word + " " }
        elif i > 0 { text = text + ", " }
        text = text + list[i]
        i += 1
    }
    return text
}

fn role_of(level){
    if level >= 100 { return "Admin" }
    if level >= 50 { return "Moderator" }
    if level <= 0 { return "Member" }
    return "Custom role"
}

// A gray note (loading, not allowed) or a red error in place of your role.
fn show_power_note(kind, text){
    ui.role_wrap.set_visible(false)
    ui.can_wrap.set_visible(false)
    ui.cant_wrap.set_visible(false)
    ui.power_note.set_text(text)
    ui.power_err.set_text(text)
    ui.power_note_wrap.set_visible(kind == "note")
    ui.power_err_wrap.set_visible(kind == "err")
    return nil
}

fn load_power(){
    if power_loading { return nil }
    power_loading = true
    host.request("matrix.power_levels", nil, fn(r){
        power_loading = false
        power_loaded = r.is_ok
        if !r.is_ok {
            if ("" + r.error).search("not attached to a room") >= 0 {
                is_no_room = true
                show_state()
            }
            if !is_no_room { show_power_note("err", "Couldn't read your role: " + sentence(r.error)) }
            return nil
        }
        let c = r.data.can
        let able = [[c["send_message"], "send messages"], [c["pin"], "pin messages"], [c["invite"], "invite people"],
            [c["kick"], "remove people"], [c["ban"], "ban people"], [c["redact_others"], "delete others' messages"],
            [c["notify_room"], "notify everyone"], [c["change_settings"], "change settings"]]
        let yes = []
        let no = []
        for a in able {
            if a[0] == true { yes.push(a[1]) } else { no.push(a[1]) }
        }
        ui.role_line.set_text(role_of(r.data.mine) + " · power level " + r.data.mine)
        ui.role_wrap.set_visible(true)
        ui.can_wrap.set_visible(true)
        ui.power_note_wrap.set_visible(false)
        ui.power_err_wrap.set_visible(false)
        let can = "You can only read this room."
        if yes.len() > 0 { can = "You can " + join_words(yes, "and") + "." }
        ui.can_line.set_text(can)
        ui.cant_line.set_text("You can't " + join_words(no, "or") + ".")
        ui.cant_wrap.set_visible(yes.len() > 0 && no.len() > 0)
        return nil
    })
}

fn open_sender(i){
    if i >= top.len() { return nil }
    host.request("nav.user", {user_id: top[i].user_id}, fn(r){
        if !r.is_ok { say("err", "Couldn't open that profile: " + sentence(r.error)) }
        return nil
    })
}

fn show_hour(i){
    if i >= hours.len() { return nil }
    hour_sel = i
    build_bars()
    show_callouts()
    ui.hour_bars.render()
}

fn show_day(i){
    if i >= days.len() { return nil }
    day_sel = i
    build_bars()
    show_callouts()
    ui.day_bars.render()
}

fn show_depth(){
    ui.d100_on.set_visible(mod.state.depth == 100)
    ui.d100_off.set_visible(mod.state.depth != 100)
    ui.d300_on.set_visible(mod.state.depth == 300)
    ui.d300_off.set_visible(mod.state.depth != 300)
    ui.d1000_on.set_visible(mod.state.depth == 1000)
    ui.d1000_off.set_visible(mod.state.depth != 1000)
    return nil
}

fn set_depth(d){
    mod.state.depth = d
    show_depth()
    load()
}

fn on_app_resize(w, h){
    let narrow = w < 360
    let tiny = w < 260
    ui.sender_hint.set_visible(w >= 300)
    ui.hour_hint.set_visible(w >= 300)
    ui.depth_label.set_visible(w >= 260)
    if narrow != mod.state.is_narrow || tiny != mod.state.is_tiny {
        mod.state.is_narrow = narrow
        mod.state.is_tiny = tiny
        build_senders()
        ui.sender_list.render()
    }
    show_state()
    return nil
}

// Counts again in local time once the offset is known (or back in UTC when it's revoked).
fn recount(){
    if !loading && total() > 0 { compute() }
    return nil
}

fn read_device(){
    if device_pending || !host.has("device.info.read") { return nil }
    device_pending = true
    host.request("device.info", nil, fn(r){
        device_pending = false
        if !r.is_ok { return nil }
        let offset = r.data["utc_offset_minutes"]
        if offset.is_number() && offset > -1000 && offset < 1000 && offset != mod.state.utc_offset {
            mod.state.utc_offset = offset
            recount()
        }
        return nil
    })
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.messages.read") || !host.has("matrix.room.messages.paginate") { mod.state.is_counted = false }
    elif !mod.state.is_counted { load() }
    if !host.has("matrix.room.power_levels.read") { power_loaded = false }
    elif !power_loaded { load_power() }
    if !host.has("device.info.read") && mod.state.utc_offset != nil {
        mod.state.utc_offset = nil
        recount()
    } elif mod.state.utc_offset == nil { read_device() }
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-read", "matrix-room-info", "device-info"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { say("err", sentence(r.error)) return nil }
        if r.data.permissions["device-info"] == true { read_device() }
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.messages.read") && host.has("matrix.room.messages.paginate") {
            if retry || !mod.state.is_counted { load() }
        } else {
            mod.state.latest = []
            mod.state.older = []
            load_error = "Permission denied. Tap Refresh to ask again."
            is_denied = true
            finish()
        }
        if r.data.permissions["matrix-room-info"] == true && host.has("matrix.room.power_levels.read") { load_power() }
        else { show_power_note("note", "Allow room info to see your role here.") }
        return nil
    })
}

// After a theme switch, redraw a finished count in the new colors; setup then counts only if none finished.
let _boot = start_timeout(0.05, || {
    if mod.state.is_counted { compute() }
    setup(false)
})

View{
    width: Fill height: Fill flow: Down
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 14
        head := View{
            width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5} visible: false
