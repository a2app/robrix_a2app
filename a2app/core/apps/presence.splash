// name: Who's Here
// icon: 👀
// tint: #3A86FF
// description: Who is typing and how far each person has read.
// permissions: matrix-room-read, matrix-room-watch, robrix-navigation
// why-matrix-room-read: Shows how far each person has read.
// why-matrix-room-watch: Updates who is typing and reading as it happens.
// why-robrix-navigation: Opens a person you tap, or jumps to the message they read.

let subscribed_events = []
let pending_events = []

let receipts_loading = false
let receipts_loaded = false

let rows = []
let cells = []
let bodies = []
let pending = ""
let fetch_scheduled = false
let typing_line = "Nobody is typing"
let live_note = ""

fn show_typing(){
    let line = typing_line
    if live_note != "" { line = line + "\n" + live_note }
    ui.typing.set_text(line)
}

fn ago(ts){
    if ts.is_nil() { return "" }
    let s = time_now() - ts / 1000.0
    if s < 60.0 { return "just now" }
    if s < 3600.0 { return "" + floor(s / 60.0) + "m ago" }
    if s < 86400.0 { return "" + floor(s / 3600.0) + "h ago" }
    return "" + floor(s / 86400.0) + "d ago"
}

fn body_of(event_id){
    for b in bodies {
        if b.event_id == event_id { return b.body }
    }
    return nil
}

// Two list cells per person: their name, then the message they last read.
fn refresh(){
    cells = []
    for row in rows {
        let body = body_of(row.event_id)
        if body.is_nil() { body = "Tap to open this message" }
        let who = row.name
        let when = ago(row.ts)
        if when != "" { who = who + "  ·  " + when }
        cells.push({who: true, text: who, user_id: row.user_id})
        cells.push({who: false, text: body, event_id: row.event_id})
    }
    ui.receipt_list.render()
}

// Pace the top rows' message lookups so cached replies cannot exhaust the budget.
fn fetch_next(){
    if pending != "" || fetch_scheduled { return nil }
    let n = min(rows.len(), 10)
    let i = 0
    while i < n {
        let id = rows[i].event_id
        i += 1
        if body_of(id).is_nil() {
            pending = id
            host.request("matrix.event", {event_id: id}, fn(r){
                let text = "(couldn't load this message)"
                if r.is_ok { text = r.data.body }
                bodies.push({event_id: id, body: text, loaded: r.is_ok})
                while bodies.len() > 100 { bodies.remove(0) }
                pending = ""
                refresh()
                fetch_scheduled = start_timeout(1.0, || {
                    fetch_scheduled = false
                    fetch_next()
                }) != nil
            })
            return nil
        }
    }
}

fn load(){
    if receipts_loading { return nil }
    receipts_loading = true
    host.request("matrix.read_receipts", nil, fn(r){
        receipts_loading = false
        receipts_loaded = r.is_ok
        if r.is_ok {
            rows = r.data.receipts
            if rows.len() == 0 {
                ui.header.set_text("No read positions yet.")
            } else {
                ui.header.set_text("" + rows.len() + " read positions · tap a person, or the message they read")
            }
        } else {
            rows = []
            ui.header.set_text(r.error)
        }
        fetch_next()
        refresh()
    })
}

fn on_room_typing(json){
    let ev = json.parse_json()
    let names = ""
    for t in ev.typing {
        let name = t.name
        if name.is_nil() { name = t.user_id }
        let sep = ", "
        if names == "" { sep = "" }
        let next = names + sep + name
        names = next
    }
    let line = "Nobody is typing"
    if ev.typing.len() > 0 { line = names + " is typing…" }
    if ev.typing.len() > 1 { line = names + " are typing…" }
    typing_line = line
    show_typing()
}

fn on_room_receipt(json){
    let ev = json.parse_json()
    for rc in ev.receipts {
        let known = false
        let k = 0
        while k < rows.len() {
            if rows[k].user_id == rc.user_id {
                known = true
                rows[k].event_id = rc.event_id
                rows[k].ts = rc.ts
            }
            let next = k + 1
            k = next
        }
        if !known {
            let parts = rc.user_id.split(":")
            rows.push({user_id: rc.user_id, name: parts[0], event_id: rc.event_id, ts: rc.ts})
        }
    }
    fetch_next()
    refresh()
}

fn subscribe(name){
    for event in subscribed_events { if event == name { return nil } }
    for event in pending_events { if event == name { return nil } }
    pending_events.push(name)
    host.request("events.subscribe", {event: name}, fn(r){
        pending_events.retain(|event| event != name)
        if r.is_ok {
            subscribed_events.push(name)
            if subscribed_events.len() == 2 { live_note = "" }
        } else { live_note = "Live updates are off: " + r.error }
        show_typing()
    })
}

fn watch(){
    show_typing()
    subscribe("on_room_typing")
    subscribe("on_room_receipt")
}

fn on_permissions_changed(caps){
    if !receipts_loaded { load() }
    if host.has("matrix.room.event.read") {
        bodies.retain(|body| body.loaded)
        fetch_next()
    }
    subscribed_events.retain(|event| host.has(event))
    if host.has("on_room_typing") { subscribe("on_room_typing") }
    if host.has("on_room_receipt") { subscribe("on_room_receipt") }
}

fn reload(){
    bodies.retain(|body| body.loaded)
    load()
}

fn tap_cell(i){
    if i >= cells.len() { return nil }
    let c = cells[i]
    if c.who {
        host.request("nav.user", {user_id: c.user_id}, on_nav)
        return nil
    }
    host.request("nav.event", {event_id: c.event_id}, on_nav)
}

fn on_nav(r){ if !r.is_ok { ui.header.set_text(r.error) } }

let _boot = start_timeout(0.05, || {
    load()
    watch()
})

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        RoundedView{
            width: Fill height: Fit padding: 10
            show_bg: true draw_bg +: { color: #xF0F5FF border_radius: 12.0 }
            typing := Label{
                text: "Nobody is typing" width: Fill padding: 0 margin: 0
                draw_text +: { color: #x0f88fe text_style: theme.font_bold{font_size: 12} }
            }
        }
        header := Label{
            text: "Loading…" width: Fill padding: 0 margin: 0
            draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
        }
        receipt_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down spacing: 0
            on_item_tap: |i| tap_cell(i)
            on_render: || {
                for c in cells {
                    if c.who {
                        RoundedAllView{
                            width: Fill height: Fit padding: Inset{top: 8, bottom: 2, left: 10, right: 10}
                            margin: Inset{top: 6}
                            show_bg: true draw_bg +: { color: #xF0F5FF border_radius: vec4(8.0, 8.0, 0.0, 0.0) }
                            Label{
                                text: c.text width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x1C274C text_style: theme.font_bold{font_size: 12} }
                            }
                        }
                    } else {
                        RoundedAllView{
                            width: Fill height: Fit padding: Inset{top: 2, bottom: 8, left: 10, right: 10}
                            show_bg: true draw_bg +: { color: #xF0F5FF border_radius: vec4(0.0, 0.0, 8.0, 8.0) }
                            Label{
                                text: c.text width: Fill padding: 0 margin: 0
                                draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                            }
                        }
                    }
                }
            }
        }
        View{
            width: Fill height: Fit flow: Right align: Align{x: 0.5}
            Button{ text: "Refresh" on_click: || reload() draw_text +: { color: #x1C274C } }
        }
    }
}
