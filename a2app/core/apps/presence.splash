// name: Who's Here
// icon: 👀
// tint: #3A86FF
// description: Who is typing and how far each person has read.
// permissions: matrix-room-read, matrix-room-watch, robrix-navigation, matrix.room.receipts.read, matrix.room.event.read, on_room_typing, on_room_receipt, host.nav.user, host.nav.event
// why-matrix-room-read: Shows how far each person has read.
// why-matrix-room-watch: Updates who is typing and reading as it happens.
// why-robrix-navigation: Opens a person you tap, or jumps to the message they read.

let pending_events = []

let receipts_loading = false
let receipts_loaded = false

let pending = ""
let fetch_scheduled = false
let nav_error = ""
let nav_failed = ""
let setup_pending = false
// What the pane shows, which survives the re-run a theme switch does (the host keeps its
// subscriptions too). `screen` is loading | list | empty | denied | error | no_room.
mod.state = {
    rows: [] cells: [] bodies: [] typing_names: [] subscribed_events: []
    screen: "loading" error_text: "" live_note: "" is_narrow: false is_tiny: false
}

let upper = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M" n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}
let error_prefix = regex("^[Cc]ouldn't [^:]*: ")

// The avatar letter: the name's first character, skipping a leading "@".
fn initial(name){
    let chars = name.split("")
    if chars.len() < 3 { return "?" }
    let c = chars[1]
    if c == "@" && chars.len() > 3 { c = chars[2] }
    let up = upper[c]
    if up != nil { c = up }
    return c
}

// "couldn't load members: the server timed out" -> "The server timed out."
fn sentence(text){
    let t = text.replace(error_prefix, "")
    let chars = t.split("")
    if chars.len() < 3 { return t }
    let first = chars[1]
    let up = upper[first]
    if up == nil { up = first }
    let out = up + t.strip_prefix(first)
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

fn ago(ts){
    if ts == nil { return "" }
    let s = time_now() - ts / 1000.0
    if s < 60.0 { return "Just now" }
    if s < 3600.0 { return "" + floor(s / 60.0) + "m ago" }
    if s < 86400.0 { return "" + floor(s / 3600.0) + "h ago" }
    if s < 172800.0 { return "Yesterday" }
    if s < 604800.0 { return "" + floor(s / 86400.0) + "d ago" }
    if s < 2592000.0 { return "" + floor(s / 604800.0) + "w ago" }
    if s < 31536000.0 { return "" + floor(s / 2592000.0) + "mo ago" }
    return "" + floor(s / 31536000.0) + "y ago"
}

fn body_of(event_id){
    for b in mod.state.bodies {
        if b.event_id == event_id { return b }
    }
    return nil
}

fn is_watching(name){
    for event in mod.state.subscribed_events { if event == name { return true } }
    return false
}

fn typing_text(){
    let names = mod.state.typing_names
    let n = names.len()
    if n == 1 { return names[0] + " is typing…" }
    if n == 2 { return names[0] + " and " + names[1] + " are typing…" }
    if n == 3 { return names[0] + ", " + names[1] + " and " + names[2] + " are typing…" }
    return names[0] + ", " + names[1] + " and " + (n - 2) + " others are typing…"
}

fn show_typing(){
    let watching = is_watching("on_room_typing")
    if !watching { mod.state.typing_names = [] }
    let typing = mod.state.typing_names.len() > 0
    let screen = mod.state.screen
    ui.typing_row.set_visible(watching && (screen == "list" || (typing && (screen == "empty" || screen == "error"))))
    ui.typing_on.set_visible(typing)
    ui.typing_off.set_visible(!typing)
    if typing { ui.typing_text.set_text(typing_text()) }
}

fn show(){
    let screen = mod.state.screen
    let is_narrow = mod.state.is_narrow
    ui.loading_wrap.set_visible(screen == "loading")
    ui.header_row.set_visible(screen == "list")
    ui.refresh_wide.set_visible(!is_narrow)
    ui.refresh_narrow.set_visible(is_narrow && screen == "list")
    ui.empty_card.set_visible(screen != "loading" && screen != "list")
    ui.ask_wrap.set_visible(screen == "denied")
    ui.retry_wrap.set_visible(screen == "error" || screen == "empty")
    let summary = "" + mod.state.rows.len() + " people"
    if mod.state.rows.len() == 1 { summary = "1 person" }
    ui.summary.set_text(summary)
    let hint = "Tap a name or what they read"
    if is_narrow { hint = "Tap a name or message" }
    ui.meta.set_text(hint)
    ui.live_wrap.set_visible(mod.state.live_note != "")
    ui.live.set_text(mod.state.live_note)
    ui.nav_wrap.set_visible(nav_error != "")
    ui.nav_err.set_text(nav_error)
    if screen == "empty" {
        ui.empty_icon.set_text("👀")
        ui.empty_title.set_text("No read receipts to show")
        ui.empty_body.set_text("They appear as people read this room. Robrix hides them while read receipts are off in Settings.")
        ui.retry.set_text("Refresh")
    }
    if screen == "denied" {
        ui.empty_icon.set_text("🔒")
        ui.empty_title.set_text("Can't see who's here")
        ui.empty_body.set_text("Allow Who's Here to read this room's read receipts.")
    }
    if screen == "error" {
        ui.empty_icon.set_text("😕")
        ui.empty_title.set_text("Couldn't load read receipts")
        ui.empty_body.set_text(sentence(mod.state.error_text))
        ui.retry.set_text("Try again")
    }
    if screen == "no_room" {
        ui.empty_icon.set_text("🧭")
        ui.empty_title.set_text("No room attached")
        ui.empty_body.set_text("Open Who's Here from a room to see who's reading it.")
    }
    show_typing()
    refresh()
}

// Two list cells per person: their name, then the message they last read.
fn refresh(){
    mod.state.cells = []
    if mod.state.screen != "list" {
        ui.receipt_list.render()
        return nil
    }
    let k = 0
    for row in mod.state.rows {
        let b = body_of(row.event_id)
        let text = "Tap to see the message"
        if k < 10 { text = "Loading message…" }
        let dim = true
        let author = ""
        if b != nil {
            text = "Message unavailable"
            if b.loaded {
                text = b.body
                author = b.author
                dim = false
            }
        }
        mod.state.cells.push({who: true, name: row.name, when: ago(row.ts), user_id: row.user_id, dim: false, author: ""})
        mod.state.cells.push({who: false, text: text, dim: dim, author: author, event_id: row.event_id})
        k += 1
    }
    ui.receipt_list.render()
}

// Pace the top rows' message lookups so cached replies cannot exhaust the budget.
fn fetch_next(){
    if pending != "" || fetch_scheduled { return nil }
    let rows = mod.state.rows
    let n = min(rows.len(), 10)
    let i = 0
    while i < n {
        let id = rows[i].event_id
        i += 1
        if body_of(id).is_nil() {
            pending = id
            host.request("matrix.event", {event_id: id}, fn(r){
                let text = ""
                let author = ""
                if r.is_ok {
                    text = r.data.body
                    // Older hosts send only the short sender, and test fixtures may send neither.
                    let name = r.data["sender_name"]
                    if name == nil { name = r.data["sender"] }
                    if name != nil { author = name }
                }
                mod.state.bodies.push({event_id: id, body: text, author: author, loaded: r.is_ok})
                while mod.state.bodies.len() > 100 { mod.state.bodies.remove(0) }
                pending = ""
                refresh()
                fetch_scheduled = start_timeout(1.0, || {
                    fetch_scheduled = false
                    fetch_next()
                }) != nil
            })
            return nil
        }
    }
}

fn fail(error){
    mod.state.rows = []
    mod.state.error_text = error
    mod.state.screen = "error"
    if error.search("not attached to a room") >= 0 { mod.state.screen = "no_room" }
    if error.search("ermission") >= 0 || error.search("not approved") >= 0 { mod.state.screen = "denied" }
    show()
}

fn load(){
    if receipts_loading { return nil }
    receipts_loading = true
    host.request("matrix.read_receipts", nil, fn(r){
        receipts_loading = false
        receipts_loaded = r.is_ok
        if !r.is_ok { fail(r.error) return nil }
        mod.state.rows = r.data.receipts
        nav_error = ""
        mod.state.screen = "list"
        if mod.state.rows.len() == 0 { mod.state.screen = "empty" }
        fetch_next()
        show()
        return nil
    })
}

fn on_room_typing(json){
    let ev = json.parse_json()
    let names = []
    for t in ev.typing {
        let name = t.name
        if name.is_nil() { name = t.user_id }
        names.push(name)
    }
    mod.state.typing_names = names
    show_typing()
}

// The newest read position moves to the top, as in the initial newest-first list.
fn on_room_receipt(json){
    let ev = json.parse_json()
    for rc in ev.receipts {
        let name = nil
        let kept = []
        for row in mod.state.rows {
            if row.user_id == rc.user_id { name = row.name } else { kept.push(row) }
        }
        if name == nil { name = rc.user_id.split(":")[0].strip_prefix("@") }
        let next = [{user_id: rc.user_id, name: name, event_id: rc.event_id, ts: rc.ts}]
        for row in kept { next.push(row) }
        mod.state.rows = next
    }
    if mod.state.screen == "empty" && mod.state.rows.len() > 0 { mod.state.screen = "list" }
    fetch_next()
    show()
}

fn subscribe(name){
    for event in mod.state.subscribed_events { if event == name { return nil } }
    for event in pending_events { if event == name { return nil } }
    pending_events.push(name)
    host.request("events.subscribe", {event: name}, fn(r){
        pending_events.retain(|event| event != name)
        if r.is_ok {
            mod.state.subscribed_events.push(name)
            if mod.state.subscribed_events.len() == 2 { mod.state.live_note = "" }
        } else { mod.state.live_note = "Live updates are off. Tap Refresh to update." }
        show()
    })
}

fn watch(){
    show_typing()
    subscribe("on_room_typing")
    subscribe("on_room_receipt")
}

fn watch_granted(){
    mod.state.subscribed_events.retain(|event| host.has(event))
    if host.has("on_room_typing") { subscribe("on_room_typing") }
    if host.has("on_room_receipt") { subscribe("on_room_receipt") }
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.receipts.read") { receipts_loaded = false }
    elif !receipts_loaded { load() }
    if host.has("matrix.room.event.read") {
        mod.state.bodies.retain(|body| body.loaded)
        fetch_next()
    }
    watch_granted()
    show_typing()
}

fn reload(){
    mod.state.bodies.retain(|body| body.loaded)
    if host.has("matrix.room.receipts.read") { load() }
    else {
        mod.state.rows = []
        mod.state.screen = "denied"
        show()
    }
    watch_granted()
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-read", "matrix-room-watch"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { fail(r.error) return nil }
        mod.state.bodies.retain(|body| body.loaded)
        if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.receipts.read") { load() }
        else {
            mod.state.rows = []
            mod.state.screen = "denied"
            show()
        }
        if r.data.permissions["matrix-room-watch"] == true { watch_granted() }
        return nil
    })
}

fn tap_cell(i){
    if i >= mod.state.cells.len() { return nil }
    let c = mod.state.cells[i]
    if c.who {
        nav_failed = "Couldn't open that profile. "
        host.request("nav.user", {user_id: c.user_id}, on_nav)
        return nil
    }
    nav_failed = "Couldn't jump to that message. "
    host.request("nav.event", {event_id: c.event_id}, on_nav)
}

fn on_nav(r){
    if r.is_ok { nav_error = "" } else { nav_error = nav_failed + sentence(r.error) }
    show()
    return nil
}

fn on_app_resize(w, h){
    let narrow = w < 300
    let tiny = w < 260
    if narrow == mod.state.is_narrow && tiny == mod.state.is_tiny { return nil }
    mod.state.is_narrow = narrow
    mod.state.is_tiny = tiny
    show()
    return nil
}

let _boot = start_timeout(0.05, || setup(false))
// Keeps "5m ago" current; redraws only, no requests.
let _clock = start_interval(60.0, || refresh())

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}

View{
    width: Fill height: Fill flow: Down
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 14
        header_row := View{
            width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} visible: false
            View{
                width: Fill height: Fit flow: Down spacing: 3
                summary := Label{
                    text: "" width: Fill padding: 0 margin: 0
                    draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 13} }
                }
                meta := Label{
                    text: "" width: Fill padding: 0 margin: 0
                    draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                }
                live_wrap := View{
                    width: Fill height: Fit visible: false
                    live := Label{
                        text: "" width: Fill padding: 0 margin: 0
                        draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                    }
                }
                nav_wrap := View{
                    width: Fill height: Fit visible: false
                    nav_err := Label{
                        text: "" width: Fill padding: 0 margin: 0
                        draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} }
                    }
                }
            }
            refresh_wide := View{
                width: Fit height: Fit
                NeutralButton{ text: "Refresh" on_click: || setup(true) }
            }
        }
        refresh_narrow := View{
            width: Fill height: Fit visible: false
            NeutralButton{ text: "Refresh" on_click: || setup(true) }
        }
        typing_row := RoundedView{
            width: Fill height: Fit flow: Right padding: Inset{top: 9 bottom: 9 left: 12 right: 12} visible: false
            show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
            typing_on := View{
                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} visible: false
                Label{ text: "✍️" padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 12} } }
                typing_text := Label{
                    text: "" width: Fill padding: 0 margin: 0
                    draw_text +: { color: theme.palette.title text_style: theme.font_regular{font_size: 11} }
                }
            }
            typing_off := View{
                width: Fill height: Fit
                Label{
                    text: "Nobody is typing right now" width: Fill padding: 0 margin: 0
                    draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} }
                }
            }
        }
        loading_wrap := View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 10 wrap_spacing: 8 align: Align{x: 0.5 y: 0.5} padding: Inset{top: 24 bottom: 24}
            LoadingSpinner{ width: 18 height: 18 draw_bg +: { color: theme.palette.accent_text } }
            Label{
                text: "Checking who's here…" padding: 0 margin: 0
                draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} }
            }
        }
        empty_card := RoundedView{
            width: Fill height: Fit flow: Down spacing: 6 align: Align{x: 0.5} padding: Inset{top: 20 bottom: 20 left: 16 right: 16} visible: false
            show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
            empty_icon := Label{ text: "👀" padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 28} } }
            empty_title := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 12.5} }
            }
            empty_body := Label{
                text: "" width: Fill align: Align{x: 0.5} padding: 0 margin: 0
                draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} }
            }
            ask_wrap := View{
                width: Fit height: Fit margin: Inset{top: 6} visible: false
                PrimaryButton{ text: "Ask again" on_click: || setup(true) }
            }
            retry_wrap := View{
                width: Fit height: Fit margin: Inset{top: 6} visible: false
                retry := NeutralButton{ text: "Try again" on_click: || setup(true) }
            }
        }
        receipt_list := ScrollYView{
            width: Fill height: Fill{min: 80} flow: Down
            on_item_tap: |i| tap_cell(i)
            on_render: || {
                let indent = 42
                if mod.state.is_tiny { indent = 0 }
                for c in mod.state.cells {
                    let tone = theme.palette.body
                    if !c.who && c.dim { tone = theme.palette.muted }
                    let has_author = c.author != ""
                    if c.who {
                        View{
                            width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5} padding: Inset{top: 10 bottom: 6}
                            RoundedView{
                                visible: !mod.state.is_tiny width: 32 height: 32 align: Align{x: 0.5 y: 0.5}
                                show_bg: true draw_bg +: { color: theme.palette.avatar border_radius: 16.0 }
                                Label{ text: initial(c.name) padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 12} } }
                            }
                            Label{
                                text: c.name width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis padding: 0 margin: 0
                                draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 11} }
                            }
                            Label{
                                text: c.when padding: 0 margin: 0
                                draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} }
                            }
                        }
                    } else {
                        View{
                            width: Fill height: Fit flow: Down padding: Inset{left: indent bottom: 10}
                            RoundedView{
                                width: Fill height: Fit flow: Down spacing: 2 padding: Inset{top: 7 bottom: 7 left: 10 right: 10}
                                show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 6.0 }
                                View{
                                    visible: has_author width: Fill height: Fit
                                    Label{
                                        text: c.author width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis padding: 0 margin: 0
                                        draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 10} }
                                    }
                                }
                                Label{
                                    text: c.text width: Fill max_lines: 2 text_overflow: TextOverflow.Ellipsis padding: 0 margin: 0
                                    draw_text +: { color: tone text_style: theme.font_regular{font_size: 10.5} }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
