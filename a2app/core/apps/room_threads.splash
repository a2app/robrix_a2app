// name: Room Threads
// icon: 🧵
// tint: #8A5CA8
// description: The threads in this room, readable in place.
// permissions: matrix-room-read, robrix-navigation, matrix-room-watch, matrix.room.threads.read, matrix.room.thread.read, host.nav.thread, on_room_message
// why-matrix-room-read: Lists the discussion threads in this room and shows the one you open.
// why-robrix-navigation: Opens the thread you're reading in Robrix.
// why-matrix-room-watch: Refreshes as new messages arrive.

let watch_pending = false
let watch_ready = false

let threads_loading = false
let threads_loaded = false
let thread_loading = ""
let thread_request = 0
let thread_loaded = false
let live_refresh_pending = false
let setup_pending = false

let items = []
let open_id = ""
let replies = []
let status = "Loading…"
let live_note = ""
let empty_msg = "Loading threads…"
let reply_empty = ""

fn show_header(){ ui.header.set_text(status + live_note) }

fn load(){
    if threads_loading { return nil }
    threads_loading = true
    host.request("matrix.room_threads", {limit: 20}, fn(r){
        threads_loading = false
        threads_loaded = r.is_ok
        if r.is_ok {
            items = r.data.threads
            empty_msg = "No threads in this room yet."
            let word = " threads"
            if items.len() == 1 { word = " thread" }
            status = "Latest " + items.len() + word + " · tap one to read it"
            if items.len() == 0 { status = "No threads yet" }
        } else {
            items = []
            empty_msg = r.error
            status = r.error
        }
        show_header()
        ui.item_list.render()
    })
}

fn load_thread(){
    if open_id == "" || thread_loading == open_id { return nil }
    let requested_id = open_id
    thread_loading = requested_id
    thread_request += 1
    let request_id = thread_request
    host.request("matrix.thread_replies", {event_id: requested_id, limit: 50}, fn(r){
        if request_id != thread_request { return nil }
        thread_loading = ""
        if open_id != requested_id { return nil }
        thread_loaded = r.is_ok
        replies = []
        if r.is_ok {
            if r.data.root != nil { replies.push(r.data.root) }
            for m in r.data.replies { replies.push(m) }
            reply_empty = "No replies to show."
            let word = " replies"
            if r.data.replies.len() == 1 { word = " reply" }
            ui.thread_header.set_text("" + r.data.replies.len() + word + live_note)
        } else {
            reply_empty = ""
            ui.thread_header.set_text(r.error)
        }
        ui.reply_list.render()
    })
}

fn ago(ts){
    let s = time_now() - ts / 1000.0
    if s < 60.0 { return "just now" }
    if s < 3600.0 { return "" + floor(s / 60.0) + "m ago" }
    if s < 86400.0 { return "" + floor(s / 3600.0) + "h ago" }
    return "" + floor(s / 86400.0) + "d ago"
}

fn reply_line(m){
    let line = m.sender + " · " + ago(m.ts)
    if m.event_id == open_id { line = "🧵 " + line }
    return line
}

fn open_thread(i){
    if i >= items.len() { return nil }
    open_id = items[i].event_id
    thread_loaded = false
    replies = []
    reply_empty = ""
    ui.thread_header.set_text("Loading…")
    ui.reply_list.render()
    ui.list_wrap.set_visible(false)
    ui.thread_wrap.set_visible(true)
    load_thread()
}

fn show_list(){
    open_id = ""
    thread_loading = ""
    thread_request += 1
    ui.thread_wrap.set_visible(false)
    ui.list_wrap.set_visible(true)
    load()
}

fn open_in_robrix(){
    host.request("nav.thread", {event_id: open_id}, fn(r){
        if !r.is_ok { ui.thread_header.set_text(r.error) }
    })
}

fn on_room_message(json){
    schedule_live_refresh()
}

fn schedule_live_refresh(){
    if live_refresh_pending { return nil }
    if open_id == "" && !host.has("matrix.room.threads.read") { return nil }
    if open_id != "" && !host.has("matrix.room.thread.read") { return nil }
    live_refresh_pending = start_timeout(1.0, || {
        live_refresh_pending = false
        if open_id == "" && !host.has("matrix.room.threads.read") { return nil }
        if open_id != "" && !host.has("matrix.room.thread.read") { return nil }
        if threads_loading || thread_loading != "" {
            schedule_live_refresh()
        } elif open_id != "" {
            load_thread()
        } else { load() }
    }) != nil
}

fn watch(){
    if watch_pending || watch_ready { return nil }
    watch_pending = true
    host.request("events.subscribe", {event: "on_room_message"}, fn(r){
        watch_pending = false
        watch_ready = r.is_ok
        if r.is_ok { live_note = "" } else { live_note = " · live updates off: " + r.error }
        show_header()
    })
}

fn on_permissions_changed(caps){
    if setup_pending { return nil }
    if !host.has("matrix.room.threads.read") { threads_loaded = false }
    if !host.has("matrix.room.thread.read") { thread_loaded = false }
    if open_id != "" && host.has("matrix.room.thread.read") {
        if !thread_loaded { load_thread() }
    } elif open_id == "" && host.has("matrix.room.threads.read") {
        if !threads_loaded { load() }
    }
    if host.has("on_room_message") { watch() } else { watch_ready = false }
}

fn setup(retry){
    if setup_pending { return nil }
    setup_pending = true
    host.request("permissions.request", {perms: ["matrix-room-read", "matrix-room-watch"], retry: retry}, fn(r){
        setup_pending = false
        if !r.is_ok { status = r.error empty_msg = r.error show_header() ui.item_list.render() return nil }
        if open_id != "" {
            if r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.thread.read") { load_thread() }
            else { ui.thread_header.set_text("Permission denied. Click Refresh to ask again.") }
        } elif r.data.permissions["matrix-room-read"] == true && host.has("matrix.room.threads.read") { load() }
        else {
            items = []
            status = "Permission denied. Click Refresh to ask again."
            empty_msg = status
            show_header()
            ui.item_list.render()
        }
        if r.data.permissions["matrix-room-watch"] == true && host.has("on_room_message") { watch() }
    })
}

let _boot = start_timeout(0.05, || setup(false))

View{
    width: Fill height: Fill flow: Down align: Align{x: 0.5}
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 10 padding: 14
        list_wrap := ScrollYView{
            width: Fill height: Fill{min: 120} flow: Down spacing: 10
            header := Label{
                text: "Loading…" padding: 0 margin: 0
                width: Fill
                draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
            }
            item_list := ScrollYView{
                width: Fill height: Fill{min: 80} flow: Down spacing: 5
                on_item_tap: |i| open_thread(i)
                on_render: || {
                    if items.len() == 0 {
                        Label{
                            text: empty_msg
                            width: Fill padding: 0 margin: 0
                            draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                        }
                    } else {
                        for it in items {
                            RoundedView{
                                width: Fill height: Fit flow: Down spacing: 2 padding: 10
                                show_bg: true
                                draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                                Label{
                                    text: it.sender padding: 0 margin: 0
                                    width: Fill
                                    draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                                }
                                Label{
                                    text: it.body width: Fill padding: 0 margin: 0
                                    draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                                }
                            }
                        }
                    }
                }
            }
            View{
                width: Fill height: Fit flow: Right align: Align{x: 0.5}
                Button{
                    text: "Refresh" on_click: || setup(true)
                    draw_text +: { color: #x1C274C }
                }
            }
        }
        thread_wrap := ScrollYView{
            width: Fill height: Fill{min: 120} flow: Down spacing: 10 visible: false
            View{
                width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                Button{
                    text: "‹ Back to threads" on_click: || show_list()
                    draw_text +: { color: #x1C274C }
                }
                Button{
                    text: "Open in Robrix" on_click: || open_in_robrix()
                    draw_text +: { color: #x1C274C }
                }
                Button{ text: "Refresh" on_click: || setup(true) draw_text +: { color: #x1C274C } }
            }
            thread_header := Label{
                text: "Loading…" padding: 0 margin: 0
                width: Fill
                draw_text +: { color: #x0f88fe text_style: theme.font_regular{font_size: 12} }
            }
            reply_list := ScrollYView{
                width: Fill height: Fill{min: 80} flow: Down spacing: 5
                on_render: || {
                    if replies.len() == 0 {
                        Label{
                            text: reply_empty
                            width: Fill padding: 0 margin: 0
                            draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                        }
                    } else {
                        for m in replies {
                            RoundedView{
                                width: Fill height: Fit flow: Down spacing: 2 padding: 10
                                show_bg: true
                                draw_bg +: { color: #xF0F5FF border_radius: 8.0 }
                                Label{
                                    text: reply_line(m) padding: 0 margin: 0
                                    width: Fill
                                    draw_text +: { color: #x66708F text_style: theme.font_bold{font_size: 10} }
                                }
                                Label{
                                    text: m.body width: Fill padding: 0 margin: 0
                                    draw_text +: { color: #x333333 text_style: theme.font_regular{font_size: 12} }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
