// name: Search
// icon: 🔍
// tint: #0F88FE
// description: Finds messages in this room or across all of them.
// permissions: matrix-room-read, matrix-rooms-list, matrix-rooms-read, robrix-navigation, matrix.room.messages.search, matrix.rooms.list, matrix.rooms.messages.search, host.nav.event
// why-matrix-room-read: Searches the messages in this room.
// why-matrix-rooms-list: Lists your rooms so you can pick which to search.
// why-matrix-rooms-read: Searches messages across the rooms you pick.
// why-robrix-navigation: Jumps to a result you tap.

let PrimaryButton = Button{
    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
    draw_bg +: {
        border_size: 0.0 border_radius: 4.0
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent text_style: theme.font_regular{font_size: 10} }
}
let NeutralButton = PrimaryButton{
    draw_bg +: { border_size: 1.0 border_color: theme.palette.neutral_border border_color_hover: theme.palette.neutral_border border_color_down: theme.palette.neutral_border border_color_focus: theme.palette.neutral_border
        color: theme.palette.neutral color_hover: theme.palette.neutral_hover color_down: theme.palette.neutral_down color_focus: theme.palette.neutral }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title }
}
let Field = TextInput{
    width: Fill height: Fit padding: 10
    draw_bg +: {
        border_radius: 4.0 border_size: 1.0
        color: theme.palette.surface color_hover: theme.palette.surface color_focus: theme.palette.surface color_down: theme.palette.surface color_empty: theme.palette.surface
        border_color: theme.palette.border border_color_hover: theme.palette.accent border_color_focus: theme.palette.focus border_color_down: theme.palette.focus border_color_empty: theme.palette.border
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.body color_hover: theme.palette.body color_focus: theme.palette.body color_down: theme.palette.body color_empty: theme.palette.placeholder color_empty_hover: theme.palette.placeholder_hover color_empty_focus: theme.palette.placeholder_hover text_style: theme.font_regular{font_size: 11} }
}
// Chips: both variants are declared and the matching one is shown.
let ChipOff = Button{
    padding: Inset{left: 10 right: 10 top: 5 bottom: 5}
    draw_bg +: {
        border_size: 1.0 border_radius: 12.0
        color: theme.palette.surface color_hover: theme.palette.card color_down: theme.palette.pressed color_focus: theme.palette.surface
        border_color: theme.palette.border border_color_hover: theme.palette.accent border_color_down: theme.palette.accent border_color_focus: theme.palette.border
        color_2: vec4(-1.0, -1.0, -1.0, -1.0) border_color_2: vec4(-1.0, -1.0, -1.0, -1.0)
    }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_down: theme.palette.title color_focus: theme.palette.title text_style: theme.font_regular{font_size: 10} }
}
let ChipOn = ChipOff{
    draw_bg +: {
        color: theme.palette.accent color_hover: theme.palette.accent_hover color_down: theme.palette.accent_down color_focus: theme.palette.accent
        border_color: theme.palette.accent border_color_hover: theme.palette.accent_hover border_color_down: theme.palette.accent_down border_color_focus: theme.palette.accent
    }
    draw_text +: { color: theme.palette.on_accent color_hover: theme.palette.on_accent color_down: theme.palette.on_accent color_focus: theme.palette.on_accent }
}
// Robrix's own settings switch: blue track and white knob when on.
let Switch = ToggleFlat{
    draw_bg +: {
        size: 18.0
        color: theme.palette.neutral color_hover: theme.palette.border color_active: theme.palette.accent color_focus: theme.palette.neutral color_down: theme.palette.accent_hover color_disabled: theme.palette.neutral
        border_color: theme.palette.border border_color_hover: theme.palette.border border_color_active: theme.palette.accent_hover border_color_focus: theme.palette.border border_color_down: theme.palette.accent_hover
        mark_color: theme.palette.body mark_color_hover: theme.palette.body mark_color_active: theme.palette.on_accent mark_color_disabled: if theme.palette.is_dark {#x6E6E6E} else {#xB3B3B3}
    }
    draw_text +: { color: theme.palette.title color_hover: theme.palette.title color_active: theme.palette.title color_focus: theme.palette.title color_down: theme.palette.title text_style: theme.font_regular{font_size: 10} }
}

let rooms_loading = false
let rooms_loaded = false

let attached = false
let rooms_line = "Loading rooms…"
let rooms_failed = false
let search_request = 0
// What survives the re-run a theme switch does: your choices, the rooms, the results and the pane's size class.
mod.state = {
    mode: "room" server: false picked: [] rooms: [] room_rows: [] results: [] rows: [] searched: false
    is_searching: false search_error: "" is_tiny: false is_narrow: false
}

let upper = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M" n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}

// "room not joined" -> "Room not joined."
fn sentence(text){
    let t = "" + text
    let chars = t.split("")
    if chars.len() < 3 { return t }
    let first = chars[1]
    let up = upper[first]
    if up == nil { up = first }
    let out = up + t.strip_prefix(first)
    let last = chars[chars.len() - 2]
    if last != "." && last != "!" && last != "?" { out = out + "." }
    return out
}

// The avatar letter: the name's first character, skipping a leading "@" or "#".
fn initial(name){
    let chars = ("" + name).split("")
    if chars.len() < 3 { return "?" }
    let c = chars[1]
    if (c == "@" || c == "#") && chars.len() > 3 { c = chars[2] }
    let up = upper[c]
    if up != nil { c = up }
    return c
}

fn plural(n, word){
    if "" + n == "1" { return word }
    return word + "s"
}

fn ago(ts){
    if !ts.is_number() || ts <= 0 { return "" }
    let s = time_now() - ts / 1000.0
    if s < 60.0 { return "Just now" }
    if s < 3600.0 { return "" + floor(s / 60.0) + "m ago" }
    if s < 86400.0 { return "" + floor(s / 3600.0) + "h ago" }
    if s < 172800.0 { return "Yesterday" }
    if s < 604800.0 { return "" + floor(s / 86400.0) + "d ago" }
    if s < 2592000.0 { return "" + floor(s / 604800.0) + "w ago" }
    if s < 31536000.0 { return "" + floor(s / 2592000.0) + "mo ago" }
    return "" + floor(s / 31536000.0) + "y ago"
}

// One status line: note (gray) or err (red); "" hides it. `status` always holds the text.
fn say(kind, text){
    ui.status.set_text(text)
    ui.status_err.set_text(text)
    ui.note_wrap.set_visible(kind == "note")
    ui.err_wrap.set_visible(kind == "err")
    return nil
}

fn sync_mode(){
    ui.room_chip.set_visible(attached)
    ui.room_on.set_visible(mod.state.mode == "room")
    ui.room_off.set_visible(mod.state.mode != "room")
    ui.all_on.set_visible(mod.state.mode == "all")
    ui.all_off.set_visible(mod.state.mode != "all")
    ui.pick_on.set_visible(mod.state.mode == "pick")
    ui.pick_off.set_visible(mod.state.mode != "pick")
    ui.room_list_wrap.set_visible(mod.state.mode == "pick")
    if mod.state.mode == "pick" && !rooms_loaded { load_rooms() }
    show_rooms()
    show_results()
}

fn set_mode(m){
    mod.state.mode = m
    sync_mode()
}

fn load_rooms(){
    if rooms_loading { return nil }
    rooms_loading = true
    rooms_failed = false
    rooms_line = "Loading rooms…"
    show_rooms()
    host.request("matrix.rooms_list", nil, fn(r){
        rooms_loading = false
        rooms_loaded = r.is_ok
        mod.state.rooms = []
        if r.is_ok {
            for it in r.data.rooms {
                if it["is_space"] != true { mod.state.rooms.push(it) }
            }
            if mod.state.rooms.len() == 0 { rooms_line = "No rooms to pick from." }
        } elif is_denial(r.error) {
            rooms_failed = true
            rooms_line = "Listing your rooms isn't allowed. Tap Pick rooms to ask again."
        } else {
            rooms_failed = true
            rooms_line = "Couldn't list your rooms: " + sentence(r.error) + " Tap Pick rooms to try again."
        }
        show_rooms()
    })
}

fn is_picked(id){
    for p in mod.state.picked {
        if p == id { return true }
    }
    return false
}

fn show_rooms(){
    let rooms = mod.state.rooms
    mod.state.room_rows = []
    for it in rooms {
        let lock = ""
        if it["is_encrypted"] == true { lock = "🔒" }
        mod.state.room_rows.push({name: "" + it.name initial: initial(it.name) lock: lock is_on: is_picked(it.room_id)})
    }
    let count = "Tap rooms to include them"
    // Narrow panes keep the caption's row for the caption alone.
    if rooms.len() == 0 || mod.state.is_narrow { count = "" }
    if mod.state.picked.len() > 0 { count = "" + mod.state.picked.len() + " selected" }
    ui.picked_count.set_text(count)
    ui.rooms_note.set_text(rooms_line)
    ui.rooms_err.set_text(rooms_line)
    ui.rooms_wait_wrap.set_visible(mod.state.mode == "pick" && rooms.len() == 0 && rooms_loading)
    ui.rooms_note_wrap.set_visible(mod.state.mode == "pick" && rooms.len() == 0 && !rooms_failed && !rooms_loading)
    ui.rooms_err_wrap.set_visible(mod.state.mode == "pick" && rooms.len() == 0 && rooms_failed)
    // A render with no rows keeps the old ones, so hide the list instead.
    ui.room_rows_wrap.set_visible(rooms.len() > 0)
    ui.room_list.render()
    return nil
}

fn toggle_pick(i){
    if i >= mod.state.rooms.len() { return nil }
    let id = mod.state.rooms[i].room_id
    if is_picked(id) {
        mod.state.picked.retain(|p| p != id)
    } else {
        mod.state.picked.push(id)
    }
    show_rooms()
}

fn is_denial(err){
    let e = "" + err
    return e.search("not approved") >= 0 || e.search("ermission denied") >= 0
}

fn show_results(){
    let has_rows = mod.state.rows.len() > 0
    ui.results_wrap.set_visible(has_rows)
    ui.searching_wrap.set_visible(!has_rows && mod.state.is_searching)
    ui.empty_wrap.set_visible(!has_rows && !mod.state.is_searching)
    if has_rows { return nil }
    let icon = "🔍"
    let title = "Search messages"
    let body = "Find messages in this room or across your rooms. Tap a result to jump to it."
    let action = ""
    if !attached { body = "Find messages across your rooms. Tap a result to jump to it." }
    if mod.state.search_error != "" && is_denial(mod.state.search_error) {
        icon = "🔒"
        title = "Can't search messages"
        body = "Allow Search to read messages so it can find them."
        action = "Ask again"
    } elif mod.state.search_error != "" {
        icon = "😕"
        title = "Couldn't search"
        body = sentence(mod.state.search_error)
        action = "Try again"
        if mod.state.search_error.search("blocked") >= 0 { action = "" }
    } elif mod.state.searched {
        icon = "🔍"
        title = "No matches"
        body = "Try other words."
        if mod.state.mode == "room" && attached { body = "Try other words, or search All rooms." }
        elif !mod.state.server { body = "Try other words, or ask the server too." }
    }
    ui.empty_icon.set_text(icon)
    ui.empty_title.set_text(title)
    ui.empty_body.set_text(body)
    ui.empty_btn.set_text(action)
    ui.empty_btn_wrap.set_visible(action == "Try again")
    ui.ask_btn_wrap.set_visible(action == "Ask again")
    return nil
}

fn build_rows(){
    mod.state.rows = []
    let first_room = ""
    let many_rooms = false
    for it in mod.state.results {
        if first_room == "" { first_room = it.room_id }
        if it.room_id != first_room { many_rooms = true }
    }
    for it in mod.state.results {
        // Robrix sends the room display name; older hosts and fixtures may not.
        let who = "" + it.sender
        let name = it["sender_name"]
        if name.is_string() && name != "" { who = name }
        let room = it["room_name"]
        if (many_rooms || mod.state.mode != "room") && room.is_string() && room != "" { who = who + " · " + room }
        let sender = "" + it.sender
        if name.is_string() && name != "" { sender = name }
        mod.state.rows.push({who: who initial: initial(sender) when: ago(it["ts"]) body: "" + it.body})
    }
    show_results()
    ui.result_list.render()
    return nil
}

fn on_results(r){
    mod.state.is_searching = false
    mod.state.searched = r.is_ok
    mod.state.search_error = ""
    if r.is_ok {
        mod.state.results = r.data.results
        let note = "" + mod.state.results.len() + " " + plural(mod.state.results.len(), "result")
        // Count only rooms represented in the permitted results.
        let result_rooms = []
        for result in mod.state.results {
            let seen = false
            for room in result_rooms { if room == result.room_id { seen = true } }
            if !seen { result_rooms.push(result.room_id) }
        }
        if result_rooms.len() > 0 {
            let room_count = result_rooms.len()
            note = note + " in " + room_count + " " + plural(room_count, "room")
        }
        if r.data["server_used"] == true { note = note + " · server included" }
        if mod.state.results.len() > 0 { say("note", note) } else { say("", note) }
    } else {
        mod.state.results = []
        mod.state.search_error = r.error
        say("", r.error)
    }
    build_rows()
}

fn request_search(service, args){
    search_request += 1
    let request_id = search_request
    mod.state.is_searching = true
    show_results()
    host.request(service, args, fn(r){
        if request_id != search_request { return nil }
        on_results(r)
    })
}

fn run_search(t){
    let query = ("" + t).trim()
    if query == "" {
        say("note", "Type something to search for.")
        return nil
    }
    // The card says it while there are no rows to keep showing.
    if mod.state.rows.len() > 0 { say("note", "Searching…") } else { say("", "Searching…") }
    if mod.state.mode == "room" {
        request_search("matrix.search_room", {query: query, limit: 40, server: mod.state.server})
        return nil
    }
    if mod.state.mode == "pick" {
        if mod.state.picked.len() == 0 {
            say("note", "Pick at least one room first.")
            return nil
        }
        request_search("matrix.search_rooms", {query: query, room_ids: mod.state.picked, limit: 40, server: mod.state.server})
        return nil
    }
    request_search("matrix.search_rooms", {query: query, limit: 40, server: mod.state.server})
}

fn open_result(i){
    if i >= mod.state.results.len() { return nil }
    host.request("nav.event", {event_id: mod.state.results[i].event_id, room_id: mod.state.results[i].room_id}, fn(r){
        if !r.is_ok { say("err", "Couldn't open that message: " + sentence(r.error)) }
        return nil
    })
}

fn on_app_resize(w, h){
    // The server hint sits beside the switch when there's room, else below it.
    ui.server_hint.set_visible(w >= 400)
    ui.server_hint_below.set_visible(w < 400)
    ui.row_search.set_visible(w >= 260)
    ui.tiny_search.set_visible(w < 260)
    if mod.state.is_tiny != (w < 260) || mod.state.is_narrow != (w < 300) {
        mod.state.is_tiny = w < 260
        mod.state.is_narrow = w < 300
        ui.result_list.render()
        show_rooms()
    }
    return nil
}

fn on_permissions_changed(caps){
    if !host.has("matrix.rooms.list") { rooms_loaded = false }
    elif mod.state.mode == "pick" && !rooms_loaded { load_rooms() }
}

let _boot = start_timeout(0.05, || {
    // A theme switch drops the reply a search was waiting for, so search again once the mode is settled.
    let was_searching = mod.state.is_searching
    mod.state.is_searching = false
    host.request("env", nil, fn(r){
        attached = r.is_ok && r.data.room_attached
        if !attached && mod.state.mode == "room" { mod.state.mode = "all" }
        sync_mode()
        if was_searching { run_search(ui.q.text()) }
    })
})

View{
    width: Fill height: Fill flow: Down
    col := ScrollYView{
        width: Fill height: Fill flow: Down spacing: 12 padding: 14
        View{
            width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            q := Field{
                empty_text: "Search messages"
                on_return: |t| run_search(t)
            }
            row_search := View{
                width: Fit height: Fit
                // Matches the field's height.
                PrimaryButton{ text: "Search" height: 36 on_click: || run_search(ui.q.text()) }
            }
        }
        // Very narrow panes give the field the whole row and put Search below it.
        tiny_search := View{
            width: Fill height: Fit visible: false
            PrimaryButton{ text: "Search" on_click: || run_search(ui.q.text()) }
        }
        View{
            width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
            room_chip := View{
                width: Fit height: Fit
                room_on := View{ width: Fit height: Fit ChipOn{ text: "This room" on_click: || set_mode("room") } }
                room_off := View{ width: Fit height: Fit visible: false ChipOff{ text: "This room" on_click: || set_mode("room") } }
            }
            all_on := View{ width: Fit height: Fit visible: false ChipOn{ text: "All rooms" on_click: || set_mode("all") } }
            all_off := View{ width: Fit height: Fit ChipOff{ text: "All rooms" on_click: || set_mode("all") } }
            pick_on := View{ width: Fit height: Fit visible: false ChipOn{ text: "Pick rooms" on_click: || set_mode("pick") } }
            pick_off := View{ width: Fit height: Fit ChipOff{ text: "Pick rooms" on_click: || set_mode("pick") } }
        }
        View{
            width: Fill height: Fit flow: Down spacing: 4
            View{
                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Switch{
                    text: "Ask the server too"
                    on_click: |on| { mod.state.server = on; }
                }
                server_hint := View{
                    width: Fill height: Fit visible: false
                    Label{ text: "Unencrypted rooms only" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                }
            }
            server_hint_below := View{
                width: Fill height: Fit
                Label{ text: "The server can't search encrypted rooms." width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
        }
        room_list_wrap := View{
            width: Fill height: Fit flow: Down spacing: 8 visible: false
            View{
                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                Label{ text: "PICK ROOMS" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_bold{font_size: 9.5} } }
                picked_count := Label{ text: "Tap rooms to include them" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
            rooms_wait_wrap := View{
                width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} visible: false
                LoadingSpinner{ width: 16 height: 16 draw_bg +: { color: theme.palette.accent_text } }
                Label{ text: "Loading rooms…" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
            rooms_note_wrap := View{
                width: Fill height: Fit visible: false
                rooms_note := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
            }
            rooms_err_wrap := View{
                width: Fill height: Fit visible: false
                rooms_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
            }
            // Lists with on_render keep no visibility of their own (render() re-applies it); wrappers hold it.
            room_rows_wrap := View{
                width: Fill height: Fit
                room_list := ScrollYView{
                    width: Fill height: Fit{max: FitBound.Rel{base: Base.Full, factor: 0.3}} flow: Down spacing: 6
                    on_item_tap: |i| toggle_pick(i)
                    on_render: || {
                        for it in mod.state.room_rows {
                            // Colors are picked here, not stored in the row, so a theme switch redraws them.
                            let bg = theme.palette.surface
                            let edge = if theme.palette.is_dark {#x33373F} else {#xE3E8F0}
                            let mark_c = theme.palette.muted
                            if it.is_on {
                                bg = theme.palette.pressed
                                edge = theme.palette.accent
                                mark_c = theme.palette.accent_text
                            }
                            RoundedView{
                                width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                                padding: Inset{left: 10 right: 12 top: 6 bottom: 6}
                                show_bg: true draw_bg +: { color: bg border_size: 1.0 border_color: edge border_radius: 8.0 }
                                RoundedView{
                                    visible: !mod.state.is_tiny width: 32 height: 32 align: Align{x: 0.5 y: 0.5}
                                    show_bg: true draw_bg +: { color: theme.palette.avatar border_radius: 16.0 }
                                    Label{ text: it.initial padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 12} } }
                                }
                                Label{ text: it.name width: Fill padding: 0 margin: 0 max_lines: 1 text_overflow: TextOverflow.Ellipsis draw_text +: { color: theme.palette.title text_style: theme.font_regular{font_size: 11} } }
                                Label{ text: it.lock padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 10} } }
                                Label{ text: if it.is_on {"●"} else {"○"} padding: 0 margin: 0 draw_text +: { color: mark_c text_style: theme.font_regular{font_size: 12} } }
                            }
                        }
                    }
                }
            }
        }
        note_wrap := View{
            width: Fill height: Fit visible: false
            status := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
        }
        err_wrap := View{
            width: Fill height: Fit visible: false
            status_err := Label{ text: "" width: Fill padding: 0 margin: 0 draw_text +: { color: theme.palette.danger text_style: theme.font_regular{font_size: 10} } }
        }
        searching_wrap := View{
            width: Fill height: Fit flow: Right spacing: 10 align: Align{x: 0.5 y: 0.5} padding: Inset{top: 24 bottom: 24} visible: false
            LoadingSpinner{ width: 18 height: 18 draw_bg +: { color: theme.palette.accent_text } }
            Label{ text: "Searching…" padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
        }
        empty_wrap := View{
            width: Fill height: Fit
            RoundedView{
                width: Fill height: Fit flow: Down spacing: 6 align: Align{x: 0.5}
                padding: Inset{left: 16 right: 16 top: 20 bottom: 20}
                show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
                empty_icon := Label{ text: "🔍" padding: 0 margin: 0 draw_text +: { text_style: theme.font_regular{font_size: 28} } }
                empty_title := Label{ text: "Search messages" width: Fill align: Align{x: 0.5} padding: 0 margin: 0 draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 12.5} } }
                empty_body := Label{ text: "Find messages in this room or across your rooms. Tap a result to jump to it." width: Fill align: Align{x: 0.5} padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10.5} } }
                empty_btn_wrap := View{
                    width: Fit height: Fit visible: false margin: Inset{top: 6}
                    empty_btn := NeutralButton{ text: "Try again" on_click: || run_search(ui.q.text()) }
                }
                ask_btn_wrap := View{
                    width: Fit height: Fit visible: false margin: Inset{top: 6}
                    PrimaryButton{ text: "Ask again" on_click: || run_search(ui.q.text()) }
                }
            }
        }
        // Lists with on_render keep no visibility of their own (render() re-applies it); wrappers hold it.
        results_wrap := View{
            width: Fill height: Fill{min: 80.0} visible: false
            result_list := ScrollYView{
                width: Fill height: Fill flow: Down spacing: 8
                on_item_tap: |i| open_result(i)
                on_render: || {
                    for it in mod.state.rows {
                        RoundedView{
                            width: Fill height: Fit flow: Right spacing: 10
                            padding: Inset{left: 12 right: 12 top: 10 bottom: 10}
                            show_bg: true draw_bg +: { color: theme.palette.card_subtle border_radius: 8.0 }
                            RoundedView{
                                visible: !mod.state.is_tiny width: 32 height: 32 align: Align{x: 0.5 y: 0.5}
                                show_bg: true draw_bg +: { color: theme.palette.avatar border_radius: 16.0 }
                                Label{ text: it.initial padding: 0 margin: 0 draw_text +: { color: theme.palette.on_accent text_style: theme.font_bold{font_size: 12} } }
                            }
                            View{
                                width: Fill height: Fit flow: Down spacing: 4
                                View{
                                    width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                    Label{ text: it.who width: Fill padding: 0 margin: 0 max_lines: 1 text_overflow: TextOverflow.Ellipsis draw_text +: { color: theme.palette.title text_style: theme.font_bold{font_size: 11} } }
                                    Label{ text: it.when padding: 0 margin: 0 draw_text +: { color: theme.palette.muted text_style: theme.font_regular{font_size: 10} } }
                                }
                                Label{ text: it.body width: Fill padding: 0 margin: 0 max_lines: 3 text_overflow: TextOverflow.Ellipsis draw_text +: { color: theme.palette.body text_style: theme.font_regular{font_size: 11} } }
                            }
                        }
                    }
                }
            }
        }
    }
}
